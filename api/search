ars/analytics/people#common-questions","content":"Common questions"},"672":{"id":"/product-docs/webinars/analytics/people-28","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-no-show-list","content":"How do I get a list of everyone who didn't turn up?"},"673":{"id":"/product-docs/webinars/analytics/people-29","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-watch-percentage","content":"Can I see how much of the webinar someone watched?"},"674":{"id":"/product-docs/webinars/analytics/people-30","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-campaign","content":"How do I know which campaign a registrant came from?"},"675":{"id":"/product-docs/webinars/analytics/people-31","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-columns","content":"Can I choose which columns I see?"},"676":{"id":"/product-docs/webinars/analytics/people-32","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-export-filters","content":"Does Export include only the filtered people?"},"677":{"id":"/product-docs/webinars/analytics/people-33","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-lead-score","content":"What does lead score mean?"},"678":{"id":"/product-docs/webinars/analytics/people-34","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-all-webinars","content":"Can I see people from all my webinars at once?"},"679":{"id":"/product-docs/webinars/analytics/people-35","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-clicked-not-bought","content":"Can I find people who clicked my offer but didn't buy?"},"680":{"id":"/product-docs/webinars/analytics/people-36","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-phone-empty","content":"Why is the Phone column empty?"},"681":{"id":"/product-docs/webinars/analytics/people-37","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#faq-result-count","content":"How do I see how many people match my filters?"},"682":{"id":"/product-docs/webinars/analytics/people-38","page_id":"/product-docs/webinars/analytics/people","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/people#related","content":"Related"},"683":{"id":"/product-docs/webinars/analytics/people-39","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people","content":"**People** is a single table of everyone who registered for or attended any of your EasyWebinar webinars. Each row shows one person on one webinar, with what they did: their attendance status, how much of the live session and the replay they watched, whether they clicked your offer, and a lead score for how engaged they were. You can filter the table by webinar, dates, behaviour, campaign source, device or location, and export exactly the segment you need."},"684":{"id":"/product-docs/webinars/analytics/people-40","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                      |                           |\n| -------------------- | ------------------------- |\n| **Where to find it** | **People** in the sidebar |","table":"table-0"},"685":{"id":"/product-docs/webinars/analytics/people-41","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                    |                                                        |\n| ------------------ | ------------------------------------------------------ |\n| **What it covers** | Every registrant and attendee across all your webinars |","table":"table-0"},"686":{"id":"/product-docs/webinars/analytics/people-42","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                |                           |\n| -------------- | ------------------------- |\n| **One row is** | One person on one webinar |","table":"table-0"},"687":{"id":"/product-docs/webinars/analytics/people-43","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                 |                                                                                                  |\n| --------------- | ------------------------------------------------------------------------------------------------ |\n| **Key columns** | **Status**, **Lead score**, **Watch percentage**, **Replay watch percentage**, **Offer clicked** |","table":"table-0"},"688":{"id":"/product-docs/webinars/analytics/people-44","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                    |             |\n| ------------------ | ----------- |\n| **Choose columns** | **Columns** |","table":"table-0"},"689":{"id":"/product-docs/webinars/analytics/people-45","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                       |                                                                                         |\n| --------------------- | --------------------------------------------------------------------------------------- |\n| **Filter categories** | **Webinar**, **Dates**, **User**, **Behavior**, **Source & UTM**, **Device & Location** |","table":"table-0"},"690":{"id":"/product-docs/webinars/analytics/people-46","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|            |                                        |\n| ---------- | -------------------------------------- |\n| **Export** | **Export** downloads the filtered list |","table":"table-0"},"691":{"id":"/product-docs/webinars/analytics/people-47","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#at-a-glance","content":"|                   |                                                          |\n| ----------------- | -------------------------------------------------------- |\n| **Campaign data** | Needs **UTM Params** turned on in your registration form |","table":"table-0"},"692":{"id":"/product-docs/webinars/analytics/people-48","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#what-it-is","content":"A webinar's own **Analytics** tab gives you counts: how many registered, how many attended, how many missed. **People** gives you the names behind those counts, for every webinar in your account at once."},"693":{"id":"/product-docs/webinars/analytics/people-49","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#what-it-is","content":"That changes what you can do after a session. Instead of knowing that a large share of registrants missed the webinar, you can see who they are, narrow the list to one webinar, and export it for a replay email. Instead of knowing that some people clicked your offer, you can find the ones who watched most of the session, clicked, and still haven't bought."},"694":{"id":"/product-docs/webinars/analytics/people-50","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#what-its-for","content":"People is the follow-up list. It turns webinar behaviour into segments you can act on: no-shows to send the replay to, engaged viewers to invite to a call, campaigns that brought attendees rather than just sign-ups."},"695":{"id":"/product-docs/webinars/analytics/people-51","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#how-it-helps","content":"**It shows behaviour, not just registration.** **Watch percentage**, **Replay watch percentage** and **Offer clicked** separate interested people from casual sign-ups."},"696":{"id":"/product-docs/webinars/analytics/people-52","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#how-it-helps","content":"**It ranks engagement for you.** **Lead score** rates how engaged each person was, which makes a long list quick to sort."},"697":{"id":"/product-docs/webinars/analytics/people-53","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#how-it-helps","content":"**It attributes campaigns to attendance.** With UTM capture on, **Source & UTM** shows which campaign produced people who actually watched."},"698":{"id":"/product-docs/webinars/analytics/people-54","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#how-it-helps","content":"**It exports segments, not everything.** **Export** downloads the filtered list, so the work the filters did comes with it."},"699":{"id":"/product-docs/webinars/analytics/people-55","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#without-it","content":"Without a behaviour-level list, every registrant gets the same follow-up. The person who watched to the end and clicked your offer receives the same \"sorry we missed you\" email as someone who never turned up, and the people closest to buying are treated like everyone else."},"700":{"id":"/product-docs/webinars/analytics/people-56","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#why-buyers-care","content":"Webinars are usually run to produce leads or sales, so what matters afterwards is who to contact and in what order. Buyers look for per-person engagement data, campaign attribution and a clean export, because that's what connects a webinar to a sales or marketing follow-up."},"701":{"id":"/product-docs/webinars/analytics/people-57","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#open-people","content":"Click **People** in the sidebar. The table lists registrants and attendees across every webinar, and the result count below the table shows how many rows match."},"702":{"id":"/product-docs/webinars/analytics/people-58","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"Each row is one person on one webinar, with columns including:"},"703":{"id":"/product-docs/webinars/analytics/people-59","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column             | What it tells you |\n| ------------------ | ----------------- |\n| **Name** and email | Who they are      |","table":"table-1"},"704":{"id":"/product-docs/webinars/analytics/people-60","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column    | What it tells you                       |\n| --------- | --------------------------------------- |\n| **Phone** | Their phone number, if you collected it |","table":"table-1"},"705":{"id":"/product-docs/webinars/analytics/people-61","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column     | What it tells you                              |\n| ---------- | ---------------------------------------------- |\n| **Status** | Attendance status, such as Attended or No Show |","table":"table-1"},"706":{"id":"/product-docs/webinars/analytics/people-62","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column         | What it tells you                      |\n| -------------- | -------------------------------------- |\n| **Lead score** | How engaged they were, for example Hot |","table":"table-1"},"707":{"id":"/product-docs/webinars/analytics/people-63","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column                   | What it tells you                                             |\n| ------------------------ | ------------------------------------------------------------- |\n| **Webinar** and **Type** | Which webinar, and whether it was live, simulive or evergreen |","table":"table-1"},"708":{"id":"/product-docs/webinars/analytics/people-64","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column                  | What it tells you               |\n| ----------------------- | ------------------------------- |\n| **Session date & time** | The session they registered for |","table":"table-1"},"709":{"id":"/product-docs/webinars/analytics/people-65","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column                | What it tells you |\n| --------------------- | ----------------- |\n| **Attendee timezone** | Where they are    |","table":"table-1"},"710":{"id":"/product-docs/webinars/analytics/people-66","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column            | What it tells you   |\n| ----------------- | ------------------- |\n| **Registered on** | When they signed up |","table":"table-1"},"711":{"id":"/product-docs/webinars/analytics/people-67","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column               | What it tells you                         |\n| -------------------- | ----------------------------------------- |\n| **Watch percentage** | How much of the live session they watched |","table":"table-1"},"712":{"id":"/product-docs/webinars/analytics/people-68","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column                      | What it tells you                   |\n| --------------------------- | ----------------------------------- |\n| **Replay watch percentage** | How much of the replay they watched |","table":"table-1"},"713":{"id":"/product-docs/webinars/analytics/people-69","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column      | What it tells you |\n| ----------- | ----------------- |\n| **Country** | Their country     |","table":"table-1"},"714":{"id":"/product-docs/webinars/analytics/people-70","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column    | What it tells you            |\n| --------- | ---------------------------- |\n| **Polls** | How many polls they answered |","table":"table-1"},"715":{"id":"/product-docs/webinars/analytics/people-71","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"| Column            | What it tells you               |\n| ----------------- | ------------------------------- |\n| **Offer clicked** | Whether they clicked your offer |","table":"table-1"},"716":{"id":"/product-docs/webinars/analytics/people-72","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#read-the-table","content":"Use **Columns** to choose which of these appear. **Watch percentage** and **Offer clicked** are the two most worth sorting by: someone who watched most of the session and clicked your offer is a very different prospect from someone who left in the first few minutes."},"717":{"id":"/product-docs/webinars/analytics/people-73","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"Click **Add Filter**."},"718":{"id":"/product-docs/webinars/analytics/people-74","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"*1 Categories · 2 Refinements · 3 Apply Filter.*"},"719":{"id":"/product-docs/webinars/analytics/people-75","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"Pick a category on the left, refine it on the right, then click **Apply Filter**."},"720":{"id":"/product-docs/webinars/analytics/people-76","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"| Category    | Filter by                             |\n| ----------- | ------------------------------------- |\n| **Webinar** | A specific webinar, or a webinar type |","table":"table-2"},"721":{"id":"/product-docs/webinars/analytics/people-77","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"| Category  | Filter by                          |\n| --------- | ---------------------------------- |\n| **Dates** | When people registered or attended |","table":"table-2"},"722":{"id":"/product-docs/webinars/analytics/people-78","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"| Category | Filter by                |\n| -------- | ------------------------ |\n| **User** | Attributes of the person |","table":"table-2"},"723":{"id":"/product-docs/webinars/analytics/people-79","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"| Category     | Filter by                                              |\n| ------------ | ------------------------------------------------------ |\n| **Behavior** | What they did: attendance, watch time and offer clicks |","table":"table-2"},"724":{"id":"/product-docs/webinars/analytics/people-80","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"| Category         | Filter by                                           |\n| ---------------- | --------------------------------------------------- |\n| **Source & UTM** | The campaign that brought them, if you capture UTMs |","table":"table-2"},"725":{"id":"/product-docs/webinars/analytics/people-81","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"| Category              | Filter by                                         |\n| --------------------- | ------------------------------------------------- |\n| **Device & Location** | What they watched on, and where they watched from |","table":"table-2"},"726":{"id":"/product-docs/webinars/analytics/people-82","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#filter-the-list","content":"**Clear all** resets every filter. The result count below the table shows how far a filter narrowed the list."},"727":{"id":"/product-docs/webinars/analytics/people-83","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#useful-combinations","content":"| You want                                        | Filter                                   |\n| ----------------------------------------------- | ---------------------------------------- |\n| Everyone to send the replay to, for one webinar | **Behavior** → no-show, plus **Webinar** |","table":"table-3"},"728":{"id":"/product-docs/webinars/analytics/people-84","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#useful-combinations","content":"| You want                         | Filter                                           |\n| -------------------------------- | ------------------------------------------------ |\n| Interested people who didn't buy | **Behavior** → high watch time and offer clicked |","table":"table-3"},"729":{"id":"/product-docs/webinars/analytics/people-85","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#useful-combinations","content":"| You want                                                  | Filter           |\n| --------------------------------------------------------- | ---------------- |\n| Which campaign produced attendees, not only registrations | **Source & UTM** |","table":"table-3"},"730":{"id":"/product-docs/webinars/analytics/people-86","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#useful-combinations","content":"| You want                                                   | Filter                  |\n| ---------------------------------------------------------- | ----------------------- |\n| How your automated funnel compares with your live sessions | **Webinar** → Evergreen |","table":"table-3"},"731":{"id":"/product-docs/webinars/analytics/people-87","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#export","content":"Click **Export** to download the filtered list. Use it to take a segment into another tool or to hand a list to someone who doesn't work in EasyWebinar."},"732":{"id":"/product-docs/webinars/analytics/people-88","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#export","content":"Filter first, then export. Exporting everything and cutting it down in a spreadsheet repeats work the filters already do, and **Export** respects whatever filters are applied."},"733":{"id":"/product-docs/webinars/analytics/people-89","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#capture-utms","content":"**Source & UTM** only has something to filter if your registration form records it. To set that up:"},"734":{"id":"/product-docs/webinars/analytics/people-90","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#capture-utms","content":"Open the webinar's **Content** tab and edit the **Registration Page**."},"735":{"id":"/product-docs/webinars/analytics/people-91","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#capture-utms","content":"Select the form block and turn on **UTM Params**, so each registration records the campaign that brought it in."},"736":{"id":"/product-docs/webinars/analytics/people-92","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#capture-utms","content":"Tag the links in your ads, emails and posts as you normally would."},"737":{"id":"/product-docs/webinars/analytics/people-93","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#capture-utms","content":"Filter **People** by **Source & UTM** to see which campaign each registrant came from."},"738":{"id":"/product-docs/webinars/analytics/people-94","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#capture-utms","content":"Because People also holds attendance and watch time, this gives you campaign attribution against real viewing, not just clicks. UTM capture is easy to miss; without it, you'll know how many people registered but not which ad, email or post sent them. See Registration page builder."},"739":{"id":"/product-docs/webinars/analytics/people-95","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#lead-score","content":"**Lead score** is calculated from engagement: attendance, watch time and interaction. It rates how engaged someone was, for example **Hot**, so you can sort a long list and start with the most engaged people. It's a quick way to prioritise. For the detail, read it alongside **Status**, **Watch percentage**, **Polls** and **Offer clicked** on the same row."},"740":{"id":"/product-docs/webinars/analytics/people-96","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#with-analytics","content":"The **Analytics** tab on a single webinar shows the funnel and offer numbers; People shows the individuals across all webinars. Use Analytics to find where a webinar is leaking, then People to find who is in that gap. See Webinar analytics."},"741":{"id":"/product-docs/webinars/analytics/people-97","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#with-follow-ups","content":"If you only need to email no-shows or attendees of one webinar, **Webinar Follow-ups** on the **Notifications** tab can target those audiences directly, and **Attendee Action Follow-ups** send based on engagement and offer clicks. People is for when you want to see the list, combine conditions, or take it elsewhere."},"742":{"id":"/product-docs/webinars/analytics/people-98","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#with-crm","content":"A connected CRM can receive the same behaviour as tags: **Missed**, **Watched full**, **Clicked offer** and more. People complements that by letting you look back across webinars and export a segment on demand. See Connect a CRM and map your webinar data."},"743":{"id":"/product-docs/webinars/analytics/people-99","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#with-registration-fields","content":"The **Phone** column fills only if your form collects it. Add the **Phone** field, or your own fields, on the registration form block. See Custom fields."},"744":{"id":"/product-docs/webinars/analytics/people-100","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#who-uses-it","content":"These are typical patterns, shown to illustrate how different teams use the same table."},"745":{"id":"/product-docs/webinars/analytics/people-101","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#b2b-marketing","content":"A marketing team running paid campaigns turns on **UTM Params** for every webinar, then filters People by **Source & UTM** each month to compare which channels produce attendees with high **Watch percentage**, not just sign-ups."},"746":{"id":"/product-docs/webinars/analytics/people-102","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#course-creators","content":"A creator filters for high watch time plus **Offer clicked** after each evergreen session and exports the list for a personal follow-up, since those viewers were interested enough to click but didn't enrol. See Course creators."},"747":{"id":"/product-docs/webinars/analytics/people-103","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#customer-success","content":"A customer success team runs recurring onboarding webinars and filters **Behavior** for no-shows on the latest session, then sends that group the replay so new customers don't fall behind."},"748":{"id":"/product-docs/webinars/analytics/people-104","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#agencies","content":"An agency running webinars for a client filters by **Webinar**, exports the attendees with their **Lead score** and **Offer clicked** columns, and hands the file to the client's sales team, who don't use EasyWebinar."},"749":{"id":"/product-docs/webinars/analytics/people-105","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#limits","content":"**People spans every webinar,** unlike a webinar's own **Analytics** tab."},"750":{"id":"/product-docs/webinars/analytics/people-106","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#limits","content":"**Each row is one person on one webinar.** Someone who registered for two webinars appears twice."},"751":{"id":"/product-docs/webinars/analytics/people-107","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#limits","content":"**UTM filtering needs UTM capture** turned on in your registration form."},"752":{"id":"/product-docs/webinars/analytics/people-108","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#limits","content":"**Phone appears only if you collected it.**"},"753":{"id":"/product-docs/webinars/analytics/people-109","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#limits","content":"**Export respects your filters.**"},"754":{"id":"/product-docs/webinars/analytics/people-110","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#limits","content":"**Lead score is calculated from engagement.** It's a guide for sorting, not a replacement for the underlying columns."},"755":{"id":"/product-docs/webinars/analytics/people-111","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-no-show-list","content":"Filter by **Behavior** for no-shows, add a **Webinar** filter for a single event, then click **Export**."},"756":{"id":"/product-docs/webinars/analytics/people-112","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-watch-percentage","content":"Yes. **Watch percentage** covers the live session and **Replay watch percentage** covers the recording."},"757":{"id":"/product-docs/webinars/analytics/people-113","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-campaign","content":"Filter by **Source & UTM**. You need **UTM Params** turned on in your registration form first."},"758":{"id":"/product-docs/webinars/analytics/people-114","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-columns","content":"Yes. Use **Columns**."},"759":{"id":"/product-docs/webinars/analytics/people-115","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-export-filters","content":"Yes. Filter first, then export."},"760":{"id":"/product-docs/webinars/analytics/people-116","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-lead-score","content":"A rating of how engaged someone was, based on attendance, watch time and interaction."},"761":{"id":"/product-docs/webinars/analytics/people-117","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-all-webinars","content":"Yes. People covers every webinar. Add a **Webinar** filter to narrow it to one."},"762":{"id":"/product-docs/webinars/analytics/people-118","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-clicked-not-bought","content":"Filter **Behavior** for high watch time and offer clicks. Those are people who were interested and haven't bought yet."},"763":{"id":"/product-docs/webinars/analytics/people-119","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-phone-empty","content":"Phone numbers only appear if your registration form collects them. Add the **Phone** field to the form block."},"764":{"id":"/product-docs/webinars/analytics/people-120","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#faq-result-count","content":"The result count is shown below the table."},"765":{"id":"/product-docs/webinars/analytics/people-121","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#related","content":"Map webinar behaviour to CRM tags: send the same behaviour People shows into your CRM automatically."},"766":{"id":"/product-docs/webinars/analytics/people-122","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#related","content":"Reminder emails: fewer no-shows means a shorter replay list to export."},"767":{"id":"/product-docs/webinars/analytics/people-123","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#related","content":"Write polls people will answer: the **Polls** column only tells you something if people answer them."},"768":{"id":"/product-docs/webinars/analytics/people-124","page_id":"/product-docs/webinars/analytics/people","tags":[],"type":"text","url":"/product-docs/webinars/analytics/people#related","content":"Follow up after a course webinar: how a course creator acts on the people who clicked but didn't enrol."},"769":{"id":"/product-docs/webinars/analytics/webinar-analytics","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"page","content":"Webinar analytics","breadcrumbs":["EasyWebinar documentation","Webinars","Analytics"],"tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics"},"770":{"id":"/product-docs/webinars/analytics/webinar-analytics-0","page_id":"/product-docs/webinars/analytics/webinar-analytics","tags":[],"type":"text","url":"/product-docs/webinars/analytics/webinar-analytics","content":"What the Analytics tab on an EasyWebinar webinar measures, from visitors and registrations to live attendance, replay views, offer performance and revenue, and how to read each number."},"771":{"id":"/product-docs/webinars/analytics/webinar-analytics-1","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics#at-a-glance","content":"At a glance"},"772":{"id":"/product-docs/webinars/analytics/webinar-analytics-2","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics#what-it-is","content":"What webinar analytics is"},"773":{"id":"/product-docs/webinars/analytics/webinar-analytics-3","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics#why-it-matters","content":"Why webinar analytics matters"},"774":{"id":"/product-docs/webinars/analytics/webinar-analytics-4","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics#what-its-for","content":"What it's for"},"775":{"id":"/product-docs/webinars/analytics/webinar-analytics-5","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics#how-it-helps","content":"How it helps"},"776":{"id":"/product-docs/webinars/analytics/webinar-analytics-6","page_id":"/product-docs/webinars/analytics/webinar-analytics","type":"heading","tags":[],"url":"/product-docs/webinars/analytics/webinar-analytics#without-it","content":"What happens without it"},"777":{"id":"/product-docs/webinars/analytics/webinar-analytics-7","page_id":"/product-docs/webinars/analytics/webinar-analytics","typ