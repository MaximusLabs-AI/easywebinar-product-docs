-it","content":"What happens without it"},"3332":{"id":"/product-docs/webinars/notifications/reminder-emails-7","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#why-buyers-care","content":"Why buyers care"},"3333":{"id":"/product-docs/webinars/notifications/reminder-emails-8","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#set-it-up","content":"Set it up"},"3334":{"id":"/product-docs/webinars/notifications/reminder-emails-9","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#find-reminders","content":"Find your reminders"},"3335":{"id":"/product-docs/webinars/notifications/reminder-emails-10","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#edit-reminder","content":"Edit a reminder"},"3336":{"id":"/product-docs/webinars/notifications/reminder-emails-11","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#add-reminder","content":"Add another reminder"},"3337":{"id":"/product-docs/webinars/notifications/reminder-emails-12","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#sensible-schedule","content":"A sensible schedule"},"3338":{"id":"/product-docs/webinars/notifications/reminder-emails-13","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#check-sender","content":"Check who the reminders come from"},"3339":{"id":"/product-docs/webinars/notifications/reminder-emails-14","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"Text and WhatsApp reminders (Beta)"},"3340":{"id":"/product-docs/webinars/notifications/reminder-emails-15","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#works-with","content":"How it works with other features"},"3341":{"id":"/product-docs/webinars/notifications/reminder-emails-16","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#with-confirmation","content":"Registration confirmation"},"3342":{"id":"/product-docs/webinars/notifications/reminder-emails-17","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#with-evergreen","content":"Evergreen and just-in-time sessions"},"3343":{"id":"/product-docs/webinars/notifications/reminder-emails-18","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#with-analytics","content":"Analytics"},"3344":{"id":"/product-docs/webinars/notifications/reminder-emails-19","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#with-follow-ups","content":"Follow-ups for people the reminders didn't reach"},"3345":{"id":"/product-docs/webinars/notifications/reminder-emails-20","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#with-crm","content":"Reminders from your own CRM"},"3346":{"id":"/product-docs/webinars/notifications/reminder-emails-21","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#with-cloning","content":"Cloning"},"3347":{"id":"/product-docs/webinars/notifications/reminder-emails-22","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#who-uses-it","content":"Who uses it, and how"},"3348":{"id":"/product-docs/webinars/notifications/reminder-emails-23","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#product-teams","content":"SaaS and product teams"},"3349":{"id":"/product-docs/webinars/notifications/reminder-emails-24","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#course-creators","content":"Course creators"},"3350":{"id":"/product-docs/webinars/notifications/reminder-emails-25","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#customer-success","content":"Customer success teams"},"3351":{"id":"/product-docs/webinars/notifications/reminder-emails-26","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#b2b-marketing","content":"B2B marketing teams"},"3352":{"id":"/product-docs/webinars/notifications/reminder-emails-27","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"Limits and things to know"},"3353":{"id":"/product-docs/webinars/notifications/reminder-emails-28","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#common-questions","content":"Common questions"},"3354":{"id":"/product-docs/webinars/notifications/reminder-emails-29","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-how-many","content":"How many reminders should I send?"},"3355":{"id":"/product-docs/webinars/notifications/reminder-emails-30","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-add-more","content":"Can I add more than one reminder?"},"3356":{"id":"/product-docs/webinars/notifications/reminder-emails-31","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-timing","content":"How is a reminder's timing set?"},"3357":{"id":"/product-docs/webinars/notifications/reminder-emails-32","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-evergreen","content":"Do reminders work on recurring and evergreen webinars?"},"3358":{"id":"/product-docs/webinars/notifications/reminder-emails-33","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-edit","content":"Can I change what a reminder says?"},"3359":{"id":"/product-docs/webinars/notifications/reminder-emails-34","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-measure","content":"How do I know if my reminders are working?"},"3360":{"id":"/product-docs/webinars/notifications/reminder-emails-35","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-sms-whatsapp","content":"Can I send reminders by text or WhatsApp?"},"3361":{"id":"/product-docs/webinars/notifications/reminder-emails-36","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-test","content":"Should I test a text or WhatsApp reminder first?"},"3362":{"id":"/product-docs/webinars/notifications/reminder-emails-37","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-ai","content":"Does a webinar built with AI include reminders?"},"3363":{"id":"/product-docs/webinars/notifications/reminder-emails-38","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-no-shows","content":"What about people who still didn't turn up?"},"3364":{"id":"/product-docs/webinars/notifications/reminder-emails-39","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#faq-crm","content":"Can I send reminders from my CRM instead?"},"3365":{"id":"/product-docs/webinars/notifications/reminder-emails-40","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Related"},"3366":{"id":"/product-docs/webinars/notifications/reminder-emails-41","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails","content":"**Webinar Reminders** are the emails EasyWebinar sends to registrants before the session starts. Each reminder has its own timing, set as a length of time before the webinar, so the same reminders work for a one-off session, a recurring schedule or an evergreen webinar. You can add as many as you need from the **Notifications** tab, and Analytics shows whether they are working: the gap between people who registered and people who attended is the reminders' job."},"3367":{"id":"/product-docs/webinars/notifications/reminder-emails-42","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                  |                                              |\n| ---------------- | -------------------------------------------- |\n| **What it does** | Emails registrants before the webinar starts |","table":"table-0"},"3368":{"id":"/product-docs/webinars/notifications/reminder-emails-43","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                     |             |\n| ------------------- | ----------- |\n| **Who receives it** | Registrants |","table":"table-0"},"3369":{"id":"/product-docs/webinars/notifications/reminder-emails-44","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                      |                                                                       |\n| -------------------- | --------------------------------------------------------------------- |\n| **How timing works** | Set as time before the webinar, for example *1h 0m 0s before webinar* |","table":"table-0"},"3370":{"id":"/product-docs/webinars/notifications/reminder-emails-45","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|              |                                                                   |\n| ------------ | ----------------------------------------------------------------- |\n| **How many** | As many as you add with **Create New**; three is a common pattern |","table":"table-0"},"3371":{"id":"/product-docs/webinars/notifications/reminder-emails-46","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                       |                                                         |\n| --------------------- | ------------------------------------------------------- |\n| **Suggested pattern** | A day before, an hour before and fifteen minutes before |","table":"table-0"},"3372":{"id":"/product-docs/webinars/notifications/reminder-emails-47","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                      |                                                                  |\n| -------------------- | ---------------------------------------------------------------- |\n| **Where you set it** | Webinar → **Notifications** → **Emails** → **Webinar Reminders** |","table":"table-0"},"3373":{"id":"/product-docs/webinars/notifications/reminder-emails-48","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|               |                                                                         |\n| ------------- | ----------------------------------------------------------------------- |\n| **Schedules** | Works for recurring and evergreen schedules, because timing is relative |","table":"table-0"},"3374":{"id":"/product-docs/webinars/notifications/reminder-emails-49","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                    |                                                                  |\n| ------------------ | ---------------------------------------------------------------- |\n| **Other channels** | **Reminder SMS** and WhatsApp **Reminder Message**, both in Beta |","table":"table-0"},"3375":{"id":"/product-docs/webinars/notifications/reminder-emails-50","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#at-a-glance","content":"|                       |                                                       |\n| --------------------- | ----------------------------------------------------- |\n| **How to measure it** | **Registered** to attended in the webinar's Analytics |","table":"table-0"},"3376":{"id":"/product-docs/webinars/notifications/reminder-emails-51","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#what-it-is","content":"A reminder is an email in the **Webinar Reminders** group on the **Notifications** tab. It goes to people who registered, before the webinar starts, and its purpose is to turn a registration into an attendance."},"3377":{"id":"/product-docs/webinars/notifications/reminder-emails-52","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#what-it-is","content":"What makes EasyWebinar's reminders work across webinar types is how their timing is set. A reminder isn't scheduled for a clock time like \"Tuesday at 9am\". It is set relative to the session, expressed as hours, minutes and seconds before the webinar, such as *0h 15m 0s before webinar*. A daily recurring webinar or an evergreen webinar has many sessions, and relative timing is why the same reminders work across all of them."},"3378":{"id":"/product-docs/webinars/notifications/reminder-emails-53","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#what-it-is","content":"Reminders sit between two other email groups. The **Registration Confirmation** goes out the moment someone signs up, and **Webinar Follow-ups** go out after the session. Reminders cover the time in between, which is when most registrants forget."},"3379":{"id":"/product-docs/webinars/notifications/reminder-emails-54","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#what-its-for","content":"Getting people to register is the easy part; getting them to turn up is what notifications are for. Reminders carry the date, the time and the way in back to the registrant at the points where they would otherwise drift away: the day before, when they can still plan around it, and the minutes before, when they need a prompt to click."},"3380":{"id":"/product-docs/webinars/notifications/reminder-emails-55","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#how-it-helps","content":"**It brings the session back into view.** A registration made days ago is easy to forget; a reminder an hour before puts it in front of the person again."},"3381":{"id":"/product-docs/webinars/notifications/reminder-emails-56","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#how-it-helps","content":"**The last reminder does most of the work.** In EasyWebinar's guidance, the reminder fifteen minutes before is the one that matters most for attendance."},"3382":{"id":"/product-docs/webinars/notifications/reminder-emails-57","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#how-it-helps","content":"**It runs on every session automatically.** Because timing is relative, there is nothing to reschedule when a recurring or evergreen webinar adds new sessions."},"3383":{"id":"/product-docs/webinars/notifications/reminder-emails-58","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#how-it-helps","content":"**It is measurable.** **Registered** to attended in Analytics tells you whether the reminders are doing their job."},"3384":{"id":"/product-docs/webinars/notifications/reminder-emails-59","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#without-it","content":"Without reminders, attendance depends on people remembering a session they signed up for days or weeks earlier, and finding their confirmation email at the right moment. Analytics makes the cost visible: a large **Missed** count, people who registered and never showed up, with a registration page that was doing its job. EasyWebinar's own reading of a low registered-to-attended rate is that it's a notification problem, not a content one."},"3385":{"id":"/product-docs/webinars/notifications/reminder-emails-60","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#why-buyers-care","content":"Every webinar result that matters to the business, offer clicks, purchases, booked calls, depends on people actually watching. A platform's reminders decide how many registrants make it into that group. Buyers look for reminders that need no manual scheduling, work on automated webinars, and can be added and timed freely."},"3386":{"id":"/product-docs/webinars/notifications/reminder-emails-61","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#find-reminders","content":"Open your webinar and click the **Notifications** tab."},"3387":{"id":"/product-docs/webinars/notifications/reminder-emails-62","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#find-reminders","content":"Stay on the **Emails** channel and find the **Webinar Reminders** group."},"3388":{"id":"/product-docs/webinars/notifications/reminder-emails-63","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#find-reminders","content":"*1 Channel tabs · 2 Email Settings · 3 An email group · 4 Create New.*"},"3389":{"id":"/product-docs/webinars/notifications/reminder-emails-64","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#find-reminders","content":"Each entry shows its **trigger**, the audience it goes **to**, and its **subject**, so the group reads as a timeline of what registrants will receive."},"3390":{"id":"/product-docs/webinars/notifications/reminder-emails-65","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#edit-reminder","content":"Open the reminder you want to change."},"3391":{"id":"/product-docs/webinars/notifications/reminder-emails-66","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#edit-reminder","content":"Change its subject, content and timing."},"3392":{"id":"/product-docs/webinars/notifications/reminder-emails-67","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#edit-reminder","content":"Set the timing as time before the webinar, in hours, minutes and seconds."},"3393":{"id":"/product-docs/webinars/notifications/reminder-emails-68","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#edit-reminder","content":"Save your changes."},"3394":{"id":"/product-docs/webinars/notifications/reminder-emails-69","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#add-reminder","content":"Click **Create New** in the **Webinar Reminders** group."},"3395":{"id":"/product-docs/webinars/notifications/reminder-emails-70","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#add-reminder","content":"Set its timing before the webinar."},"3396":{"id":"/product-docs/webinars/notifications/reminder-emails-71","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#add-reminder","content":"Write the subject and content."},"3397":{"id":"/product-docs/webinars/notifications/reminder-emails-72","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sensible-schedule","content":"| Reminder     | Timing before the webinar  | What it's for                                 |\n| ------------ | -------------------------- | --------------------------------------------- |\n| A day before | One day before the session | Lets people plan their day around the session |","table":"table-1"},"3398":{"id":"/product-docs/webinars/notifications/reminder-emails-73","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sensible-schedule","content":"| Reminder       | Timing before the webinar | What it's for                                                       |\n| -------------- | ------------------------- | ------------------------------------------------------------------- |\n| An hour before | *1h 0m 0s before webinar* | Brings the session back to mind while there's still time to prepare |","table":"table-1"},"3399":{"id":"/product-docs/webinars/notifications/reminder-emails-74","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sensible-schedule","content":"| Reminder               | Timing before the webinar  | What it's for                                              |\n| ---------------------- | -------------------------- | ---------------------------------------------------------- |\n| Fifteen minutes before | *0h 15m 0s before webinar* | The prompt to join now; the one that does most of the work |","table":"table-1"},"3400":{"id":"/product-docs/webinars/notifications/reminder-emails-75","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sensible-schedule","content":"Three is a sensible default. Webinars built with **Create with AI** arrive with exactly this pattern already drafted: **Reminder — 1d**, **Reminder — 1h** and **Reminder — 15m**, with merge tags already in place so dates, times and join links fill themselves in."},"3401":{"id":"/product-docs/webinars/notifications/reminder-emails-76","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#check-sender","content":"Reminders use the webinar's **Email Settings**: the **Sender name** registrants see and the **Reply-to email** where replies go. Set the sender to a name registrants will recognise from their confirmation."},"3402":{"id":"/product-docs/webinars/notifications/reminder-emails-77","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"Both Beta channels have a reminder of their own on the **Notifications** tab: **Reminder SMS** on the **SMS** tab and **Reminder Message** on the **Whatsapp** tab, each sent before the webinar starts. They work alongside email rather than replacing it, and suit the final reminder before a session, when an email may sit unread."},"3403":{"id":"/product-docs/webinars/notifications/reminder-emails-78","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"In short:"},"3404":{"id":"/product-docs/webinars/notifications/reminder-emails-79","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"**They need a phone number.** Add the **Phone** field to your registration form, or there is nobody to message."},"3405":{"id":"/product-docs/webinars/notifications/reminder-emails-80","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"**They come from an EasyWebinar number**, not your own."},"3406":{"id":"/product-docs/webinars/notifications/reminder-emails-81","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"**You build them from templates** grouped by tone, then edit the words."},"3407":{"id":"/product-docs/webinars/notifications/reminder-emails-82","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"**You can test first.** **Send Test SMS** and **Send Test Message** send the selected template to your own number. Pick your country from the flag dropdown rather than typing a dialling code."},"3408":{"id":"/product-docs/webinars/notifications/reminder-emails-83","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"**Keep them short.** A reminder needs the time and the link."},"3409":{"id":"/product-docs/webinars/notifications/reminder-emails-84","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#sms-whatsapp","content":"Pick whichever channel your audience actually uses. Sending both tends to irritate people."},"3410":{"id":"/product-docs/webinars/notifications/reminder-emails-85","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-confirmation","content":"The confirmation starts the sequence and carries the join link; reminders bring the registrant back to it. Both are on the same tab and share the same sender settings."},"3411":{"id":"/product-docs/webinars/notifications/reminder-emails-86","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-evergreen","content":"An evergreen webinar generates a long run of sessions from one schedule, and can add just-in-time sessions that start shortly after someone registers. Reminders are timed relative to the webinar rather than to a clock, which is why they work for recurring and evergreen schedules without being set session by session."},"3412":{"id":"/product-docs/webinars/notifications/reminder-emails-87","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-analytics","content":"The webinar's **Analytics** tab shows the funnel from **Visitors** to **Registered**, **Live Attended**, **Total Attended** and **Missed**. Two gaps tell you different things:"},"3413":{"id":"/product-docs/webinars/notifications/reminder-emails-88","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-analytics","content":"| Gap                            | What a low number means                                          |\n| ------------------------------ | ---------------------------------------------------------------- |\n| **Visitors** to **Registered** | A registration page problem: the headline, the form, the promise |","table":"table-2"},"3414":{"id":"/product-docs/webinars/notifications/reminder-emails-89","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-analytics","content":"| Gap                        | What a low number means                   |\n| -------------------------- | ----------------------------------------- |\n| **Registered** to attended | A notification problem, not a content one |","table":"table-2"},"3415":{"id":"/product-docs/webinars/notifications/reminder-emails-90","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-analytics","content":"Change your reminders, run the next session, and compare."},"3416":{"id":"/product-docs/webinars/notifications/reminder-emails-91","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-follow-ups","content":"**Missed** counts people who registered and never showed up. Add a **Webinar Follow-up** with its audience set to no-shows and include the replay link. In **People**, filter by **Behavior** for no-shows to see exactly who they are, then **Export** the list if you need it elsewhere."},"3417":{"id":"/product-docs/webinars/notifications/reminder-emails-92","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-crm","content":"If you would rather send reminders from your CRM or email tool, map the **Webinar Join Link** into one of its custom fields. Each contact then holds their own working link, which is what lets your system send the reminder instead of EasyWebinar."},"3418":{"id":"/product-docs/webinars/notifications/reminder-emails-93","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#with-cloning","content":"**Email notifications** can come across when you clone a webinar, so a reminder schedule you have tuned carries into the copy."},"3419":{"id":"/product-docs/webinars/notifications/reminder-emails-94","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#who-uses-it","content":"These are typical patterns, shown to illustrate how reminders fit different kinds of webinar."},"3420":{"id":"/product-docs/webinars/notifications/reminder-emails-95","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#product-teams","content":"A product team runs a weekly live demo. The three-reminder pattern goes out before every session without anyone touching it, and the team watches **Registered** to attended week by week to see whether a subject-line change made a difference."},"3421":{"id":"/product-docs/webinars/notifications/reminder-emails-96","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#course-creators","content":"A creator's evergreen webinar runs daily. Because reminder timing is relative to the webinar, the same three emails serve the whole schedule. The creator adds a Beta **Reminder SMS** as the final nudge for an audience that reads texts faster than email. See selling online courses with webinars."},"3422":{"id":"/product-docs/webinars/notifications/reminder-emails-97","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#customer-success","content":"A customer success team runs onboarding webinars for new customers. Their reminders restate what to have ready before the session, and the fifteen-minute reminder carries the link and nothing else."},"3423":{"id":"/product-docs/webinars/notifications/reminder-emails-98","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#b2b-marketing","content":"A marketing team already runs its nurture emails from its own system, so it maps the **Webinar Join Link** into a CRM field and sends one of the reminders from there, keeping EasyWebinar's reminders for the final hour."},"3424":{"id":"/product-docs/webinars/notifications/reminder-emails-99","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"**Timing is relative to the webinar**, not a fixed clock time. Set it in hours, minutes and seconds before the session."},"3425":{"id":"/product-docs/webinars/notifications/reminder-emails-100","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"**Reminders are set per webinar.** Use cloning to carry a schedule to a new webinar."},"3426":{"id":"/product-docs/webinars/notifications/reminder-emails-101","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"**Reminders go to registrants.** They are written once per webinar and sent to the people who registered for it."},"3427":{"id":"/product-docs/webinars/notifications/reminder-emails-102","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"**SMS and WhatsApp reminders are in Beta** and only reach people who gave a phone number on your registration form."},"3428":{"id":"/product-docs/webinars/notifications/reminder-emails-103","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"**SMS and WhatsApp come from an EasyWebinar number**, so replies don't reach your phone."},"3429":{"id":"/product-docs/webinars/notifications/reminder-emails-104","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#limits","content":"**Email stays the main channel.** Text and WhatsApp reminders work alongside email, not instead of it."},"3430":{"id":"/product-docs/webinars/notifications/reminder-emails-105","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-how-many","content":"Three is a sensible default: a day before, an hour before, and fifteen minutes before. The last one does most of the work."},"3431":{"id":"/product-docs/webinars/notifications/reminder-emails-106","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-add-more","content":"Yes. Click **Create New** in the **Webinar Reminders** group, and set the timing for each."},"3432":{"id":"/product-docs/webinars/notifications/reminder-emails-107","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-timing","content":"As time before the webinar, in hours, minutes and seconds, for example *1h 0m 0s before webinar*."},"3433":{"id":"/product-docs/webinars/notifications/reminder-emails-108","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-evergreen","content":"Yes. Timing is relative to the webinar, not a fixed clock time, so it works for recurring and evergreen schedules."},"3434":{"id":"/product-docs/webinars/notifications/reminder-emails-109","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-edit","content":"Yes. Open the reminder to change its subject, content and timing."},"3435":{"id":"/product-docs/webinars/notifications/reminder-emails-110","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-measure","content":"Compare **Registered** with attendance in the webinar's Analytics. A low registered-to-attended rate points to your notifications, not your content."},"3436":{"id":"/product-docs/webinars/notifications/reminder-emails-111","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-sms-whatsapp","content":"Both are in Beta. **Reminder SMS** and the WhatsApp **Reminder Message** send before the webinar starts, and both need the **Phone** field on your registration form."},"3437":{"id":"/product-docs/webinars/notifications/reminder-emails-112","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-test","content":"Yes. **Send Test SMS** and **Send Test Message** send the selected template to your own number so you see exactly what registrants receive."},"3438":{"id":"/product-docs/webinars/notifications/reminder-emails-113","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-ai","content":"Yes. **Create with AI** drafts reminders for a day, an hour and fifteen minutes before, with merge tags for dates, times and join links."},"3439":{"id":"/product-docs/webinars/notifications/reminder-emails-114","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-no-shows","content":"Add a **Webinar Follow-up** with its audience set to no-shows and include the replay link."},"3440":{"id":"/product-docs/webinars/notifications/reminder-emails-115","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#faq-crm","content":"Yes. Map the **Webinar Join Link** into a custom field in your CRM so each contact has their own working link."},"3441":{"id":"/product-docs/webinars/notifications/reminder-emails-116","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Registration confirmation emails: the first email in the sequence, carrying the join link your reminders point back to."},"3442":{"id":"/product-docs/webinars/notifications/reminder-emails-117","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Webinar analytics: read Registered against attended to judge your reminders."},"3443":{"id":"/product-docs/webinars/notifications/reminder-emails-118","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Replay pages: the page to send no-shows the reminders didn't reach."},"3444":{"id":"/product-docs/webinars/notifications/reminder-emails-119","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Create an evergreen webinar: the schedule where relative timing saves the most work."},"3445":{"id":"/product-docs/webinars/notifications/reminder-emails-120","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Create a webinar with AI: starts you with the three-reminder pattern already drafted."},"3446":{"id":"/product-docs/webinars/notifications/reminder-emails-121","page_id":"/product-docs/webinars/notifications/reminder-emails","tags":[],"type":"text","url":"/product-docs/webinars/notifications/reminder-emails#related","content":"Connect a CRM and map your webinar data: send reminders from your own system instead."},"3447":{"id":"/product-docs/webinars/on-demand","page_id":"/product-docs/webinars/on-demand","type":"page","content":"On Demand (instant replay)","breadcrumbs":["EasyWebinar documentation","Webinars"],"tags":[],"url":"/product-docs/webinars/on-demand"},"3448":{"id":"/product-docs/webinars/on-demand-0","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand","content":"How On Demand works on EasyWebinar's evergreen webinars, letting registrants start watching straight away, how to label its button, and how it differs from the replay page."},"3449":{"id":"/product-docs/webinars/on-demand-1","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#at-a-glance","content":"At a glance"},"3450":{"id":"/product-docs/webinars/on-demand-2","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#what-it-is","content":"What On Demand is"},"3451":{"id":"/product-docs/webinars/on-demand-3","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"On Demand and the replay page are different"},"3452":{"id":"/product-docs/webinars/on-demand-4","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#why-it-matters","content":"Why On Demand matters"},"3453":{"id":"/product-docs/webinars/on-demand-5","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#what-its-for","content":"What it's for"},"3454":{"id":"/product-docs/webinars/on-demand-6","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#how-it-helps","content":"How it helps"},"3455":{"id":"/product-docs/webinars/on-demand-7","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#without-it","content":"What happens without it"},"3456":{"id":"/product-docs/webinars/on-demand-8","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#why-buyers-care","content":"Why buyers care"},"3457":{"id":"/product-docs/webinars/on-demand-9","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#set-it-up","content":"Set it up"},"3458":{"id":"/product-docs/webinars/on-demand-10","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#set-up-new","content":"On a new evergreen webinar"},"3459":{"id":"/product-docs/webinars/on-demand-11","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#set-up-existing","content":"On an existing evergreen webinar"},"3460":{"id":"/product-docs/webinars/on-demand-12","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#settings","content":"Settings"},"3461":{"id":"/product-docs/webinars/on-demand-13","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#button-wording","content":"Wording the button"},"3462":{"id":"/product-docs/webinars/on-demand-14","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#when-to-use","content":"When to use On Demand, and when to leave it off"},"3463":{"id":"/product-docs/webinars/on-demand-15","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#works-with","content":"How On Demand works with other features"},"3464":{"id":"/product-docs/webinars/on-demand-16","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#with-just-in-time","content":"Just-in-time Registration"},"3465":{"id":"/product-docs/webinars/on-demand-17","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#with-recurring","content":"Recurring Schedule"},"3466":{"id":"/product-docs/webinars/on-demand-18","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#with-replay-page","content":"The replay page"},"3467":{"id":"/product-docs/webinars/on-demand-19","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#with-engagement","content":"Polls, offers and chat"},"3468":{"id":"/product-docs/webinars/on-demand-20","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#with-notifications","content":"Emails"},"3469":{"id":"/product-docs/webinars/on-demand-21","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#with-plan-usage","content":"Plan usage"},"3470":{"id":"/product-docs/webinars/on-demand-22","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#who-uses-it","content":"Who uses On Demand, and how"},"3471":{"id":"/product-docs/webinars/on-demand-23","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#customer-success","content":"Customer success teams"},"3472":{"id":"/product-docs/webinars/on-demand-24","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#saas-teams","content":"SaaS and product teams"},"3473":{"id":"/product-docs/webinars/on-demand-25","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#course-creators","content":"Course creators"},"3474":{"id":"/product-docs/webinars/on-demand-26","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#coaches","content":"Coaches and consultants"},"3475":{"id":"/product-docs/webinars/on-demand-27","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#limits","content":"Limits and things to know"},"3476":{"id":"/product-docs/webinars/on-demand-28","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#common-questions","content":"Common questions"},"3477":{"id":"/product-docs/webinars/on-demand-29","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-what-it-does","content":"What does On Demand do?"},"3478":{"id":"/product-docs/webinars/on-demand-30","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-instant-replay","content":"Is On Demand the same as instant replay?"},"3479":{"id":"/product-docs/webinars/on-demand-31","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-vs-replay","content":"What's the difference between instant replay and a replay?"},"3480":{"id":"/product-docs/webinars/on-demand-32","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-button-text","content":"Can I change the button text?"},"3481":{"id":"/product-docs/webinars/on-demand-33","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-together","content":"Can I offer On Demand and scheduled sessions together?"},"3482":{"id":"/product-docs/webinars/on-demand-34","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-where","content":"Where do I turn On Demand on?"},"3483":{"id":"/product-docs/webinars/on-demand-35","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-other-types","content":"Can a live or simulive webinar have On Demand?"},"3484":{"id":"/product-docs/webinars/on-demand-36","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-catch-up","content":"I want people who missed a session to catch up. Is On Demand the right tool?"},"3485":{"id":"/product-docs/webinars/on-demand-37","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#faq-always-on","content":"Should every evergreen webinar have On Demand on?"},"3486":{"id":"/product-docs/webinars/on-demand-38","page_id":"/product-docs/webinars/on-demand","type":"heading","tags":[],"url":"/product-docs/webinars/on-demand#related","content":"Related"},"3487":{"id":"/product-docs/webinars/on-demand-39","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand","content":"**On Demand** is an evergreen schedule setting that lets a registrant start watching your webinar straight away, with no session to wait for. EasyWebinar also calls it **instant replay**: registrants click a button, labelled *Watch instant replay* unless you change it, and the recording starts. It is a different thing from the replay page on the **Replay** tab, which shows the recording of a session that has already happened."},"3488":{"id":"/product-docs/webinars/on-demand-40","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                  |                                                                     |\n| ---------------- | ------------------------------------------------------------------- |\n| **What it does** | Lets registrants watch immediately instead of waiting for a session |","table":"table-0"},"3489":{"id":"/product-docs/webinars/on-demand-41","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                 |                |\n| --------------- | -------------- |\n| **Also called** | Instant replay |","table":"table-0"},"3490":{"id":"/product-docs/webinars/on-demand-42","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                    |                                           |\n| ------------------ | ----------------------------------------- |\n| **Where it's set** | The schedule step of an evergreen webinar |","table":"table-0"},"3491":{"id":"/product-docs/webinars/on-demand-43","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                   |           |\n| ----------------- | --------- |\n| **Webinar types** | Evergreen |","table":"table-0"},"3492":{"id":"/product-docs/webinars/on-demand-44","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                    |                                                                  |\n| ------------------ | ---------------------------------------------------------------- |\n| **Button wording** | **Instant replay text**; reads *Watch instant replay* by default |","table":"table-0"},"3493":{"id":"/product-docs/webinars/on-demand-45","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                   |                                                                              |\n| ----------------- | ---------------------------------------------------------------------------- |\n| **Combines with** | **Just-in-time Registration** and **Recurring Schedule** on the same webinar |","table":"table-0"},"3494":{"id":"/product-docs/webinars/on-demand-46","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#at-a-glance","content":"|                     |                                       |\n| ------------------- | ------------------------------------- |\n| **Not the same as** | The replay page on the **Replay** tab |","table":"table-0"},"3495":{"id":"/product-docs/webinars/on-demand-47","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#what-it-is","content":"An evergreen webinar can offer three ways to watch. On Demand is the one with no wait at all: the registrant doesn't pick a session time, they start the recording when they're ready."},"3496":{"id":"/product-docs/webinars/on-demand-48","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#what-it-is","content":"| Option        | When the registrant watches |\n| ------------- | --------------------------- |\n| **On Demand** | Immediately                 |","table":"table-1"},"3497":{"id":"/product-docs/webinars/on-demand-49","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#what-it-is","content":"| Option                        | When the registrant watches                             |\n| ----------------------------- | ------------------------------------------------------- |\n| **Just-in-time Registration** | In a session starting a few minutes after they register |","table":"table-1"},"3498":{"id":"/product-docs/webinars/on-demand-50","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#what-it-is","content":"| Option                 | When the registrant watches   |\n| ---------------------- | ----------------------------- |\n| **Recurring Schedule** | At a set daily or weekly time |","table":"table-1"},"3499":{"id":"/product-docs/webinars/on-demand-51","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#what-it-is","content":"Any combination can be switched on, and the registration page lists each enabled option as a choice."},"3500":{"id":"/product-docs/webinars/on-demand-52","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"The names overlap, so the two are easy to mix up."},"3501":{"id":"/product-docs/webinars/on-demand-53","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"|                   | On Demand (instant replay)                                       | Replay page                                          |\n| ----------------- | ---------------------------------------------------------------- | ---------------------------------------------------- |\n| **What it plays** | The evergreen webinar's recording, whenever a registrant chooses | The recording of a session that has already happened |","table":"table-2"},"3502":{"id":"/product-docs/webinars/on-demand-54","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"|                  | On Demand (instant replay)                                  | Replay page                                      |\n| ---------------- | ----------------------------------------------------------- | ------------------------------------------------ |\n| **Who it's for** | People who want to watch now rather than wait for a session | People who missed a session and want to catch up |","table":"table-2"},"3503":{"id":"/product-docs/webinars/on-demand-55","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"|                      | On Demand (instant replay)                | Replay page                     |\n| -------------------- | ----------------------------------------- | ------------------------------- |\n| **Where you set it** | The schedule step of an evergreen webinar | The **Replay** tab of a webinar |","table":"table-2"},"3504":{"id":"/product-docs/webinars/on-demand-56","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"|                        | On Demand (instant replay)                 | Replay page                                                                           |\n| ---------------------- | ------------------------------------------ | ------------------------------------------------------------------------------------- |\n| **What you configure** | On or off, and the **Instant replay text** | Whether the page is on, how long it stays available, redirects and how the page looks |","table":"table-2"},"3505":{"id":"/product-docs/webinars/on-demand-57","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#on-demand-vs-replay","content":"A simple rule: if you want people to watch the moment they register, use On Demand on an evergreen webinar. If you want people who missed a session to catch up, use the replay page."},"3506":{"id":"/product-docs/webinars/on-demand-58","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#what-its-for","content":"On Demand is for evergreen webinars where the content is the point, not the occasion: training, product explainers, onboarding material and other sessions people want to get through on their own timetable."},"3507":{"id":"/product-docs/webinars/on-demand-59","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#how-it-helps","content":"**No waiting at all.** A registrant who is ready now can watch now."},"3508":{"id":"/product-docs/webinars/on-demand-60","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#how-it-helps","content":"**It suits people short on time.** Someone who has twenty minutes free between meetings doesn't have to fit a session around them."},"3509":{"id":"/product-docs/webinars/on-demand-61","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#how-it-helps","content":"**It sits alongside scheduled options.** Registrants who'd rather turn up for a session can still pick a just-in-time or recurring one."},"3510":{"id":"/product-docs/webinars/on-demand-62","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#how-it-helps","content":"**The button speaks your language.** **Instant replay text** lets you word the button to match your page."},"3511":{"id":"/product-docs/webinars/on-demand-63","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#without-it","content":"Without On Demand, every registrant has to wait for a session, even if only a few minutes with just-in-time. For content people want to consume as soon as they find it, any wait is a chance for them to leave and not return."},"3512":{"id":"/product-docs/webinars/on-demand-64","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#why-buyers-care","content":"Teams using evergreen webinars for education and onboarding want people to get the content when they ask for it. On Demand gives registrants immediate access from the same registration page, recording and webinar setup."},"3513":{"id":"/product-docs/webinars/on-demand-65","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"On **My Webinars**, click **Create a Webinar**, then **Create Manually**."},"3514":{"id":"/product-docs/webinars/on-demand-66","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"Name the webinar, choose **Evergreen Webinar**, and click **Continue to Schedule**."},"3515":{"id":"/product-docs/webinars/on-demand-67","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"Switch on **On Demand**."},"3516":{"id":"/product-docs/webinars/on-demand-68","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"In **Instant replay text**, keep *Watch instant replay* or type your own wording."},"3517":{"id":"/product-docs/webinars/on-demand-69","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"Set any other options you want alongside it: **Just-in-time Registration**, **Recurring Schedule**, **Availability** and **Schedule Preferences**."},"3518":{"id":"/product-docs/webinars/on-demand-70","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"Click **Continue to Pricing** and complete the remaining steps."},"3519":{"id":"/product-docs/webinars/on-demand-71","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"*1 Just-in-time Registration · 2 On Demand · 3 Recurring Schedule · 4 Availability · 5 Schedule Preferences.*"},"3520":{"id":"/product-docs/webinars/on-demand-72","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-new","content":"For pricing, video selection and templates, see Create an evergreen webinar."},"3521":{"id":"/product-docs/webinars/on-demand-73","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#set-up-existing","content":"On the webinar's **Overview** tab, the options menu on the **Scheduling Options** panel changes the schedule for the whole webinar. The same panel shows the frequency, start date, timezone and the preference you chose."},"3522":{"id":"/product-docs/webinars/on-demand-74","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#settings","content":"| Setting       | What it controls                                     |\n| ------------- | ---------------------------------------------------- |\n| **On Demand** | Whether registrants can start watching straight away |","table":"table-3"},"3523":{"id":"/product-docs/webinars/on-demand-75","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#settings","content":"| Setting                 | What it controls                                                               |\n| ----------------------- | ------------------------------------------------------------------------------ |\n| **Instant replay text** | The wording on the button registrants click; *Watch instant replay* by default |","table":"table-3"},"3524":{"id":"/product-docs/webinars/on-demand-76","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#settings","content":"| Setting                  | What it controls                                                                                           |\n| ------------------------ | ---------------------------------------------------------------------------------------------------------- |\n| **Schedule Preferences** | The choices registrants see; with just-in-time also on, it reads **Display Just-in-time & Instant-replay** |","table":"table-3"},"3525":{"id":"/product-docs/webinars/on-demand-77","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#button-wording","content":"The default *Watch instant replay* works, but the word \"replay\" can suggest a recording of something people missed. If your page sells the webinar as fresh content, wording that says what happens next, such as starting the training now, can read more naturally. Whatever you choose, keep it short enough to fit a button."},"3526":{"id":"/product-docs/webinars/on-demand-78","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#when-to-use","content":"The deciding question is whether the webinar is valued for its content or for the occasion."},"3527":{"id":"/product-docs/webinars/on-demand-79","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#when-to-use","content":"| Use On Demand when                                  | Leave it off when                                                        |\n| --------------------------------------------------- | ------------------------------------------------------------------------ |\n| The content matters more than the sense of an event | You want the scheduled session to feel like something people turn up for |","table":"table-4"},"3528":{"id":"/product-docs/webinars/on-demand-80","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#when-to-use","content":"With On Demand off, registrants still have just-in-time or recurring sessions if you've enabled them."},"3529":{"id":"/product-docs/webinars/on-demand-81","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#with-just-in-time","content":"Just-in-time offers a session a few minutes away, in each attendee's local time. With both on, registrants choose between watching now and joining a session shortly. See Just-in-time webinars."},"3530":{"id":"/product-docs/webinars/on-demand-82","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#with-recurring","content":"A daily or weekly schedule can run alongside On Demand for registrants who want to book a time. Recurring sessions run in the webinar's timezone."},"3531":{"id":"/product-docs/webinars/on-demand-83","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#with-replay-page","content":"The **Replay** tab controls a separate page for people who missed a session, with availability options of **Always Available**, **Expire after days** or **Specific date**, and an **Experience** of **Webinar Replica** or **Custom Build**. Those settings belong to the replay page, not to On Demand."},"3532":{"id":"/product-docs/webinars/on-demand-84","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#with-engagement","content":"Chat, Q&A, polls, offers, emails and analytics work on evergreen webinars as they do everywhere else. Where viewers watch at different times, **Chat Simulation** on the **Engagement** tab keeps the chat from looking empty. See Chat simulation."},"3533":{"id":"/product-docs/webinars/on-demand-85","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#with-notifications","content":"Confirmation, reminder and follow-up emails are set on the **Notifications** tab. Replay emails are set up there too, not on the **Replay** tab. See Confirmation emails."},"3534":{"id":"/product-docs/webinars/on-demand-86","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#with-plan-usage","content":"People watching evergreen sessions count towards the **Automated attendees** meter on the **Plan** tab."},"3535":{"id":"/product-docs/webinars/on-demand-87","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#who-uses-it","content":"These are typical patterns, shown to illustrate how the setting is used."},"3536":{"id":"/product-docs/webinars/on-demand-88","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#customer-success","content":"A customer success team runs its product onboarding as an evergreen webinar with On Demand on. New customers register and start the walkthrough immediately, and the button reads *Start onboarding* instead of the default."},"3537":{"id":"/product-docs/webinars/on-demand-89","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#saas-teams","content":"A product team offers a recorded feature walkthrough with On Demand alongside just-in-time. Evaluators in a hurry watch straight away; others join a session a few minutes later."},"3538":{"id":"/product-docs/webinars/on-demand-90","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#course-creators","content":"A creator offers a free training lesson on demand, so new subscribers can start it the moment they sign up. On a separate sales webinar, the creator leaves On Demand off so the session feels like an event people turn up for. See Selling online courses with webinars."},"3539":{"id":"/product-docs/webinars/on-demand-91","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#coaches","content":"A consultant puts an explainer webinar on demand for prospects to watch before a first call, so the call can start from where the webinar left off."},"3540":{"id":"/product-docs/webinars/on-demand-92","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#limits","content":"**Evergreen only.** On Demand is set on the evergreen schedule step. Live and simulive webinars don't have it."},"3541":{"id":"/product-docs/webinars/on-demand-93","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#limits","content":"**It isn't the replay page.** Replay availability, deadlines, redirects and the replay page's look are set on the **Replay** tab for the replay page."},"3542":{"id":"/product-docs/webinars/on-demand-94","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#limits","content":"**The recording is the webinar's.** An evergreen webinar plays the recording chosen on its video step; change it from the **Webinar Video** panel on the **Content** tab."},"3543":{"id":"/product-docs/webinars/on-demand-95","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#limits","content":"**The type is fixed.** To offer On Demand for a live or simulive webinar, clone it as **Evergreen**. See Clone a webinar."},"3544":{"id":"/product-docs/webinars/on-demand-96","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-what-it-does","content":"It lets someone watch immediately, with no session to wait for."},"3545":{"id":"/product-docs/webinars/on-demand-97","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-instant-replay","content":"Yes. They're two names for the same evergreen setting."},"3546":{"id":"/product-docs/webinars/on-demand-98","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-vs-replay","content":"A replay is the recording of a past session, on the **Replay** tab. Instant replay, or On Demand, lets someone watch an evergreen webinar straight away without waiting for a session."},"3547":{"id":"/product-docs/webinars/on-demand-99","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-button-text","content":"Yes. Edit **Instant replay text** on the schedule step. It reads *Watch instant replay* by default."},"3548":{"id":"/product-docs/webinars/on-demand-100","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-together","content":"Yes. Turn on **Just-in-time Registration**, **Recurring Schedule** or both alongside it, and the registration page offers each as a choice."},"3549":{"id":"/product-docs/webinars/on-demand-101","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-where","content":"On the schedule step when you set up an evergreen webinar, not on the **Replay** tab."},"3550":{"id":"/product-docs/webinars/on-demand-102","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-other-types","content":"No. It's an evergreen setting. Clone the webinar as **Evergreen** to use it."},"3551":{"id":"/product-docs/webinars/on-demand-103","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-catch-up","content":"No. Use the replay page on the **Replay** tab for that."},"3552":{"id":"/product-docs/webinars/on-demand-104","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#faq-always-on","content":"Not necessarily. Turn it on when the content matters more than the event feeling, and leave it off when you want a scheduled session people turn up for."},"3553":{"id":"/product-docs/webinars/on-demand-105","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#related","content":"Just-in-time webinars: the option for registrants happy to wait a few minutes for a session."},"3554":{"id":"/product-docs/webinars/on-demand-106","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#related","content":"Create an evergreen webinar: the schedule step where On Demand is switched on."},"3555":{"id":"/product-docs/webinars/on-demand-107","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#related","content":"Replay pages: the separate page for people who missed a session."},"3556":{"id":"/product-docs/webinars/on-demand-108","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#related","content":"Chat simulation: a chat for registrants who start watching at different times."},"3557":{"id":"/product-docs/webinars/on-demand-109","page_id":"/product-docs/webinars/on-demand","tags":[],"type":"text","url":"/product-docs/webinars/on-demand#related","content":"Clone a webinar: how a live or simulive webinar gets On Demand viewing."},"3558":{"id":"/product-docs/webinars/registration/custom-fields","page_id":"/product-docs/webinars/registration/custom-fields","type":"page","content":"Custom registration fields","breadcrumbs":["EasyWebinar documentation","Webinars","Registration and pages"],"tags":[],"url":"/product-docs/webinars/registration/custom-fields"},"3559":{"id":"/product-docs/webinars/registration/custom-fields-0","page_id":"/product-docs/webinars/registration/custom-fields","tags":[],"type":"text","url":"/product-docs/webinars/registration/custom-fields","content":"Add a phone field, your own custom questions, a GDPR consent checkbox and UTM campaign capture to an EasyWebinar registration form, and see where that data shows up afterwards."},"3560":{"id":"/product-docs/webinars/registration/custom-fields-1","page_id":"/product-docs/webinars/registration/custom-fields","type":"heading","tags":[],"url":"/product-docs/webinars/registration/custom-fields#at-a-glance","content":"At a glance"},"3561":{"id":"/product-docs/webinars/registration/custom-fields-2","page_id":"/product-docs/webinars/registration/custom-fields","type":"heading","tags":[],"url":"/product-docs/webinars/registration/custom-fields#what-it-is","content":"What custom registration fields are"},"3562":{"id":"/product-docs/webinars/registration/custom-fields-3","page_id":"/product-docs/webinars/registration/custom-fields","type":"heading","tags":[],"url":"/product-docs/webinars/registration/custom-fields#why-it-matters","content":"Why custom fields matter"},"3563":{"id":"/product-docs/webinars/registration/custom-fields-4","page_id":"/product-docs/webinars/registration/custom-fields","type":"heading","tags":[],"url":"/product-docs/webinars/registration/custom-fields#what-its-for","conten