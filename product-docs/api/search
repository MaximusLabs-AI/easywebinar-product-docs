**. See Registration page builder."],[5070,"Your registration page lives on your subdomain, ending in `.easywebinar.live`, set in your profile. The **C-Name** add-on, with a CNAME record at your DNS provider, puts the pages on your own domain. The **White Label** add-on removes EasyWebinar branding. Changing your subdomain changes your existing links, so set it before you promote anything."],[693,"Your rules appear under **Current mappings**."]],"type":"string"},"page_id":{"docs":{"1":25,"2":26,"3":27,"4":28,"5":29,"6":30,"7":31,"8":32,"9":33,"10":34,"11":35,"12":36,"13":37,"14":38,"15":39,"16":40,"17":41,"18":42,"19":43,"20":44,"21":45,"22":46,"23":47,"24":48,"25":49,"26":50,"27":51,"28":52,"29":53,"30":54,"31":55,"32":56,"33":57,"34":58,"35":59,"36":60,"37":61,"38":62,"39":63,"40":64,"41":65,"42":66,"43":67,"44":68,"45":69,"46":70,"47":71,"48":72,"49":73,"50":74,"51":75,"52":76,"53":77,"54":78,"55":79,"56":80,"57":81,"58":82,"59":83,"60":84,"61":85,"62":86,"63":87,"64":88,"65":89,"66":90,"67":91,"68":92,"69":93,"70":94,"71":95,"72":96,"73":97,"74":98,"75":99,"76":100,"77":101,"78":102,"79":103,"80":104,"81":105,"82":106,"83":107,"84":108,"85":109,"86":110,"87":111,"88":112,"89":113,"90":114,"91":115,"92":116,"93":117,"94":118,"95":119,"96":120,"97":121,"98":122,"99":123,"100":124,"101":125,"102":126,"103":127,"104":128,"105":129,"106":130,"107":131,"108":132,"109":133,"110":134,"111":135,"112":136,"113":137,"114":138,"115":139,"116":140,"117":141,"118":142,"119":143,"120":144,"121":145,"122":146,"123":147,"124":148,"125":149,"126":150,"127":151,"128":152,"129":153,"130":154,"131":155,"132":156,"133":157,"134":158,"135":159,"136":160,"137":161,"138":162,"139":163,"140":164,"141":165,"142":166,"143":167,"144":168,"145":169,"146":170,"147":171,"148":172,"149":173,"150":174,"151":175,"152":176,"153":177,"154":178,"155":179,"156":180,"157":181,"158":182,"159":183,"160":184,"161":185,"162":186,"163":187,"164":188,"165":189,"166":190,"167":191,"168":192,"169":193,"170":1