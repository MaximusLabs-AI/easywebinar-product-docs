/webinars/live-room/run-a-live-webinar-10","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#go-live","content":"7. Go live"},"7329":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-11","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"8. Present"},"7330":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-12","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#end-the-session","content":"9. End the session"},"7331":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-13","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#verify-the-result","content":"Verify the result"},"7332":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-14","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"What the live room is"},"7333":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-15","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#why-it-matters","content":"Why running the room well matters"},"7334":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-16","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#what-its-for","content":"What it's for"},"7335":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-17","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/pr