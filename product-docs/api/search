ding","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#who-saas","content":"SaaS and product teams"},"7727":{"id":"/product-docs/webinars/media/automatic-recording-37","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#who-customer-success","content":"Customer success teams"},"7728":{"id":"/product-docs/webinars/media/automatic-recording-38","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#compare","content":"How EasyWebinar compares for webinar recording"},"7729":{"id":"/product-docs/webinars/media/automatic-recording-39","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#compare-stronger","content":"Why EasyWebinar is the stronger choice for webinar recording"},"7730":{"id":"/product-docs/webinars/media/automatic-recording-40","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#limits","content":"Limits of webinar recording"},"7731":{"id":"/product-docs/webinars/media/automatic-recording-41","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#common-questions","content":"Common questions"},"7732":{"id":"/product-docs/webinars/media/automatic-recording-42","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-automatic","content":"Is my webinar recorded automatically?"},"7733":{"id":"/product-docs/webinars/media/automatic-recording-43","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-running","content":"How do I know the recording is running?"},"7734":{"id":"/product-docs/webinars/media/automatic-recording-44","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-where","content":"Where do I find the recording after a live webinar?"},"7735":{"id":"/product-docs/webinars/media/automatic-recording-45","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-evergreen","content":"Can I reuse a webinar recording as an evergreen webinar?"},"7736":{"id":"/product-docs/webinars/media/automatic-recording-46","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-replay","content":"Can I use the recording as a replay?"},"7737":{"id":"/product-docs/webinars/media/automatic-recording-47","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-turn-off","content":"How do I turn recording off for one session?"},"7738":{"id":"/product-docs/webinars/media/automatic-recording-48","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-storage","content":"Do recordings use my storage?"},"7739":{"id":"/product-docs/webinars/media/automatic-recording-49","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-drawings","content":"Are drawings on my shared screen in the recording?"},"7740":{"id":"/product-docs/webinars/media/automatic-recording-50","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-zoom-in","content":"If an attendee zooms in on my shared screen, is that recorded?"},"7741":{"id":"/product-docs/webinars/media/automatic-recording-51","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-camera","content":"Do I need a camera and microphone to record?"},"7742":{"id":"/product-docs/webinars/media/automatic-recording-52","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-elsewhere","content":"Can I record a webinar I run somewhere else?"},"7743":{"id":"/product-docs/webinars/media/automatic-recording-53","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-complete","content":"How can I tell a recording is complete?"},"7744":{"id":"/product-docs/webinars/media/automatic-recording-54","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#faq-several","content":"A webinar I ran several times has several recordings. Which is which?"},"7745":{"id":"/product-docs/webinars/media/automatic-recording-55","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#further-reading","content":"Further reading"},"7746":{"id":"/product-docs/webinars/media/automatic-recording-56","page_id":"/product-docs/webinars/media/automatic-recording","type":"heading","tags":[],"url":"/product-docs/webinars/media/automatic-recording#related","content":"Related"},"7747":{"id":"/product-docs/webinars/media/automatic-recording-57","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording","content":"How to record a webinar is usually the question a few minutes before you present: is this session being captured, and where will the copy be afterwards? This page covers recording a webinar you run live in EasyWebinar, the webinar platform. Recording is on by default, the room header tells you so, and the finished session lands in your **Library** under **Recordings**, ready to reuse as a replay or as an evergreen webinar's content."},"7748":{"id":"/product-docs/webinars/media/automatic-recording-58","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                                           |                                                        |\n| ----------------------------------------- | ------------------------------------------------------ |\n| **Is my webinar recorded automatically?** | Yes. Auto Recording is on by default for live sessions |","table":"table-0"},"7749":{"id":"/product-docs/webinars/media/automatic-recording-59","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                          |                                                                   |\n| ------------------------ | ----------------------------------------------------------------- |\n| **How you know it's on** | The room header shows **Auto Recording Enabled** before you start |","table":"table-0"},"7750":{"id":"/product-docs/webinars/media/automatic-recording-60","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                               |                                                     |\n| ----------------------------- | --------------------------------------------------- |\n| **How you know it's running** | The badge changes to **Recording** once you go live |","table":"table-0"},"7751":{"id":"/product-docs/webinars/media/automatic-recording-61","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                         |                                                         |\n| ----------------------- | ------------------------------------------------------- |\n| **Where you change it** | In the live room, **Settings** → **Recording Settings** |","table":"table-0"},"7752":{"id":"/product-docs/webinars/media/automatic-recording-62","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                              |                                                                                   |\n| ---------------------------- | --------------------------------------------------------------------------------- |\n| **Where the recording goes** | **Library** → **Recordings**, named after its webinar, with its duration and date |","table":"table-0"},"7753":{"id":"/product-docs/webinars/media/automatic-recording-63","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                             |                                                                      |\n| --------------------------- | -------------------------------------------------------------------- |\n| **What you can do with it** | Use it as a replay, or pick it as the video for an evergreen webinar |","table":"table-0"},"7754":{"id":"/product-docs/webinars/media/automatic-recording-64","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|             |                                                                      |\n| ----------- | -------------------------------------------------------------------- |\n| **Storage** | Recordings are hosted in your Library and use your storage allowance |","table":"table-0"},"7755":{"id":"/product-docs/webinars/media/automatic-recording-65","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"|                          |                                                                           |\n| ------------------------ | ------------------------------------------------------------------------- |\n| **Not in the recording** | Drawings on a shared screen, and an attendee zooming in on what you share |","table":"table-0"},"7756":{"id":"/product-docs/webinars/media/automatic-recording-66","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#at-a-glance","content":"Run a live webinar: the full guide to the live room, from the green room to **End Session**."},"7757":{"id":"/product-docs/webinars/media/automatic-recording-67","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-it-is","content":"Picture the last ten minutes before a live session. Your slides are open, a co-host is waiting backstage, and you suddenly wonder whether anyone pressed record. In EasyWebinar you don't have to press anything: Auto Recording captures the live session you host, and the result appears in your Library when the session is over."},"7758":{"id":"/product-docs/webinars/media/automatic-recording-68","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-it-is","content":"Automatic recording is a setting of the live room. It stays on unless you switch it off, so each live webinar you run produces a recording you can find, name and reuse. The recording is the raw material for everything that comes after the live hour: the replay for people who missed it, and the content of an evergreen version."},"7759":{"id":"/product-docs/webinars/media/automatic-recording-69","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-you-see","content":"You see the recording status before you broadcast anything. When you enter the room you land in the green room, where nothing reaches your audience. Its header shows **Not Live** and whether recording is on."},"7760":{"id":"/product-docs/webinars/media/automatic-recording-70","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-you-see","content":"Check the status area at the top first: it confirms recording is on while nothing is being broadcast yet."},"7761":{"id":"/product-docs/webinars/media/automatic-recording-71","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-you-see","content":"Read the header in two moments. Before you start it says **Auto Recording Enabled**. Once you click **Go Live**, the badge changes to **Recording**, and the header also shows **LIVE** with a timer."},"7762":{"id":"/product-docs/webinars/media/automatic-recording-72","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-its-for","content":"Recording a webinar gives you a copy of the live session without anyone having to remember to start it. That copy is what you send to people who missed the hour, and what an evergreen version plays later."},"7763":{"id":"/product-docs/webinars/media/automatic-recording-73","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#how-it-helps","content":"**Nothing to remember:** recording is on by default, so a busy start can't cost you the session."},"7764":{"id":"/product-docs/webinars/media/automatic-recording-74","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#how-it-helps","content":"**A visible check:** the header says **Auto Recording Enabled** before you start and **Recording** once you're live."},"7765":{"id":"/product-docs/webinars/media/automatic-recording-75","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#how-it-helps","content":"**One place to look:** every finished session lands in **Library** → **Recordings** with its webinar's name, duration and date."},"7766":{"id":"/product-docs/webinars/media/automatic-recording-76","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#how-it-helps","content":"**Reuse without exporting:** pick the recording as an evergreen webinar's video straight from the Library."},"7767":{"id":"/product-docs/webinars/media/automatic-recording-77","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#without-it","content":"Without a recording, the live hour is all you get. Registrants who couldn't attend have nothing to watch, and the talk you prepared can't run again unless you present it again. The replay is usually watched by more people than the live session, so losing it loses most of the audience."},"7768":{"id":"/product-docs/webinars/media/automatic-recording-78","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#why-buyers-care","content":"It falls to whoever hosts or produces the session, usually in the minutes before going live. It matters most to anyone who sells from a replay or turns a good live session into an evergreen one. A course creator opening enrolment is a typical case."},"7769":{"id":"/product-docs/webinars/media/automatic-recording-79","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#approach","content":"Take a typical case. A course creator sells a self-paced bookkeeping course for freelancers and runs a free live workshop on the first Monday of each month. About a third of registrants attend live, and the rest ask for the replay the next morning. She presents alone, so she watches the chat, the clock and her slides at once."},"7770":{"id":"/product-docs/webinars/media/automatic-recording-80","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#approach","content":"The usual workaround is to start a separate screen recorder on the laptop just before going live. It tends to work until the morning it doesn't. The recorder was never started, or the microphone wasn't selected. Even when it works, the file sits on one laptop until someone uploads it."},"7771":{"id":"/product-docs/webinars/media/automatic-recording-81","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#approach","content":"The plain logic is that a recording matters only if it exists when the session ends. A setting that is on until you turn it off is safer than a button you have to remember under pressure. The copy is also more useful when it lands where the replay and the next webinar are built."},"7772":{"id":"/product-docs/webinars/media/automatic-recording-82","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#approach","content":"EasyWebinar records the live session you host by default. It shows the recording state in the room header before you broadcast anything. It then saves the finished session to your Library under **Recordings**, named after its webinar. From there you can use it as the replay or pick it as the video for an evergreen webinar."},"7773":{"id":"/product-docs/webinars/media/automatic-recording-83","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#approach","content":"In the green room, the header reads **Auto Recording Enabled** before you click **Go Live**, and **Recording** afterwards. How that compares with other platforms is covered in How EasyWebinar compares for webinar recording, below."},"7774":{"id":"/product-docs/webinars/media/automatic-recording-84","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#how-recording-works","content":"There are three common ways a webinar gets recorded. Each one catches some failures and misses others, which is why the default matters."},"7775":{"id":"/product-docs/webinars/media/automatic-recording-85","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#platform-automatic","content":"The platform captures the session from its own side, without a button press. It catches the most common failure, which is forgetting to start. It also keeps the copy next to the webinar, so reusing it needs no upload. What it can miss is anything the platform doesn't include in its recording, so you still need to know what that is."},"7776":{"id":"/product-docs/webinars/media/automatic-recording-86","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#started-by-hand","content":"Some setups ask the host to press record once the session begins. It gives control over the start and end, but it fails quietly when nobody presses the button. The first minutes are often the ones lost, because that's when the host is busiest."},"7777":{"id":"/product-docs/webinars/media/automatic-recording-87","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#screen-recorder","content":"A recorder on your computer or phone captures whatever is on your screen and the audio you choose. It works for any session you can see, but it records only your view. It depends on you starting it, choosing the right audio and keeping the device awake. The file stays on that device until you move it."},"7778":{"id":"/product-docs/webinars/media/automatic-recording-88","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#confirmed-for-easywebinar","content":"For live webinars you run in EasyWebinar, the confirmed method is the first one. Auto Recording is on by default, its state shows in the room header, and recorded sessions land in **Library** → **Recordings**. Two things are confirmed as never in the recording: drawings on a shared screen, and an attendee zooming in on a shared screen or file."},"7779":{"id":"/product-docs/webinars/media/automatic-recording-89","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"The check takes seconds, and the green room is the place to do it, because nothing there is broadcast."},"7780":{"id":"/product-docs/webinars/media/automatic-recording-90","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"From the webinar's Overview, click **Enter Room**."},"7781":{"id":"/product-docs/webinars/media/automatic-recording-91","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"Pick your camera, microphone and speakers, then click **Continue to Green Room**. The button stays greyed out until the room can see a working camera and microphone."},"7782":{"id":"/product-docs/webinars/media/automatic-recording-92","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"Look at the header. It should read **Not Live** and **Auto Recording Enabled**."},"7783":{"id":"/product-docs/webinars/media/automatic-recording-93","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"If it doesn't, open **Settings** → **Recording Settings** and switch recording on."},"7784":{"id":"/product-docs/webinars/media/automatic-recording-94","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"Get your offers and polls ready, because the **Go Live** confirmation reminds you to."},"7785":{"id":"/product-docs/webinars/media/automatic-recording-95","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#before-you-go-live","content":"If the room won't let you in at step 2, the camera or microphone isn't being detected. The fix is in Camera not detected."},"7786":{"id":"/product-docs/webinars/media/automatic-recording-96","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-it-leaves-out","content":"Two things that attendees see live never reach the recording, so plan your session around them."},"7787":{"id":"/product-docs/webinars/media/automatic-recording-97","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#drawings","content":"If you draw on a screen or slides you're sharing, attendees see the drawings live. They are removed when you stop sharing, and they are not in the recording. If a diagram matters to replay viewers, put it on the slide itself rather than drawing it during the session."},"7788":{"id":"/product-docs/webinars/media/automatic-recording-98","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#attendee-zoom-in","content":"Attendees can zoom in on a shared screen or file to read small text. The recorder doesn't turn zoom on, so recordings never include it. So make small text large enough for replay viewers to read as it is."},"7789":{"id":"/product-docs/webinars/media/automatic-recording-99","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#tell-people","content":"A recording captures your presenters and anything they share. In the UK, data protection legislation controls how organisations use personal information, so say at the start that the session is recorded. Tell guest presenters before they join the stage."},"7790":{"id":"/product-docs/webinars/media/automatic-recording-100","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#measuring-recording","content":"You can't watch every recording end to end, so check two things that tell you most of what you need."},"7791":{"id":"/product-docs/webinars/media/automatic-recording-101","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#duration-check","content":"Before you click **End Session**, note the **LIVE** timer in the header. Afterwards, find the session in **Library** → **Recordings**, where each card shows its duration. A recording far shorter than the time you were live is worth opening before you send the replay link."},"7792":{"id":"/product-docs/webinars/media/automatic-recording-102","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#duration-check","content":"Its weak spot is that duration tells you length, not content. A recording can be the right length and still lack the drawings and the zoomed views described above."},"7793":{"id":"/product-docs/webinars/media/automatic-recording-103","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#card-for-every-session","content":"Each recording is named after its webinar and dated. If you ran a session and there is no card with that webinar's name and date, recording was off. Check **Recording Settings** before your next session."},"7794":{"id":"/product-docs/webinars/media/automatic-recording-104","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#card-for-every-session","content":"Its weak spot is that a webinar run several times has several recordings with the same name. Use the date on each card to match it to the session."},"7795":{"id":"/product-docs/webinars/media/automatic-recording-105","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#card-for-every-session","content":"For audience numbers once the replay is out, use Webinar analytics."},"7796":{"id":"/product-docs/webinars/media/automatic-recording-106","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"If you need a copy of a session you're watching or presenting outside EasyWebinar, a screen recorder on your own device is the general method. This records only what is on your screen. On a Chromebook, for example:"},"7797":{"id":"/product-docs/webinars/media/automatic-recording-107","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"Open the session in a window on its own, and close notifications you don't want captured."},"7798":{"id":"/product-docs/webinars/media/automatic-recording-108","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"Press **Shift + Ctrl + Show windows**, then choose **Screen record**."},"7799":{"id":"/product-docs/webinars/media/automatic-recording-109","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"Choose whether to record the full screen, part of it, or one window."},"7800":{"id":"/product-docs/webinars/media/automatic-recording-110","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"Open **Settings** and select **Device audio and microphone** if you need both the session audio and your voice."},"7801":{"id":"/product-docs/webinars/media/automatic-recording-111","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"Start recording, and keep the device awake and plugged in for the whole session."},"7802":{"id":"/product-docs/webinars/media/automatic-recording-112","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"When the session ends, select **Stop recording**."},"7803":{"id":"/product-docs/webinars/media/automatic-recording-113","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"Find the file. Chromebook recordings save to the Downloads folder unless you choose another folder."},"7804":{"id":"/product-docs/webinars/media/automatic-recording-114","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"On an Android phone, the Screen record tile in Quick Settings does the same job, and recordings appear in the Photos app."},"7805":{"id":"/product-docs/webinars/media/automatic-recording-115","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#manual-method","content":"What this misses: you have to remember to start it, the audio depends on your choices, and the file stays on your device until you move it."},"7806":{"id":"/product-docs/webinars/media/automatic-recording-116","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#same-job-in-easywebinar","content":"For a live webinar you run in EasyWebinar, you skip steps 2 to 7. You check that the header reads **Auto Recording Enabled**, go live, and find the session in **Library** → **Recordings** afterwards. If you do have a video file of your own, **Add Media** → **Local import** uploads it to the Library, where EasyWebinar hosts it like any other video. Video hosting covers that."},"7807":{"id":"/product-docs/webinars/media/automatic-recording-117","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#worked-example","content":"This is an illustrative calculation with sample figures, not an EasyWebinar output. A host checks three monthly sessions by comparing time live with the duration shown on each recording card."},"7808":{"id":"/product-docs/webinars/media/automatic-recording-118","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#worked-example","content":"| Session | Went live | Ended | Time live (end minus start) | Duration on the card | Result                    |\n| ------- | --------- | ----- | --------------------------- | -------------------- | ------------------------- |\n| January | 19:00     | 20:05 | 65 minutes                  | 64 minutes           | Complete, send the replay |","table":"table-1"},"7809":{"id":"/product-docs/webinars/media/automatic-recording-119","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#worked-example","content":"| Session  | Went live | Ended | Time live (end minus start) | Duration on the card | Result                                   |\n| -------- | --------- | ----- | --------------------------- | -------------------- | ---------------------------------------- |\n| February | 19:00     | 20:10 | 70 minutes                  | 22 minutes           | 48 minutes short, open it before sending |","table":"table-1"},"7810":{"id":"/product-docs/webinars/media/automatic-recording-120","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#worked-example","content":"| Session | Went live | Ended | Time live (end minus start) | Duration on the card | Result                                          |\n| ------- | --------- | ----- | --------------------------- | -------------------- | ----------------------------------------------- |\n| March   | 19:00     | 19:55 | 55 minutes                  | No card              | Recording was off, check **Recording Settings** |","table":"table-1"},"7811":{"id":"/product-docs/webinars/media/automatic-recording-121","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#worked-example","content":"January passes the check. February is short by 70 minus 22, which is 48 minutes, so the host watches the end before sharing it. March has no card at all, so the fix is in the room's settings before the April session."},"7812":{"id":"/product-docs/webinars/media/automatic-recording-122","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"Recording needs no separate setup when you leave the default alone. The steps below are what to check and where to look."},"7813":{"id":"/product-docs/webinars/media/automatic-recording-123","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"Open the room and confirm the header reads **Auto Recording Enabled**."},"7814":{"id":"/product-docs/webinars/media/automatic-recording-124","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"If you need to change it, open **Settings** → **Recording Settings**."},"7815":{"id":"/product-docs/webinars/media/automatic-recording-125","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"Click **Go Live** and confirm. The badge changes to **Recording**."},"7816":{"id":"/product-docs/webinars/media/automatic-recording-126","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"Present, then click **End Session** and confirm."},"7817":{"id":"/product-docs/webinars/media/automatic-recording-127","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"Open **Library** → **Recordings** and find the session by its webinar's name and date."},"7818":{"id":"/product-docs/webinars/media/automatic-recording-128","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#set-up","content":"Use it as a replay, or pick it as an evergreen webinar's video."},"7819":{"id":"/product-docs/webinars/media/automatic-recording-129","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#what-to-have-ready","content":"You need a scheduled live webinar, which Create and schedule a live webinar walks through. You also need a working camera and microphone to enter the room, even if you turn them off afterwards."},"7820":{"id":"/product-docs/webinars/media/automatic-recording-130","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#recording-settings","content":"In the live room, click **Settings**, then **Recording Settings**. The settings dialog also holds your device settings and room preferences such as chat and Q&A moderation."},"7821":{"id":"/product-docs/webinars/media/automatic-recording-131","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#recording-settings","content":"Recording Settings sits beside your devices, so check both in the green room before you broadcast anything."},"7822":{"id":"/product-docs/webinars/media/automatic-recording-132","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#recording-settings","content":"Leave recording on unless you have a reason not to. The replay is usually watched by more people than the live session."},"7823":{"id":"/product-docs/webinars/media/automatic-recording-133","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#go-live-and-end","content":"**Go Live** asks you to confirm and tells you anyone in the waiting area will be moved in. The header then shows **LIVE** with a timer, and **Go Live** becomes **End Session**. **End Session** disconnects everyone and nobody can rejoin, so it asks you to confirm."},"7824":{"id":"/product-docs/webinars/media/automatic-recording-134","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#find-the-recording","content":"Click **Library** in the sidebar, then the **Recordings** tab. Each recording is named after its webinar, with its duration and the date it was recorded. Your storage is shown at the top of the tab."},"7825":{"id":"/product-docs/webinars/media/automatic-recording-135","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#find-the-recording","content":"Every live session you record lands on this tab, so match the card's name and date to the session you ran."},"7826":{"id":"/product-docs/webinars/media/automatic-recording-136","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#find-the-recording","content":"The Library page explains the other tabs and how storage is counted."},"7827":{"id":"/product-docs/webinars/media/automatic-recording-137","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#find-the-recording","content":"This EasyWebinar video shows the Library, where you can also upload your own webinar videos."},"7828":{"id":"/product-docs/webinars/media/automatic-recording-138","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#reuse-the-recording","content":"There are two main reuses. As a replay, the recording serves people who missed the live hour, set up through Replay pages. As an evergreen webinar, clone the webinar as Evergreen and pick the recording when you choose the video."},"7829":{"id":"/product-docs/webinars/media/automatic-recording-139","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#reuse-the-recording","content":"Choosing the video for an evergreen webinar is where a past live recording becomes its content."},"7830":{"id":"/product-docs/webinars/media/automatic-recording-140","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#reuse-the-recording","content":"Recordings also appear on the **Recordings** tab of the video picker during webinar setup, so you pick it where you pick any other video. Create an evergreen webinar covers the rest of that setup."},"7831":{"id":"/product-docs/webinars/media/automatic-recording-141","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#reuse-the-recording","content":"This EasyWebinar video shows how to set up a replay that expires."},"7832":{"id":"/product-docs/webinars/media/automatic-recording-142","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#works-with","content":"**The live room:** recording state shows in the header, and the setting sits under **Settings** in the live room."},"7833":{"id":"/product-docs/webinars/media/automatic-recording-143","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#works-with","content":"**The Library:** finished sessions land on its **Recordings** tab, next to your videos, images and files."},"7834":{"id":"/product-docs/webinars/media/automatic-recording-144","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#works-with","content":"**Replays:** a recording becomes the replay for people who missed the session, through replay pages."},"7835":{"id":"/product-docs/webinars/media/automatic-recording-145","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#works-with","content":"**Evergreen and simulive webinars:** both take their content from the Library. Create a simulive webinar and Create an evergreen webinar show where you choose it."},"7836":{"id":"/product-docs/webinars/media/automatic-recording-146","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#works-with","content":"**Storage:** recordings are hosted in the Library and count towards your allowance. Extra space is an add-on, listed on pricing."},"7837":{"id":"/product-docs/webinars/media/automatic-recording-147","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#who-course-creators","content":"A course creator who opens enrolment with a monthly live workshop needs the replay by the next morning. Recording is on before she starts, and the session is ready in the Library to share. The Selling online courses with webinars guide covers the rest of that launch."},"7838":{"id":"/product-docs/webinars/media/automatic-recording-148","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#who-coaches","content":"A coach who runs one strong live session can turn it into an evergreen version that plays on a schedule. The recording is the starting point, picked straight from the Library during setup."},"7839":{"id":"/product-docs/webinars/media/automatic-recording-149","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#who-saas","content":"A product team running a live release walkthrough wants a copy for customers in other time zones. They check the header in the green room, go live, and point latecomers to the replay. On Demand covers letting people watch straight after registering."},"7840":{"id":"/product-docs/webinars/media/automatic-recording-150","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#who-customer-success","content":"A customer success team running live training wants each session kept with the webinar it came from. Each recording carries its webinar's name and date, so the team can find last quarter's session quickly."},"7841":{"id":"/product-docs/webinars/media/automatic-recording-151","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"EasyWebinar records each live session you host by default, keeps the result on a **Recordings** tab in the Library, and lets you pick it as an evergreen webinar's video. The recording state is visible in the room header before you broadcast anything."},"7842":{"id":"/product-docs/webinars/media/automatic-recording-152","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"Webinar recording features, from each platform's public documentation:"},"7843":{"id":"/product-docs/webinars/media/automatic-recording-153","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"| Platform        | Live sessions recorded automatically | Past live recording as an automated webinar's video | Recordings on their own library tab |\n| --------------- | ------------------------------------ | --------------------------------------------------- | ----------------------------------- |\n| **EasyWebinar** | Yes                                  | Yes                                                 | Yes                                 |","table":"table-2"},"7844":{"id":"/product-docs/webinars/media/automatic-recording-154","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"| Platform  | Live sessions recorded automatically | Past live recording as an automated webinar's video | Recordings on their own library tab     |\n| --------- | ------------------------------------ | --------------------------------------------------- | --------------------------------------- |\n| **Demio** | Yes                                  | Yes (Automated Event from past Sessions)            | Partly (Schedule page, All Past filter) |","table":"table-2"},"7845":{"id":"/product-docs/webinars/media/automatic-recording-155","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"| Platform       | Live sessions recorded automatically | Past live recording as an automated webinar's video | Recordings on their own library tab  |\n| -------------- | ------------------------------------ | --------------------------------------------------- | ------------------------------------ |\n| **WebinarKit** | Yes (records all live sessions)      | Yes (past session as video source)                  | Partly (recordings page per webinar) |","table":"table-2"},"7846":{"id":"/product-docs/webinars/media/automatic-recording-156","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"| Platform         | Live sessions recorded automatically | Past live recording as an automated webinar's video | Recordings on their own library tab          |\n| ---------------- | ------------------------------------ | --------------------------------------------------- | -------------------------------------------- |\n| **WebinarNinja** | Yes (broadcast starts the recording) | Yes (recording from past live webinars)             | Partly (past recordings in a Replays picker) |","table":"table-2"},"7847":{"id":"/product-docs/webinars/media/automatic-recording-157","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"| Platform           | Live sessions recorded automatically | Past live recording as an automated webinar's video | Recordings on their own library tab       |\n| ------------------ | ------------------------------------ | --------------------------------------------------- | ----------------------------------------- |\n| **StealthSeminar** | Records at your streaming provider   | Partly (you upload the recording yourself)          | Partly (videos you upload to its library) |","table":"table-2"},"7848":{"id":"/product-docs/webinars/media/automatic-recording-158","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"| Platform      | Live sessions recorded automatically | Past live recording as an automated webinar's video | Recordings on their own library tab |\n| ------------- | ------------------------------------ | --------------------------------------------------- | ----------------------------------- |\n| **Livestorm** | Yes (records when the event starts)  | Yes (recording used for an on-demand event)         | Not in docs                         |","table":"table-2"},"7849":{"id":"/product-docs/webinars/media/automatic-recording-159","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"7850":{"id":"/product-docs/webinars/media/automatic-recording-160","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare-stronger","content":"**Recording is built into the room.** EasyWebinar records the live session you host by default, while StealthSeminar documents that you record the live event at your streaming provider and upload it. EasyWebinar vs StealthSeminar."},"7851":{"id":"/product-docs/webinars/media/automatic-recording-161","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare-stronger","content":"**Recordings have their own tab.** EasyWebinar lists them under **Library** → **Recordings**, while Demio reaches them by filtering the Schedule page to All Past. EasyWebinar vs Demio."},"7852":{"id":"/product-docs/webinars/media/automatic-recording-162","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare-stronger","content":"**One recording, two reuses.** EasyWebinar offers the recording as a replay and as an evergreen webinar's video, and WebinarNinja shows past recordings in a Replays picker when you add a video. EasyWebinar vs WebinarNinja."},"7853":{"id":"/product-docs/webinars/media/automatic-recording-163","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 4 November 2026. Features and plans change, so confirm with the vendor before you decide.*"},"7854":{"id":"/product-docs/webinars/media/automatic-recording-164","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#limits","content":"**Live sessions you host in EasyWebinar.** Automatic recording applies to the live room. This page covers no other kind of session."},"7855":{"id":"/product-docs/webinars/media/automatic-recording-165","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#limits","content":"**Drawings stay out.** Drawings on a shared screen or slides are removed when you stop sharing and are not in the recording."},"7856":{"id":"/product-docs/webinars/media/automatic-recording-166","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#limits","content":"**Attendee zoom stays out.** An attendee zooming in on a shared screen or file isn't captured, because the recorder doesn't turn zoom on."},"7857":{"id":"/product-docs/webinars/media/automatic-recording-167","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#limits","content":"**Storage.** Recordings are hosted in the Library and count towards your storage allowance."},"7858":{"id":"/product-docs/webinars/media/automatic-recording-168","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#limits","content":"**Ending is final.** **End Session** disconnects everyone and nobody can rejoin, so end only when you're done."},"7859":{"id":"/product-docs/webinars/media/automatic-recording-169","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-automatic","content":"Yes, for live webinars you run in EasyWebinar. Auto Recording is on by default, and the room header shows **Auto Recording Enabled** before you go live."},"7860":{"id":"/product-docs/webinars/media/automatic-recording-170","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-running","content":"Once you click **Go Live**, the header badge changes from **Auto Recording Enabled** to **Recording**. The header also shows **LIVE** with a timer."},"7861":{"id":"/product-docs/webinars/media/automatic-recording-171","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-where","content":"Click **Library** in the sidebar, then the **Recordings** tab. Each recording is named after its webinar and shows its duration and the date it was recorded."},"7862":{"id":"/product-docs/webinars/media/automatic-recording-172","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-evergreen","content":"Yes. Clone the webinar as Evergreen, then pick the recording when you choose the video. Recordings also appear on the **Recordings** tab of the video picker during setup."},"7863":{"id":"/product-docs/webinars/media/automatic-recording-173","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-replay","content":"Yes. A recorded live session is the replay for registrants who missed it, and the replay is usually watched by more people than the live session."},"7864":{"id":"/product-docs/webinars/media/automatic-recording-174","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-turn-off","content":"In the live room, open **Settings** → **Recording Settings** and switch recording off before you go live. Leave it on unless you have a reason not to."},"7865":{"id":"/product-docs/webinars/media/automatic-recording-175","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-storage","content":"Yes. Recordings are hosted in your Library and count towards your storage allowance, which is shown at the top of every Library tab. Extra space is an add-on."},"7866":{"id":"/product-docs/webinars/media/automatic-recording-176","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-drawings","content":"No. Drawings on a shared screen or slides are removed when you stop sharing and are not in the recording. Put diagrams on the slide itself."},"7867":{"id":"/product-docs/webinars/media/automatic-recording-177","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-zoom-in","content":"No. The recorder doesn't turn zoom on, so recordings never include it. Make small text on your share large enough to read as it is."},"7868":{"id":"/product-docs/webinars/media/automatic-recording-178","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-camera","content":"You need both to enter the live room, where recording happens, even if you turn them off afterwards. The **Continue to Green Room** button stays greyed out until the room detects them."},"7869":{"id":"/product-docs/webinars/media/automatic-recording-179","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-elsewhere","content":"This page covers webinars you run in EasyWebinar. For a session hosted elsewhere, the general method is a screen recorder on your own device, which records only your screen."},"7870":{"id":"/product-docs/webinars/media/automatic-recording-180","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-complete","content":"Note the **LIVE** timer before you click **End Session**, then compare it with the duration on the recording's card. A much shorter recording is worth opening before you share it."},"7871":{"id":"/product-docs/webinars/media/automatic-recording-181","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#faq-several","content":"Each recording carries its webinar's name and the date it was recorded. Match the date to the session you want."},"7872":{"id":"/product-docs/webinars/media/automatic-recording-182","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#further-reading","content":"Take a screenshot or record your screen (Chromebook Help): the screen recorder steps, audio choices and where recordings are saved."},"7873":{"id":"/product-docs/webinars/media/automatic-recording-183","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#further-reading","content":"Record your screen on your Android device (Android Help): starting and stopping a phone screen recording and finding the file."},"7874":{"id":"/product-docs/webinars/media/automatic-recording-184","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#further-reading","content":"Data protection (GOV.UK): the UK rules on how organisations use personal information, including recordings of people."},"7875":{"id":"/product-docs/webinars/media/automatic-recording-185","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"The green room and backstage: where you check the recording state before you broadcast."},"7876":{"id":"/product-docs/webinars/media/automatic-recording-186","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"The Library: every tab, and how storage is counted."},"7877":{"id":"/product-docs/webinars/media/automatic-recording-187","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"Clone a webinar: copy a live webinar as the start of an evergreen one."},"7878":{"id":"/product-docs/webinars/media/automatic-recording-188","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"Video hosting: upload or import videos beside your recordings."},"7879":{"id":"/product-docs/webinars/media/automatic-recording-189","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"Webinar follow-up emails: what to send attendees and no-shows once the recording is ready."},"7880":{"id":"/product-docs/webinars/media/automatic-recording-190","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"How to record a webinar step by step: the step-by-step guide on our blog."},"7881":{"id":"/product-docs/webinars/media/automatic-recording-191","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"Webinars overview: every webinar type and where recording fits."},"7882":{"id":"/product-docs/webinars/media/automatic-recording-192","page_id":"/product-docs/webinars/media/automatic-recording","tags":[],"type":"text","url":"/product-docs/webinars/media/automatic-recording#related","content":"*Updated 4 November 2026: added how webinars get recorded, what the recording leaves out, how to check a recording is complete, the screen recorder method and a worked example.*"},"7883":{"id":"/product-docs/webinars/media/library","page_id":"/product-docs/webinars/media/library","type":"page","content":"The Library","breadcrumbs":["EasyWebinar documentation","Webinars","Videos, recordings and replays"],"tags":[],"url":"/product-docs/webinars/media/library"},"7884":{"id":"/product-docs/webinars/media/library-0","page_id":"/product-docs/webinars/media/library","tags":[],"type":"text","url":"/product-docs/webinars/media/library","content":"Find, add and manage the videos, webinar recordings, images and documents your webinars use, see which files count towards your storage, and put a library video to work in a simulive or evergreen webinar."},"7885":{"id":"/product-