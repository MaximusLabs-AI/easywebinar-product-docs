"Replays and the Library"},"7343":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-25","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#with-cloning","content":"Evergreen from a live session"},"7344":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-26","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#with-easycast","content":"EasyCast"},"7345":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-27","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#who-uses-it","content":"Who runs live webinars, and how"},"7346":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-28","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#coaches","content":"Coaches and consultants"},"7347":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-29","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#product-teams","content":"SaaS and product teams"},"7348":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-30","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#b2b-marketing","content":"B2B marketing teams"},"7349":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-31","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#course-creators","content":"Course creators"},"7350":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-32","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"How the live room compares"},"7351":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-33","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#compare-stronger","content":"Why EasyWebinar is the stronger choice for the live room"},"7352":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-34","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"Limits and things to know"},"7353":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-35","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#common-questions","content":"Common questions"},"7354":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-36","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-green-room-broadcast","content":"Is anything broadcast while I'm in the green room?"},"7355":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-37","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-greyed-out","content":"Why is Continue to Green Room greyed out?"},"7356":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-38","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-camera-off","content":"Can I go live with my camera off?"},"7357":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-39","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-recorded","content":"Is my webinar recorded automatically?"},"7358":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-40","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-recording-location","content":"Where does the recording go?"},"7359":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-41","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-polls-manual","content":"Do polls appear on their own during a live webinar?"},"7360":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-42","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-share-screen","content":"Can I share my screen?"},"7361":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-43","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-stop-chat","content":"Can I stop attendees chatting with each other?"},"7362":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-44","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-waiting-area","content":"What happens to people waiting when I go live?"},"7363":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-45","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-rejoin","content":"Can I restart a session after ending it?"},"7364":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-46","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-one-live","content":"Why can't I enter the room for a second webinar?"},"7365":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-47","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/run-a-live-webinar#related","content":"Related"},"7366":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-48","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar","content":"To run a live webinar in EasyWebinar, you open the webinar room from the webinar's **Overview**, pass a quick camera and microphone check, and arrive in the green room, where nothing reaches your audience. When you're ready you click **Go Live**, present using the panels on the right-hand rail, and finish with **End Session**. The result is a broadcast to everyone registered for the session, with the recording saved to **Library → Recordings** if recording was on."},"7367":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-49","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                     |                                                                                                            |\n| ------------------- | ---------------------------------------------------------------------------------------------------------- |\n| **Where you start** | The webinar's **Overview** → **Enter Room**, or **Go Live** in the **⋮** menu on a card in **My Webinars** |","table":"table-0"},"7368":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-50","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                             |                                                                             |\n| --------------------------- | --------------------------------------------------------------------------- |\n| **What you need to get in** | A working camera and microphone. You can switch both off once you're inside |","table":"table-0"},"7369":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-51","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                          |                                                                                |\n| ------------------------ | ------------------------------------------------------------------------------ |\n| **Before you broadcast** | The green room. The header reads **Not Live** and nothing is sent to attendees |","table":"table-0"},"7370":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-52","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|               |                                                                                                   |\n| ------------- | ------------------------------------------------------------------------------------------------- |\n| **Recording** | Shown as **Auto Recording Enabled** in the header; change it in **Settings → Recording Settings** |","table":"table-0"},"7371":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-53","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                       |                                                                                     |\n| --------------------- | ----------------------------------------------------------------------------------- |\n| **Panels while live** | **Chat**, **People**, **Offers**, **Polls**, **Question**, **Design** and **Theme** |","table":"table-0"},"7372":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-54","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                      |                                                                                               |\n| -------------------- | --------------------------------------------------------------------------------------------- |\n| **Top-bar controls** | **Settings**, **Reactions**, **EasyCast**, **Full Screen**, **Camera**, **Mic** and **Share** |","table":"table-0"},"7373":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-55","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                         |                                                                                                           |\n| ----------------------- | --------------------------------------------------------------------------------------------------------- |\n| **Streaming elsewhere** | EasyCast sends the session to YouTube, LinkedIn, LinkedIn Organisation pages and custom RTMP destinations |","table":"table-0"},"7374":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-56","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|            |                                                             |\n| ---------- | ----------------------------------------------------------- |\n| **Ending** | **End Session** disconnects everyone, and nobody can rejoin |","table":"table-0"},"7375":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-57","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#at-a-glance","content":"|                   |                                             |\n| ----------------- | ------------------------------------------- |\n| **One at a time** | Only one of your events can be live at once |","table":"table-0"},"7376":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-58","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#before-you-begin","content":"**Be signed in as a team member.** Any team member signed in to EasyWebinar can open the room. To bring in a co-presenter or moderator, see The green room and backstage."},"7377":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-59","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#before-you-begin","content":"**Check your camera and microphone.** The room won't let you past the device check without both."},"7378":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-60","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#before-you-begin","content":"**Set chat, Q&A and the attendee list in advance.** Who can see chat messages and how Q&A works are chosen on the webinar's **Engagement** tab. Whether attendees can see each other is **Show Attendees** on the **Settings** tab. These belong to the webinar's setup, not the live room, so decide them before the session."},"7379":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-61","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#before-you-begin","content":"**Build your polls and offers.** Create polls and offers on the **CTAs** tab. You can keep an offer switched off in the list until you want it."},"7380":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-62","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#before-you-begin","content":"**Fill in End of Session.** On the **Settings** tab, **End of Session** is where attendees go when the stream ends. It's empty by default, which leaves attendees on a finished webinar."},"7381":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-63","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#before-you-begin","content":"**Connect any streaming destinations.** If you plan to stream to YouTube or LinkedIn as well, connect them once under **Integrations → EasyCast** in the sidebar."},"7382":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-64","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#open-the-room","content":"Open the webinar. It opens on **Overview**."},"7383":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-65","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#open-the-room","content":"Click **Enter Room** at the top right."},"7384":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-66","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#open-the-room","content":"You can also click **⋮** on the webinar's card in **My Webinars** and choose **Go Live**, which takes you into the same room."},"7385":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-67","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#device-check","content":"You're asked to choose your **camera, microphone and speakers**. Pick each one, then click **Continue to Green Room**."},"7386":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-68","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#device-check","content":"The button stays greyed out until the room can see a camera and a microphone. If it can't open your camera, you'll see **\"Not able to access selected media device\"**. Allow camera access in your browser and close any other app that's using the camera. Camera not detected walks through the fixes."},"7387":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-69","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#device-check","content":"If another of your webinars is already live, **Enter Room** shows **\"You can only have one event live at a time.\"** Join the session that's running, or go live with the new one."},"7388":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-70","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#get-ready","content":"The green room is the room as it will look, with nothing broadcast. Check your framing, test **Share**, and get your co-hosts in place."},"7389":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-71","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#get-ready","content":"*The green room: 1 Status · 2 Settings, Reactions, EasyCast and Full Screen · 3 Camera, Mic and Share · 4 Go Live and Exit · 5 Backstage · 6 Side rail · 7 Layout.*"},"7390":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-72","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#get-ready","content":"Anyone who joins as a co-host or moderator lands in **Backstage**, not on stage. The green room page covers backstage, the People panel and presenter links in detail."},"7391":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-73","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#check-recording","content":"Look at the badge in the header. **Auto Recording Enabled** means the session will be recorded. To change it, click **Settings** in the top bar, then **Recording Settings**."},"7392":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-74","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#check-recording","content":"|     | Section             | What it covers              |\n| --- | ------------------- | --------------------------- |\n| 1   | **Device settings** | Camera, audio and recording |","table":"table-1"},"7393":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-75","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#check-recording","content":"|     | Section                | What it covers                  |\n| --- | ---------------------- | ------------------------------- |\n| 2   | **Recording Settings** | Whether the session is recorded |","table":"table-1"},"7394":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-76","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#check-recording","content":"|     | Section         | What it covers                                 |\n| --- | --------------- | ---------------------------------------------- |\n| 3   | **Preferences** | Chat moderation, Q&A moderation and appearance |","table":"table-1"},"7395":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-77","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#check-recording","content":"Keep recording on unless you have a specific reason to switch it off. The replay usually reaches more people than the live session does, and a recording is what you'd use to turn this webinar into an evergreen one later."},"7396":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-78","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"Click **Design** on the right-hand rail. Do this now: design changes apply immediately, so anything you change once you're live happens in front of your audience."},"7397":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-79","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control           | What to do with it                                                                           |\n| --- | ----------------- | -------------------------------------------------------------------------------------------- |\n| 1   | **Stage / Frame** | **Stage** styles what sits behind the presenters; **Frame** styles the area around the stage |","table":"table-2"},"7398":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-80","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control                | What to do with it                                            |\n| --- | ---------------------- | ------------------------------------------------------------- |\n| 2   | **Background presets** | Pick a supplied background, or **+** to upload your own image |","table":"table-2"},"7399":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-81","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control            | What to do with it                                   |\n| --- | ------------------ | ---------------------------------------------------- |\n| 3   | **Blur Intensity** | Starts at 0. Raise it to blur whatever is behind you |","table":"table-2"},"7400":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-82","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control     | What to do with it                     |\n| --- | ----------- | -------------------------------------- |\n| 4   | **Colours** | Use a plain colour instead of an image |","table":"table-2"},"7401":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-83","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control            | What to do with it                                                      |\n| --- | ------------------ | ----------------------------------------------------------------------- |\n| 5   | **Frame Overlays** | A border, logo bar or lower third over the stage, or **+** for your own |","table":"table-2"},"7402":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-84","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control    | What to do with it                                                      |\n| --- | ---------- | ----------------------------------------------------------------------- |\n| 6   | **Layout** | Open **Choose Layout** at the bottom of the stage to arrange presenters |","table":"table-2"},"7403":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-85","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"|     | Control   | What to do with it                                        |\n| --- | --------- | --------------------------------------------------------- |\n| 7   | **Theme** | **Light**, **Dark** or **System**, for your own view only |","table":"table-2"},"7404":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-86","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#style-the-room","content":"Blur is the quickest fix for an untidy room. A frame overlay is where your branding goes, and it carries through to the recording and anything EasyCast streams out. Upload overlays with a transparent background, otherwise they cover the video instead of framing it. Layout matters most with several presenters or a screen share, because it decides whether your slides or your faces take the space."},"7405":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-87","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#switch-on-easycast","content":"If you connected destinations in **Integrations → EasyCast**, click **EasyCast** in the top bar of the room. Switch **Stream** on for each destination you want this session to reach. The pencil beside a destination sets the title and description shown on that platform, so your public stream doesn't carry your internal webinar name. **Connect More Channels** takes you to the Integrations page to add another."},"7406":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-88","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#switch-on-easycast","content":"EasyCast is set up per account, so a destination connected once is available on every webinar. It covers **YouTube**, **LinkedIn**, **LinkedIn Organisation** and **Custom RTMP**."},"7407":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-89","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#go-live","content":"Click **Go Live**. A confirmation asks you to check two things: people in the waiting area will be moved into the webinar automatically, and your offers and polls should already be created. Click **Go Live** in the dialog to start."},"7408":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-90","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#go-live","content":"*Live: 1 LIVE with a timer, and Recording · 2 One icon per EasyCast destination · 3 End Session.*"},"7409":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-91","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#go-live","content":"The header now shows **LIVE** with a timer of how long you've been broadcasting, the recording badge changes to **Recording**, and **Go Live** becomes **End Session**. If you're streaming with EasyCast, a platform icon appears for each destination. Click it to open the stream on that platform and see what viewers there are seeing."},"7410":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-92","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#go-live","content":"You can switch your camera and microphone off with **Camera** and **Mic** and stay live, which suits a session built on slides or a video rather than your face."},"7411":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-93","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"Everything you use while presenting sits on the right-hand rail:"},"7412":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-94","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel    | What you use it for                                         |\n| -------- | ----------------------------------------------------------- |\n| **Chat** | Attendee messages, with **Global Chat** and **Admin Chats** |","table":"table-3"},"7413":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-95","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel      | What you use it for                                          |\n| ---------- | ------------------------------------------------------------ |\n| **People** | Presenters and attendees, and moving people on and off stage |","table":"table-3"},"7414":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-96","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel      | What you use it for          |\n| ---------- | ---------------------------- |\n| **Offers** | Pushing an offer to the room |","table":"table-3"},"7415":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-97","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel     | What you use it for                                              |\n| --------- | ---------------------------------------------------------------- |\n| **Polls** | Launching a poll. On a live webinar you launch each one yourself |","table":"table-3"},"7416":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-98","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel        | What you use it for                                   |\n| ------------ | ----------------------------------------------------- |\n| **Question** | The Q&A queue, split into **Active** and **Answered** |","table":"table-3"},"7417":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-99","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel      | What you use it for              |\n| ---------- | -------------------------------- |\n| **Design** | Backgrounds, overlays and layout |","table":"table-3"},"7418":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-100","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"| Panel     | What you use it for   |\n| --------- | --------------------- |\n| **Theme** | Light, dark or system |","table":"table-3"},"7419":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-101","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"In the top bar, **Share** shares your screen, **Full Screen** expands the stage, and **Reactions** enables emoji reactions from the room."},"7420":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-102","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#present","content":"Polls don't fire on their own in a live session, so plan when each poll goes out. Offers reach the room when you push them from the **Offers** panel. The **Question** panel keeps **Active** and **Answered** apart, so you can see at a glance what's still waiting."},"7421":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-103","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#end-the-session","content":"Click **End Session** and confirm. Ending disconnects everyone in the room, and nobody can rejoin, which is why EasyWebinar asks first. If you were streaming with EasyCast, the broadcast stops on every destination at the same moment."},"7422":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-104","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#end-the-session","content":"Attendees then go to the URL you set in **End of Session**, if you set one."},"7423":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-105","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#verify-the-result","content":"**While live:** the header shows **LIVE** with a running timer and the **Recording** badge. With EasyCast on, there's one platform icon per destination."},"7424":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-106","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#verify-the-result","content":"**Recording:** open **Library → Recordings**. The recording is named after its webinar, with its duration and the date it was recorded."},"7425":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-107","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#verify-the-result","content":"**Session history:** on the webinar's **Overview**, the session moves to the **Past** tab of the **Sessions** panel."},"7426":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-108","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#verify-the-result","content":"**Attendance:** the webinar's **Analytics** tab shows **Live Attended** for people who joined the broadcast. See Webinar analytics."},"7427":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-109","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"The live room is where you present a live webinar. You arrive in a green room where nothing is broadcast, then go live when you're set. The same room holds backstage, chat, polls, offers, questions and the recording controls."},"7428":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-110","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"| Question                                | Live room answer                                                |\n| --------------------------------------- | --------------------------------------------------------------- |\n| Is anything broadcast before you start? | No. The header reads **Not Live** until you confirm **Go Live** |","table":"table-4"},"7429":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-111","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"| Question                | Live room answer                                         |\n| ----------------------- | -------------------------------------------------------- |\n| Where do co-hosts wait? | **Backstage**, out of sight until you move them on stage |","table":"table-4"},"7430":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-112","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"| Question                     | Live room answer         |\n| ---------------------------- | ------------------------ |\n| Where does the recording go? | **Library → Recordings** |","table":"table-4"},"7431":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-113","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"| Question                    | Live room answer                                                        |\n| --------------------------- | ----------------------------------------------------------------------- |\n| Which webinar types use it? | Live webinars. Simulive and evergreen webinars play a recording instead |","table":"table-4"},"7432":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-114","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-it-is","content":"To run a recording at set times without presenting, see Create a simulive webinar."},"7433":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-115","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#what-its-for","content":"The live room is where a live webinar actually happens. Everything you set up beforehand leads to this hour. The room gives you a private place to prepare, a clear start, the tools to engage and sell, and a definite end."},"7434":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-116","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#how-it-helps","content":"**You can prepare in private.** The green room lets you fix audio, lighting and screen sharing with nobody watching."},"7435":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-117","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#how-it-helps","content":"**The start is controlled.** Nothing is broadcast until you confirm **Go Live**, and people in the waiting area are moved in automatically when you do."},"7436":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-118","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#how-it-helps","content":"**Selling happens in the room.** Offers and polls are pushed from the same rail you use for chat and questions."},"7437":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-119","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#how-it-helps","content":"**The recording is automatic.** With recording on, the session lands in your Library without an extra step."},"7438":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-120","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#how-it-helps","content":"**One session can reach more places.** EasyCast sends the same broadcast to YouTube and LinkedIn."},"7439":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-121","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#without-it","content":"Without a staging area, presenters test their microphones in front of the audience, and a co-host's first words are an apology about echo. Without a confirmation step, a webinar can start before the offers exist. Without automatic recording, the replay you planned to send to no-shows may not exist at all."},"7440":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-122","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#why-buyers-care","content":"It matters most to teams whose live session is a public moment: a launch, a recruitment event or a sales presentation. Those teams are choosing a live webinar platform, and the test comes in the first five minutes of the first session."},"7441":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-123","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#approach","content":"Take a typical case. A university admissions office runs a live open evening each term for prospective postgraduate students. Two admissions officers present, a current student joins for the last twenty minutes, and around 200 applicants from several countries register."},"7442":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-124","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#approach","content":"The usual workaround is a general video meeting tool, set up by whoever is free that week. It may work, but the student often joins straight into the broadcast and tests their microphone in front of everyone. Questions can get lost in a busy chat, and the recording may end up in one person's account."},"7443":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-125","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#approach","content":"What changed is the stakes. An open evening is a recruitment event, so it has to look composed from the first minute. Applicants who can't attend live still need to see it, so the recording matters as much as the session."},"7444":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-126","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#approach","content":"EasyWebinar handles this inside the live room. EasyWebinar puts co-hosts and moderators backstage when they join, so the student can sort out their audio unseen and come on stage when called. EasyWebinar keeps questions in their own **Question** panel, split into **Active** and **Answered**, and with recording on the session lands in **Library → Recordings**."},"7445":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-127","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#approach","content":"One fact is easy to check before you start. In the green room the header reads **Not Live**, and nothing reaches attendees until you confirm **Go Live**. That private room is one of the capabilities covered in How the live room compares, below."},"7446":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-128","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#with-chat-and-qa","content":"How chat and questions behave in the room is set on the webinar's **Engagement** tab. **Hosts only** makes each attendee's messages private to your team, **No Chat** removes the panel, and Q&A can be public, private or disabled. See Live chat and Questions and answers."},"7447":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-129","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#with-polls-and-offers","content":"Polls and offers are created on the **CTAs** tab and shown from the room. A row's toggle in the CTAs list keeps an offer ready without showing it. Switch on **Countdown timer** in the offer editor to put a countdown on an offer."},"7448":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-130","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#with-replays-and-library","content":"Your recording appears in **Library → Recordings**. With the replay page set to **Webinar Replica**, the replay shows the same video, offers, polls and chat replay as the live session. See Replay pages and The Library."},"7449":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-131","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#with-cloning","content":"A webinar's type can't be changed, so the way to automate a successful live session is to clone it as **Evergreen** and pick its recording. See Clone a webinar."},"7450":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-132","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#with-easycast","content":"EasyCast multistreaming sends the live session to YouTube, LinkedIn, LinkedIn Organisation pages and custom RTMP destinations, connected once under **Integrations → EasyCast** and switched on per session in the room. Facebook isn't offered as a destination; its RTMP details may work under **Custom RTMP**."},"7451":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-133","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#who-uses-it","content":"These are typical patterns, shown to illustrate how the live room fits different teams."},"7452":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-134","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#coaches","content":"A coach runs a live masterclass alone. They blur the background in the green room, keep recording on, launch a poll about the audience's situation halfway through, and push a booking offer near the end. **End of Session** sends everyone to the booking page."},"7453":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-135","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#product-teams","content":"A product manager presents a release walkthrough or product demo while a colleague moderates. The colleague waits backstage, handles the **Question** queue during the demo, and comes on stage for the last ten minutes to answer the top questions. **Share** carries the product demo, and the layout favours the screen."},"7454":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-136","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#b2b-marketing","content":"A marketing team runs a panel webinar with branded frame overlays and streams it to the company's LinkedIn page through EasyCast. Registered attendees watch in the webinar room, and the overlay carries the brand into the recording too."},"7455":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-137","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#course-creators","content":"A creator runs a training live a few times with recording on, then clones the strongest session as an evergreen webinar using the recording from the Library. The course creator's guide follows that route end to end."},"7456":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-138","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"EasyWebinar's live room gives you a private green room, a backstage for co-hosts, and streaming out to YouTube and LinkedIn from the same screen you present from. EasyWebinar is the only platform in this table that does all three."},"7457":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-139","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"Live room features, from each platform's public documentation:"},"7458":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-140","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"| Platform        | Private room before going live | Co-hosts wait backstage | Stream out to YouTube and LinkedIn |\n| --------------- | ------------------------------ | ----------------------- | ---------------------------------- |\n| **EasyWebinar** | Yes                            | Yes                     | Yes                                |","table":"table-5"},"7459":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-141","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"| Platform  | Private room before going live   | Co-hosts wait backstage | Stream out to YouTube and LinkedIn |\n| --------- | -------------------------------- | ----------------------- | ---------------------------------- |\n| **Demio** | Yes (room opens 24 hours before) | Not in docs             | Yes (detail)                       |","table":"table-5"},"7460":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-142","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"| Platform       | Private room before going live | Co-hosts wait backstage | Stream out to YouTube and LinkedIn |\n| -------------- | ------------------------------ | ----------------------- | ---------------------------------- |\n| **WebinarJam** | Yes (off air up to 60 minutes) | Not in docs             | Partly (YouTube and Facebook only) |","table":"table-5"},"7461":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-143","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"| Platform      | Private room before going live | Co-hosts wait backstage | Stream out to YouTube and LinkedIn |\n| ------------- | ------------------------------ | ----------------------- | ---------------------------------- |\n| **Livestorm** | Yes (green room)               | Not in docs             | Yes (detail)                       |","table":"table-5"},"7462":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-144","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"| Platform | Private room before going live | Co-hosts wait backstage | Stream out to YouTube and LinkedIn         |\n| -------- | ------------------------------ | ----------------------- | ------------------------------------------ |\n| **Zoom** | Yes (practice session)         | Yes (detail)            | Partly (Facebook, YouTube, Twitch, custom) |","table":"table-5"},"7463":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-145","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"7464":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-146","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare-stronger","content":"**Co-hosts arrive out of sight.** In EasyWebinar, co-hosts and moderators land backstage and stay unseen until you move them on stage. Demio describes presenters choosing **Go On Stage** to appear immediately, and Livestorm's public docs describe no backstage. See EasyWebinar vs Demio and EasyWebinar vs Livestorm."},"7465":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-147","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare-stronger","content":"**LinkedIn company pages built in.** EasyCast lists **LinkedIn** and **LinkedIn Organisation** next to **YouTube** and **Custom RTMP**. Zoom's livestreaming setting names Facebook, YouTube, Twitch and a custom service. See EasyWebinar vs Zoom."},"7466":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-148","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare-stronger","content":"**Destinations connected once.** An EasyCast destination is connected once for the account and switched on in the room. WebinarJam has you choose the streaming service for each webinar in its configuration wizard, from YouTube Live and Facebook Live. See EasyWebinar vs WebinarJam and EverWebinar."},"7467":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-149","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 21 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"7468":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-150","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**A camera and microphone are required to enter,** even if you switch them off afterwards."},"7469":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-151","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**Only one event can be live at a time.**"},"7470":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-152","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**Polls are launched manually** on a live webinar."},"7471":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-153","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**Design changes apply immediately,** including mid-broadcast."},"7472":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-154","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**Theme is personal.** Light, dark or system changes your view, not the attendees'."},"7473":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-155","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**Ending is final.** **End Session** disconnects everyone, and nobody can rejoin."},"7474":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-156","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**Chat, Q&A and Show Attendees are setup controls.** Set them on the webinar's tabs before you go live."},"7475":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-157","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#limits","content":"**EasyCast is for live webinars.** Simulive and evergreen webinars play a recording rather than broadcasting."},"7476":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-158","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-green-room-broadcast","content":"No. The header reads **Not Live** until you click **Go Live** and confirm."},"7477":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-159","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-greyed-out","content":"The room needs to see a working camera and microphone before it lets you in. See Camera not detected."},"7478":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-160","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-camera-off","content":"Yes. You need a camera to enter, but you can switch **Camera** and **Mic** off in the green room and still go live."},"7479":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-161","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-recorded","content":"When the header shows **Auto Recording Enabled**, yes. Change it in **Settings → Recording Settings**."},"7480":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-162","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-recording-location","content":"To **Library → Recordings**, named after the webinar with its duration and recording date."},"7481":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-163","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-polls-manual","content":"No. On a live webinar you launch each poll yourself from the **Polls** panel."},"7482":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-164","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-share-screen","content":"Yes, with **Share** in the top bar."},"7483":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-165","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-stop-chat","content":"Yes. Before the session, set chat to **Hosts only** on the **Engagement** tab, or choose **No Chat**."},"7484":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-166","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-waiting-area","content":"People in the waiting area are moved into the webinar automatically when you go live."},"7485":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-167","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-rejoin","content":"No. Ending disconnects everyone and nobody can rejoin, so make sure you're finished before you confirm."},"7486":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-168","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#faq-one-live","content":"Another of your events is live. EasyWebinar allows one live event at a time."},"7487":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-169","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#related","content":"Create and schedule a live webinar: set the session time and registration before you open the room."},"7488":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-170","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#related","content":"The webinar Overview tab: where **Enter Room** sits, and where past sessions are listed."},"7489":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-171","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#related","content":"Sharing links: the co-presenter and moderator links that bring people backstage."},"7490":{"id":"/product-docs/webinars/live-room/run-a-live-webinar-172","page_id":"/product-docs/webinars/live-room/run-a-live-webinar","tags":[],"type":"text","url":"/product-docs/webinars/live-room/run-a-live-webinar#related","content":"Webinar analytics and live attendance: how many registrants turned up to this session."},"7491":{"id":"/product-docs/webinars/live","page_id":"/product-docs/webinars/live","type":"page","content":"What Is a Live Webinar? Scheduling, the Green Room, Co-Hosts, Chat, Polls, Recording","breadcrumbs":["EasyWebinar documentation","Webinars"],"tags":[],"url":"/product-docs/webinars/live"},"7492":{"id":"/product-docs/webinars/live-0","page_id":"/product-docs/webinars/live","tags":[],"type":"text","url":"/product-docs/webinars/live","content":"A live webinar is a session you present in real time at a set date and time. This guide explains what happens in a live webinar room, from the green room to recording, and when a recorded format suits you better."},"7493":{"id":"/product-docs/webinars/live-1","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#at-a-glance","content":"At a glance"},"7494":{"id":"/product-docs/webinars/live-2","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#what-it-is","content":"What a live webinar is"},"7495":{"id":"/product-docs/webinars/live-3","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#what-you-see","content":"What you see on the screen"},"7496":{"id":"/product-docs/webinars/live-4","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#why-it-matters","content":"Why live webinars matter"},"7497":{"id":"/product-docs/webinars/live-5","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#what-its-for","content":"What it's for"},"7498":{"id":"/product-docs/webinars/live-6","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#how-it-helps","content":"How it helps"},"7499":{"id":"/product-docs/webinars/live-7","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#without-it","content":"What happens without it"},"7500":{"id":"/product-docs/webinars/live-8","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#why-buyers-care","content":"Who this falls to, and when"},"7501":{"id":"/product-docs/webinars/live-9","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#approach","content":"The EasyWebinar approach to live webinars"},"7502":{"id":"/product-docs/webinars/live-10","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#formats","content":"Live, simulive or evergreen: how each format runs"},"7503":{"id":"/product-docs/webinars/live-11","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#format-live","content":"Live: you present in real time"},"7504":{"id":"/product-docs/webinars/live-12","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#format-simulive","content":"Simulive: a recording at set times"},"7505":{"id":"/product-docs/webinars/live-13","page_id":"/product-docs/webinars/live","type":"heading","tags":[],"url":"/product-docs/webinars/live#format-evergreen","content":"Evergreen: a recording on a repeating schedule"},"7506":{"id":"/product-docs/webinars/live-14","page_id":"/product-docs/webinars/live","type":"head