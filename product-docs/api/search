uct-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#offer-countdown","content":"Add a countdown"},"2294":{"id":"/product-docs/use-cases/first-sales-webinar-25","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#warm-up-poll","content":"Warm the room with a poll"},"2295":{"id":"/product-docs/use-cases/first-sales-webinar-26","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#paid-registration","content":"If you charge to register"},"2296":{"id":"/product-docs/use-cases/first-sales-webinar-27","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#follow-up","content":"Follow up with attendees and no-shows"},"2297":{"id":"/product-docs/use-cases/first-sales-webinar-28","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"How to run a sales webinar by hand"},"2298":{"id":"/product-docs/use-cases/first-sales-webinar-29","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#same-job","content":"The same job in EasyWebinar"},"2299":{"id":"/product-docs/use-cases/first-sales-webinar-30","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Set up your first sales webinar in EasyWebinar"},"2300":{"id":"/product-docs/use-cases/first-sales-webinar-31","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#ai-drafts","content":"If AI drafts it for you"},"2301":{"id":"/product-docs/use-cases/first-sales-webinar-32","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#email-tool","content":"If your list lives in an email tool"},"2302":{"id":"/product-docs/use-cases/first-sales-webinar-33","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#plans","content":"What each plan includes"},"2303":{"id":"/product-docs/use-cases/first-sales-webinar-34","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#measure-it","content":"Measure your first sales webinar"},"2304":{"id":"/product-docs/use-cases/first-sales-webinar-35","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#measure-limits","content":"How far to trust these numbers"},"2305":{"id":"/product-docs/use-cases/first-sales-webinar-36","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"Worked example: reading your first sales webinar funnel"},"2306":{"id":"/product-docs/use-cases/first-sales-webinar-37","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#compare","content":"How EasyWebinar compares for sales webinars for small business"},"2307":{"id":"/product-docs/use-cases/first-sales-webinar-38","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#compare-stronger","content":"Why EasyWebinar is the stronger choice for sales webinars for small business"},"2308":{"id":"/product-docs/use-cases/first-sales-webinar-39","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#what-it-doesnt-do","content":"What EasyWebinar doesn't do for a sales webinar"},"2309":{"id":"/product-docs/use-cases/first-sales-webinar-40","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#common-questions","content":"Common questions about sales webinars"},"2310":{"id":"/product-docs/use-cases/first-sales-webinar-41","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-live-or-automated","content":"Should a first sales webinar be live or automated?"},"2311":{"id":"/product-docs/use-cases/first-sales-webinar-42","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-not-pushy","content":"How do you sell on a webinar without being pushy?"},"2312":{"id":"/product-docs/use-cases/first-sales-webinar-43","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-script","content":"What should a sales webinar script include?"},"2313":{"id":"/product-docs/use-cases/first-sales-webinar-44","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-topics","content":"What makes a good sales webinar topic?"},"2314":{"id":"/product-docs/use-cases/first-sales-webinar-45","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-length","content":"How long should a sales webinar be?"},"2315":{"id":"/product-docs/use-cases/first-sales-webinar-46","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-template","content":"Is there a sales webinar template I can start from?"},"2316":{"id":"/product-docs/use-cases/first-sales-webinar-47","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-funnel","content":"How does a webinar sales funnel work?"},"2317":{"id":"/product-docs/use-cases/first-sales-webinar-48","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-payments","content":"Can I take payments during a webinar?"},"2318":{"id":"/product-docs/use-cases/first-sales-webinar-49","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-join","content":"Do attendees need to download anything?"},"2319":{"id":"/product-docs/use-cases/first-sales-webinar-50","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-email-tool","content":"Will EasyWebinar work with my email tool?"},"2320":{"id":"/product-docs/use-cases/first-sales-webinar-51","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-trial","content":"Is there a free trial, and do I need a card?"},"2321":{"id":"/product-docs/use-cases/first-sales-webinar-52","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-plan","content":"Which plan do I need for an automated sales webinar?"},"2322":{"id":"/product-docs/use-cases/first-sales-webinar-53","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-no-shows","content":"What should I send people who missed it?"},"2323":{"id":"/product-docs/use-cases/first-sales-webinar-54","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#faq-worked","content":"How do I know if my sales webinar worked?"},"2324":{"id":"/product-docs/use-cases/first-sales-webinar-55","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#further-reading","content":"Further reading"},"2325":{"id":"/product-docs/use-cases/first-sales-webinar-56","page_id":"/product-docs/use-cases/first-sales-webinar","type":"heading","tags":[],"url":"/product-docs/use-cases/first-sales-webinar#related","content":"Related"},"2326":{"id":"/product-docs/use-cases/first-sales-webinar-57","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar","content":"A sales webinar for a small business is a free online session that teaches one useful thing and ends with one clear offer. If you've never run one, the hard part isn't presenting. It's getting the format, the registration page, the offer and the follow-up to work together while you do everything alone. Run your first one live, show your offer inside the room with a countdown, then email attendees and no-shows separately afterwards. EasyWebinar holds all four steps in one webinar, so you build them once and reuse them."},"2327":{"id":"/product-docs/use-cases/first-sales-webinar-58","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#at-a-glance","content":"| Step      | What you decide                                     | Where it happens in EasyWebinar             |\n| --------- | --------------------------------------------------- | ------------------------------------------- |\n| 1. Format | Live for your first session, then an automated copy | The webinar type, chosen when you create it |","table":"table-0"},"2328":{"id":"/product-docs/use-cases/first-sales-webinar-59","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#at-a-glance","content":"| Step                 | What you decide                                  | Where it happens in EasyWebinar |\n| -------------------- | ------------------------------------------------ | ------------------------------- |\n| 2. Registration page | A headline, a short promise and a two-field form | The registration page builder   |","table":"table-0"},"2329":{"id":"/product-docs/use-cases/first-sales-webinar-60","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#at-a-glance","content":"| Step         | What you decide                           | Where it happens in EasyWebinar |\n| ------------ | ----------------------------------------- | ------------------------------- |\n| 3. Reminders | A day, an hour and fifteen minutes before | The **Notifications** tab       |","table":"table-0"},"2330":{"id":"/product-docs/use-cases/first-sales-webinar-61","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#at-a-glance","content":"| Step         | What you decide                                                 | Where it happens in EasyWebinar |\n| ------------ | --------------------------------------------------------------- | ------------------------------- |\n| 4. The offer | One offer, a button to your own checkout, an optional countdown | The **CTAs** tab                |","table":"table-0"},"2331":{"id":"/product-docs/use-cases/first-sales-webinar-62","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#at-a-glance","content":"| Step         | What you decide                                     | Where it happens in EasyWebinar                     |\n| ------------ | --------------------------------------------------- | --------------------------------------------------- |\n| 5. Follow-up | Replay and offer for attendees, replay for no-shows | **Webinar Follow-ups** on the **Notifications** tab |","table":"table-0"},"2332":{"id":"/product-docs/use-cases/first-sales-webinar-63","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#at-a-glance","content":"| Step      | What you decide                                      | Where it happens in EasyWebinar |\n| --------- | ---------------------------------------------------- | ------------------------------- |\n| 6. Review | Where people dropped out, and which step to fix next | The **Analytics** tab           |","table":"table-0"},"2333":{"id":"/product-docs/use-cases/first-sales-webinar-64","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#where-it-fits","content":"You've got a service or product that people buy once they understand it, and explaining it one call at a time is eating your week. A sales webinar lets you explain it once to a room of interested people, then make the offer while their interest is high."},"2334":{"id":"/product-docs/use-cases/first-sales-webinar-65","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-what-its-for","content":"A sales webinar turns a list of curious people into buyers in one sitting. It teaches something useful first, so the offer at the end feels like the natural next step rather than a pitch."},"2335":{"id":"/product-docs/use-cases/first-sales-webinar-66","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-how-it-helps","content":"**One explanation for many buyers.** You present once instead of repeating the same call."},"2336":{"id":"/product-docs/use-cases/first-sales-webinar-67","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-how-it-helps","content":"**The offer sits in the room.** Attendees click a button while they're still watching."},"2337":{"id":"/product-docs/use-cases/first-sales-webinar-68","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-how-it-helps","content":"**The session keeps working.** A live session can be cloned into an automated one that runs on a schedule."},"2338":{"id":"/product-docs/use-cases/first-sales-webinar-69","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-how-it-helps","content":"**Your contacts stay where you keep them, in your CRM or ours.** Keep HubSpot, Salesforce Pardot (Account Engagement), ActiveCampaign, Mailchimp or Kit (formerly ConvertKit), or use EasyCRM natively."},"2339":{"id":"/product-docs/use-cases/first-sales-webinar-70","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-without-it","content":"Without a sales webinar, every sale needs its own conversation. Your time sets the ceiling on how many people you can sell to, and interested people who can't get a call slot drift away."},"2340":{"id":"/product-docs/use-cases/first-sales-webinar-71","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#fits-why","content":"It matters most to owners and solo operators who sell something that takes ten minutes or more to explain. It matters most in the weeks before a launch or a seasonal push, when you need many conversations at once."},"2341":{"id":"/product-docs/use-cases/first-sales-webinar-72","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#approach","content":"Take a typical case. A one-person home organising business sells a paid decluttering package, and every new client has asked the same questions on a discovery call. The owner wants to answer those questions once, in a free 40-minute session, and invite the room to book."},"2342":{"id":"/product-docs/use-cases/first-sales-webinar-73","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#approach","content":"The usual workaround is to string tools together. That often means a video-call link, a payment page, a spreadsheet of who signed up and a few emails sent by hand. Each piece works alone, but nobody tells you who watched, who clicked and who still needs the recording."},"2343":{"id":"/product-docs/use-cases/first-sales-webinar-74","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#approach","content":"What changed is simple. A webinar no longer has to be live every time. Once you've presented it well, the recording can play at set times while the offer and follow-up run on their own."},"2344":{"id":"/product-docs/use-cases/first-sales-webinar-75","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#approach","content":"EasyWebinar keeps the registration page, the reminders, the offer and the follow-up inside one webinar. It shows the offer as a card in the room, with a button that opens your own checkout. It then sends different emails to attendees and no-shows, and it can turn the live session into an evergreen one by cloning it."},"2345":{"id":"/product-docs/use-cases/first-sales-webinar-76","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#approach","content":"You can check one part of this on the offer editor shown further down this page. The **Countdown timer** is a single switch on the offer card, beside the price and the button settings. How that compares with other webinar platforms is covered in How EasyWebinar compares for sales webinars for small business, below."},"2346":{"id":"/product-docs/use-cases/first-sales-webinar-77","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#choose-format","content":"Run your first sales webinar live. You'll hear which parts land, which questions come up and where people leave, and that tells you what to fix before you automate it. EasyWebinar offers three types, and you choose one when you create the webinar."},"2347":{"id":"/product-docs/use-cases/first-sales-webinar-78","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#format-live","content":"You present in real time and attendees join at the scheduled moment. Choose live when the value is in you being there, such as a launch or a workshop. You can create and schedule a live webinar in four steps, and recording can be switched on so you keep the session."},"2348":{"id":"/product-docs/use-cases/first-sales-webinar-79","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#format-simulive","content":"Simulive plays a recording at set times, with attendees registering for specific dates. Everyone in a session sees the same moment together, so the chat still works as a shared room. It suits a second run when you want to be in the chat but not on camera. The setup is covered in create a simulive webinar."},"2349":{"id":"/product-docs/use-cases/first-sales-webinar-80","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#format-evergreen","content":"Evergreen makes the recording available around the clock, and each registrant picks a time that suits them. It suits an offer you sell all year. When your live session has gone well, you can turn it into an evergreen webinar by cloning it and choosing **Evergreen** on the copy."},"2350":{"id":"/product-docs/use-cases/first-sales-webinar-81","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#format-check","content":"The type can't be changed after you create the webinar. If you pick the wrong one, clone the webinar and choose the right type on the copy. Your original stays untouched, and its registrants stay with it."},"2351":{"id":"/product-docs/use-cases/first-sales-webinar-82","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#how-it-sells","content":"Most sales webinars follow one of four patterns for where the offer goes. Each one catches some buyers and misses others, so pick the pattern before you write a word of your script."},"2352":{"id":"/product-docs/use-cases/first-sales-webinar-83","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#offer-at-end","content":"You teach for most of the session and introduce the offer in the last few minutes. It feels least pushy and builds trust with a cold audience. It misses anyone who leaves early, and on a first webinar that can be a large share of the room."},"2353":{"id":"/product-docs/use-cases/first-sales-webinar-84","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#offer-woven","content":"You teach and mention the offer at natural points, then close with a clear invitation. People who leave halfway have still heard what you sell. The risk is that each mention interrupts the teaching if it isn't tied to what you just showed."},"2354":{"id":"/product-docs/use-cases/first-sales-webinar-85","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#direct-pitch","content":"The session centres on the offer, with repeated calls to act and strong urgency. It suits a warm audience that already knows you. It can feel heavy to people meeting you for the first time."},"2355":{"id":"/product-docs/use-cases/first-sales-webinar-86","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#offer-after","content":"You keep the session purely educational and make the offer in the follow-up emails. It suits a very cautious audience. The cost is time: a 2011 Harvard Business Review article found that most companies weren't responding to online leads nearly fast enough."},"2356":{"id":"/product-docs/use-cases/first-sales-webinar-87","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#how-it-sells-product","content":"When AI drafts your webinar, EasyWebinar asks you to choose one of three positions: **Soft Pitch**, **Balanced Approach** or **Direct Pitch**. The offer card appears in the room when you choose to show it, and the follow-up emails can carry the offer afterwards. So all four patterns can run from the same webinar."},"2357":{"id":"/product-docs/use-cases/first-sales-webinar-88","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#script","content":"A sales webinar script needs a hook and welcome, the problem your buyer has, what you teach, and the offer. Plan those sections before you build slides, using the webinar outline template if you want a structure to fill in. Write in the words your buyers use. Nielsen Norman Group's guidance on plain language says simple, familiar words help experts as well as beginners."},"2358":{"id":"/product-docs/use-cases/first-sales-webinar-89","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#script","content":"If you'd rather start from a draft, EasyWebinar can generate a sales webinar script from a description of your audience, your topic and your offer. The script comes back in named sections with timings and speaker notes. Read it before you move on, because the pages and emails are built from it."},"2359":{"id":"/product-docs/use-cases/first-sales-webinar-90","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#registration-page","content":"Your registration page is the link you promote, so it carries most of the work before the session. It needs a headline that names the result, three or four things people will learn, the date and time, and a form."},"2360":{"id":"/product-docs/use-cases/first-sales-webinar-91","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#registration-page","content":"Keep the form short. Nielsen Norman Group's form design research says every field you cut raises the form's conversion rate. EasyWebinar's default form asks for **Full name** and **Email** only, and for a first webinar that's usually enough."},"2361":{"id":"/product-docs/use-cases/first-sales-webinar-92","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#registration-page","content":"The registration page builder opens straight after you create the webinar, with your date, time and a live countdown already in place. Pick a template, then check the page in the **Device toggle**'s mobile view, because many people will register from a phone. The page isn't public until you click **Publish**."},"2362":{"id":"/product-docs/use-cases/first-sales-webinar-93","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#registration-page","content":"To invite people already on your list, send the **One-Click Registration Link** from sharing links. It carries their name and email in the URL, so a known contact registers without filling in the form."},"2363":{"id":"/product-docs/use-cases/first-sales-webinar-94","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#reminders","content":"Getting people to register is the easy part. Getting them to turn up is what reminders are for. A common pattern is three reminder emails: a day before, an hour before and fifteen minutes before. The last one does most of the work."},"2364":{"id":"/product-docs/use-cases/first-sales-webinar-95","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#reminders","content":"Reminder timing is set relative to the webinar, not a fixed clock time, so the same three reminders work on recurring and evergreen schedules. Set the sender name to one people recognise, and set the reply-to address to an inbox you read, because people do reply. An SMS reminder (Beta) can go alongside email, if you add the **Phone** field to your form."},"2365":{"id":"/product-docs/use-cases/first-sales-webinar-96","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#sell-during-the-webinar","content":"Your offer is a card with a headline and a button, shown in the room while people watch. Build it before the session on the **CTAs** tab, and keep its toggle off until you're ready to show it. This video shows an offer being made to attendees during a webinar, without sending them away first."},"2366":{"id":"/product-docs/use-cases/first-sales-webinar-97","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#sell-during-the-webinar","content":"Every part of your in-room offer is set on this one screen, from the countdown to where the button goes. The price shown is sample data for a demo brand."},"2367":{"id":"/product-docs/use-cases/first-sales-webinar-98","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#offer-card","content":"Write a headline that names what the buyer gets, then set the button. **Button URL** is where attendees land when they click: your checkout, booking page or sales page. Write the button **Text** to match what happens next, such as \"Book your package\", never \"Click here\". The steps are on the offers page."},"2368":{"id":"/product-docs/use-cases/first-sales-webinar-99","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#offer-countdown","content":"Switching on **Countdown timer** puts a countdown on the offer card, which makes the offer feel time-limited. Only use one if the deadline is real. The countdown timers page covers how it behaves."},"2369":{"id":"/product-docs/use-cases/first-sales-webinar-100","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#warm-up-poll","content":"Ask an easy question about the audience before you make the offer. A question such as \"when are you planning to start?\" also tells you who's ready to buy. Build it on the same tab, as described under polls."},"2370":{"id":"/product-docs/use-cases/first-sales-webinar-101","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#paid-registration","content":"A sales webinar is usually free, but you can charge for a paid workshop instead. Attendees pay through a secure Stripe checkout, and the money goes straight to your Stripe account. EasyWebinar never holds your funds. The setup is under paid webinars."},"2371":{"id":"/product-docs/use-cases/first-sales-webinar-102","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#follow-up","content":"Most of your registrants won't attend live, so the follow-up is where much of the selling happens. Send attendees a thank-you with the replay and the offer, and send no-shows the replay. **Webinar Follow-ups** go after the session, and you choose the audience for each: everyone who registered, only attendees, or only no-shows."},"2372":{"id":"/product-docs/use-cases/first-sales-webinar-103","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#follow-up","content":"Turn on the replay page before you paste its link into an email. If the replay uses **Webinar Replica**, the same offers and polls carry over, so replay viewers can buy too. The replay pages guide covers the expiry options, and the full email set is on webinar follow-up emails."},"2373":{"id":"/product-docs/use-cases/first-sales-webinar-104","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#follow-up","content":"For warmer leads, **Attendee Action Follow-ups** send based on what someone did, such as clicking your offer. In People, the filter for high watch time plus an offer click shows who was interested and didn't buy."},"2374":{"id":"/product-docs/use-cases/first-sales-webinar-105","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"You can run a first sales webinar with general tools. It takes more steps, and the gaps between tools are where people get lost."},"2375":{"id":"/product-docs/use-cases/first-sales-webinar-106","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Write a one-page sign-up form in a form tool and collect names and emails."},"2376":{"id":"/product-docs/use-cases/first-sales-webinar-107","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Create a meeting link in a video-call tool and paste it into a confirmation email."},"2377":{"id":"/product-docs/use-cases/first-sales-webinar-108","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Send reminders by hand from your email tool the day before and an hour before."},"2378":{"id":"/product-docs/use-cases/first-sales-webinar-109","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Present, then paste a payment link into the chat when you make the offer."},"2379":{"id":"/product-docs/use-cases/first-sales-webinar-110","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Export the call's attendance list and match it against the sign-up sheet."},"2380":{"id":"/product-docs/use-cases/first-sales-webinar-111","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Upload the recording somewhere and email the link to no-shows."},"2381":{"id":"/product-docs/use-cases/first-sales-webinar-112","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#by-hand","content":"Count who paid by checking your payment tool against the attendance list."},"2382":{"id":"/product-docs/use-cases/first-sales-webinar-113","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#same-job","content":"In EasyWebinar the same steps sit in one webinar. The registration page, reminders and follow-ups are built in, and the offer card shows inside the room. Analytics count visitors, registrations, attendance and each offer's views, clicks and purchases, so you don't match lists by hand."},"2383":{"id":"/product-docs/use-cases/first-sales-webinar-114","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"This recipe gets a live sales webinar ready in one sitting. The manual builder walks you through four steps and takes about two minutes, and every page has a working default you can improve later."},"2384":{"id":"/product-docs/use-cases/first-sales-webinar-115","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Naming the webinar and picking its type comes first, and the type stays fixed once the webinar exists."},"2385":{"id":"/product-docs/use-cases/first-sales-webinar-116","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"On **My Webinars**, create a webinar, give it a name and choose **Live**."},"2386":{"id":"/product-docs/use-cases/first-sales-webinar-117","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Set the date and time. The timezone defaults to your account timezone."},"2387":{"id":"/product-docs/use-cases/first-sales-webinar-118","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"On the pricing step, leave the webinar **Free** unless you're charging to register."},"2388":{"id":"/product-docs/use-cases/first-sales-webinar-119","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Pick a registration template, or choose **Default Register Page** for a simple one-column page."},"2389":{"id":"/product-docs/use-cases/first-sales-webinar-120","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Edit the headline and promise in the builder, check the mobile view, then click **Publish**."},"2390":{"id":"/product-docs/use-cases/first-sales-webinar-121","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"On **Notifications**, set three reminders and two **Webinar Follow-ups**: one for attendees, one for no-shows."},"2391":{"id":"/product-docs/use-cases/first-sales-webinar-122","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"On **CTAs**, build your offer, set the **Button URL** to your checkout and leave its toggle off."},"2392":{"id":"/product-docs/use-cases/first-sales-webinar-123","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Switch the offer on at the right moment during the session."},"2393":{"id":"/product-docs/use-cases/first-sales-webinar-124","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#build-it","content":"Before you go live, run through the webinar setup checklist to test your camera, sound and offer link."},"2394":{"id":"/product-docs/use-cases/first-sales-webinar-125","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#ai-drafts","content":"Create with AI writes the script, builds the pages, drafts the emails and creates polls and offers from one description. It takes about ten minutes, and a full build of all five parts costs around 23 credits. Check every page and email before you publish, especially what they say about your offer."},"2395":{"id":"/product-docs/use-cases/first-sales-webinar-126","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#email-tool","content":"EasyWebinar connects to email tools including HubSpot, ActiveCampaign, Mailchimp, AWeber and Kit (formerly ConvertKit). It can tag contacts by what they did, such as **Attended**, **Missed** or **Clicked offer**. The steps are under connect a CRM and map your webinar data. If you'd rather not run a separate tool, EasyCRM keeps contacts beside your webinars."},"2396":{"id":"/product-docs/use-cases/first-sales-webinar-127","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#plans","content":"Every plan includes live webinars with browser join, so attendees click a link and watch without installing anything. Automation, EasyCRM and checkout start at the Growth plan. There's no free plan: the standard trial is 7 days and requires a card. Pricing is flat monthly, with no per-attendee fees, and monthly plans are available. Current plans are on the pricing page."},"2397":{"id":"/product-docs/use-cases/first-sales-webinar-128","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#measure-it","content":"Two measures tell you most of what a first sales webinar did. The first is how many registrants attended. The second is how many people who saw your offer clicked it and then bought."},"2398":{"id":"/product-docs/use-cases/first-sales-webinar-129","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#measure-it","content":"The funnel shows which step lost the most people, so you know what to fix first. These figures are sample data for a demo brand."},"2399":{"id":"/product-docs/use-cases/first-sales-webinar-130","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#measure-it","content":"On the **Analytics** tab, **Visitors** to **Registered** shows whether your registration page is doing its job. **Registered** to **Attended** shows whether your reminders are. Lower down, **Views to Clicks** and **Clicks to Purchases** separate the two offer problems. Low views to clicks means the offer isn't landing, and low clicks to purchases points to your checkout or pricing. The webinar analytics page explains each figure."},"2400":{"id":"/product-docs/use-cases/first-sales-webinar-131","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#measure-limits","content":"A first webinar has a small audience, so a few people change the percentages a lot. Compare one step with the next rather than with someone else's results. Replay views are counted separately from live attendance, so check **Total Attended** before you judge the session. If everything shows zero, widen the date range."},"2401":{"id":"/product-docs/use-cases/first-sales-webinar-132","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"This is an illustrative calculation with sample figures, not an EasyWebinar output. A solo operator promotes a free live session and reads the funnel the next morning."},"2402":{"id":"/product-docs/use-cases/first-sales-webinar-133","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"| Step                              | Count | Calculation | Rate |\n| --------------------------------- | ----- | ----------- | ---- |\n| Visitors to the registration page | 400   |             |      |","table":"table-1"},"2403":{"id":"/product-docs/use-cases/first-sales-webinar-134","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"| Step       | Count | Calculation | Rate |\n| ---------- | ----- | ----------- | ---- |\n| Registered | 120   | 120 ÷ 400   | 30%  |","table":"table-1"},"2404":{"id":"/product-docs/use-cases/first-sales-webinar-135","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"| Step          | Count | Calculation | Rate |\n| ------------- | ----- | ----------- | ---- |\n| Attended live | 54    | 54 ÷ 120    | 45%  |","table":"table-1"},"2405":{"id":"/product-docs/use-cases/first-sales-webinar-136","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"| Step   | Count | Calculation | Rate               |\n| ------ | ----- | ----------- | ------------------ |\n| Missed | 66    | 120 − 54    | 55% of registrants |","table":"table-1"},"2406":{"id":"/product-docs/use-cases/first-sales-webinar-137","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"| Step         | Count | Calculation | Rate             |\n| ------------ | ----- | ----------- | ---------------- |\n| Offer clicks | 13    | 13 ÷ 54     | 24% of attendees |","table":"table-1"},"2407":{"id":"/product-docs/use-cases/first-sales-webinar-138","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"| Step      | Count | Calculation | Rate          |\n| --------- | ----- | ----------- | ------------- |\n| Purchases | 4     | 4 ÷ 13      | 31% of clicks |","table":"table-1"},"2408":{"id":"/product-docs/use-cases/first-sales-webinar-139","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#worked-example","content":"More than half the registrants never showed up, so the replay email to 66 no-shows is the biggest next step. For the next webinar, the reminders deserve attention before the offer does, because the offer converted a fair share of the people who saw it."},"2409":{"id":"/product-docs/use-cases/first-sales-webinar-140","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"EasyWebinar runs live and automated sales webinars in one product, with the offer card and its countdown inside the room. It also reports each offer's views, clicks and purchases, so you can see which step of the sale lost people."},"2410":{"id":"/product-docs/use-cases/first-sales-webinar-141","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"Sales webinar features, from each platform's public documentation:"},"2411":{"id":"/product-docs/use-cases/first-sales-webinar-142","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"| Platform        | Live and automated in one product | Offer card in the room, with a countdown | Offer views, clicks and purchases reported | AI drafts the script and offers |\n| --------------- | --------------------------------- | ---------------------------------------- | ------------------------------------------ | ------------------------------- |\n| **EasyWebinar** | Yes                               | Yes                                      | Yes                                        | Yes                             |","table":"table-2"},"2412":{"id":"/product-docs/use-cases/first-sales-webinar-143","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"| Platform                     | Live and automated in one product            | Offer card in the room, with a countdown | Offer views, clicks and purchases reported    | AI drafts the script and offers |\n| ---------------------------- | -------------------------------------------- | ---------------------------------------- | --------------------------------------------- | ------------------------------- |\n| **WebinarJam + EverWebinar** | Partly (live and automated are two products) | Yes (Apply urgency countdown)            | Partly (sales tracked by codes on your pages) | Not in docs                     |","table":"table-2"},"2413":{"id":"/product-docs/use-cases/first-sales-webinar-144","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"| Platform  | Live and automated in one product   | Offer card in the room, with a countdown | Offer views, clicks and purchases reported | AI drafts the script and offers |\n| --------- | ----------------------------------- | ---------------------------------------- | ------------------------------------------ | ------------------------------- |\n| **Demio** | Yes (Standard and Automated events) | Partly (one Featured Action at a time)   | Partly (click count and share who clicked) | Not in docs                     |","table":"table-2"},"2414":{"id":"/product-docs/use-cases/first-sales-webinar-145","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"| Platform   | Live and automated in one product            | Offer card in the room, with a countdown | Offer views, clicks and purchases reported | AI drafts the script and offers |\n| ---------- | -------------------------------------------- | ---------------------------------------- | ------------------------------------------ | ------------------------------- |\n| **Kajabi** | Partly (webinar runs on a host such as Zoom) | Not in docs                              | Not in docs                                | Not in docs                     |","table":"table-2"},"2415":{"id":"/product-docs/use-cases/first-sales-webinar-146","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"| Platform     | Live and automated in one product             | Offer card in the room, with a countdown | Offer views, clicks and purchases reported | AI drafts the script and offers   |\n| ------------ | --------------------------------------------- | ---------------------------------------- | ------------------------------------------ | --------------------------------- |\n| **eWebinar** | Partly (recorded webinars, no live presenter) | Partly (countdown in one guide example)  | Partly (one conversion event per eWebinar) | Partly (standard script template) |","table":"table-2"},"2416":{"id":"/product-docs/use-cases/first-sales-webinar-147","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"| Platform       | Live and automated in one product          | Offer card in the room, with a countdown          | Offer views, clicks and purchases reported | AI drafts the script and offers        |\n| -------------- | ------------------------------------------ | ------------------------------------------------- | ------------------------------------------ | -------------------------------------- |\n| **WebinarKit** | Partly (live webinars depend on your plan) | Partly (countdown named on the Live product page) | Partly (clicks on offers on the dashboard) | Yes (AI builds a sales webinar script) |","table":"table-2"},"2417":{"id":"/product-docs/use-cases/first-sales-webinar-148","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"2418":{"id":"/product-docs/use-cases/first-sales-webinar-149","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare-stronger","content":"**One product for your live session and its automated copy.** EasyWebinar clones a live webinar into an evergreen one, while EverWebinar sessions run in a separate product from WebinarJam. See EasyWebinar vs WebinarJam."},"2419":{"id":"/product-docs/use-cases/first-sales-webinar-150","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare-stronger","content":"**Offer views, clicks and purchases in one panel.** EasyWebinar reports all three per offer, while WebinarKit's dashboard lists clicks on offers. See EasyWebinar vs WebinarKit."},"2420":{"id":"/product-docs/use-cases/first-sales-webinar-151","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare-stronger","content":"**The sale happens in the room.** EasyWebinar shows a timed offer card during the session, while Kajabi's webinar funnel runs on a host such as Zoom. See EasyWebinar vs Kajabi."},"2421":{"id":"/product-docs/use-cases/first-sales-webinar-152","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare-stronger","content":"**Live and recorded in the same room.** EasyWebinar runs both from one account, while eWebinar is built for recorded sessions without a live presenter. See EasyWebinar vs eWebinar."},"2422":{"id":"/product-docs/use-cases/first-sales-webinar-153","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 4 November 2026. Features and plans change, so confirm with the vendor before you decide.*"},"2423":{"id":"/product-docs/use-cases/first-sales-webinar-154","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#what-it-doesnt-do","content":"EasyWebinar doesn't hold the money from your offer. The offer button opens your own checkout URL, and paid registration runs through your Stripe account. A webinar's type is fixed once it exists, so moving from live to evergreen means cloning it. Reminders and follow-ups are set per webinar, so a new webinar needs its own set or a clone of an earlier one. The replay link is public while the replay page is on."},"2424":{"id":"/product-docs/use-cases/first-sales-webinar-155","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-live-or-automated","content":"Run your first sales webinar live. You'll learn which parts land and where people leave. Once it works, clone it in EasyWebinar and choose Evergreen, so the recording plays on a schedule with the same offers."},"2425":{"id":"/product-docs/use-cases/first-sales-webinar-156","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-not-pushy","content":"Teach one useful thing first, then make one offer that follows from it. Show the offer card when the teaching reaches the problem your product solves. Use a countdown only when the deadline is real."},"2426":{"id":"/product-docs/use-cases/first-sales-webinar-157","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-script","content":"A sales webinar script needs a hook and welcome, the buyer's problem, what you teach and the offer. EasyWebinar's AI can draft one in named sections with timings and speaker notes, which you then edit."},"2427":{"id":"/product-docs/use-cases/first-sales-webinar-158","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-topics","content":"Pick a topic that solves the first part of the problem your product solves. A home organiser might teach how to clear one room in a weekend, then offer the full package for the whole house."},"2428":{"id":"/product-docs/use-cases/first-sales-webinar-159","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-length","content":"In EasyWebinar you set the duration and slide count before AI writes the script, so decide how long you need to teach, make the offer and answer questions before you generate it."},"2429":{"id":"/product-docs/use-cases/first-sales-webinar-160","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-template","content":"EasyWebinar has registration page templates in categories such as Coach, Lead Magnet and Marketing. Its AI can also draft the script, pages, emails, polls and offers from one description of your webinar."},"2430":{"id":"/product-docs/use-cases/first-sales-webinar-161","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-funnel","content":"A webinar sales funnel moves people from the registration page to the session, then to the offer and checkout. EasyWebinar's analytics count each step, from visitors and registrations to offer views, clicks and purchases."},"2431":{"id":"/product-docs/use-cases/first-sales-webinar-162","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-payments","content":"Yes. An EasyWebinar offer button opens your own checkout, booking or sales page. For paid registration, attendees pay through a Stripe checkout and the money goes straight to your Stripe account."},"2432":{"id":"/product-docs/use-cases/first-sales-webinar-163","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-join","content":"No. Every EasyWebinar plan includes live webinars with browser join, so attendees click their link and watch in the browser. Contacts on your list can register through a one-click link that skips the form."},"2433":{"id":"/product-docs/use-cases/first-sales-webinar-164","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-email-tool","content":"EasyWebinar connects to tools including HubSpot, ActiveCampaign, Mailchimp, AWeber and Kit (formerly ConvertKit). It can tag contacts as attended, missed or clicked offer. You can also keep contacts in EasyCRM instead."},"2434":{"id":"/product-docs/use-cases/first-sales-webinar-165","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-trial","content":"EasyWebinar has no free plan. The standard trial is 7 days and requires a card. Plans are priced flat monthly, with no per-attendee fees, and current prices are on the pricing page."},"2435":{"id":"/product-docs/use-cases/first-sales-webinar-166","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-plan","content":"Every EasyWebinar plan includes live webinars. Automation, EasyCRM and checkout start at the Growth plan, so an evergreen or simulive sales webinar needs Growth or above."},"2436":{"id":"/product-docs/use-cases/first-sales-webinar-167","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-no-shows","content":"Send no-shows the replay link as soon as the session ends. In EasyWebinar, add a Webinar Follow-up with its audience set to no-shows. A replay set to Webinar Replica repeats the live offers."},"2437":{"id":"/product-docs/use-cases/first-sales-webinar-168","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#faq-worked","content":"Compare registrations with attendance, then offer clicks with purchases. EasyWebinar's Analytics tab shows both, with Views to Clicks and Clicks to Purchases for each offer, so you can see which step to fix."},"2438":{"id":"/product-docs/use-cases/first-sales-webinar-169","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#further-reading","content":"The Short Life of Online Sales Leads (Harvard Business Review, 2011): why the speed of your response to a new lead matters."},"2439":{"id":"/product-docs/use-cases/first-sales-webinar-170","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#further-reading","content":"Website Forms Usability: Top 10 Recommendations (Nielsen Norman Group): why fewer form fields mean more sign-ups."},"2440":{"id":"/product-docs/use-cases/first-sales-webinar-171","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#further-reading","content":"Plain Language Is for Everyone, Even Experts (Nielsen Norman Group): how simple words make a script easier to follow."},"2441":{"id":"/product-docs/use-cases/first-sales-webinar-172","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#related","content":"How to run your first webinar that converts: the blog guide to planning and promoting a first webinar."},"2442":{"id":"/product-docs/use-cases/first-sales-webinar-173","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#related","content":"Webinar invitation emails: what to write when you invite your list."},"2443":{"id":"/product-docs/use-cases/first-sales-webinar-174","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#related","content":"Selling online courses with webinars: the same offer and follow-up flow for course creators."},"2444":{"id":"/product-docs/use-cases/first-sales-webinar-175","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#related","content":"Run a live webinar: what happens in the room once you press go live."},"2445":{"id":"/product-docs/use-cases/first-sales-webinar-176","page_id":"/product-docs/use-cases/first-sales-webinar","tags":[],"type":"text","url":"/product-docs/use-cases/first-sales-webinar#related","content":"*Updated 4 November 2026: first published with the format choice, offer patterns, the manual method, a measurement guide and a worked example.*"},"2446":{"id":"/product-docs/use-cases","page_id":"/product-docs/use-cases","type":"page","content":"Types of Webinars: Pick the Job You Have, Then Find the Set-Up and Steps That Fit It","breadcrumbs":["EasyWebinar documentation","Use cases"],"tags":[],"url":"/product-docs/use-cases"},"2447":{"id":"/product-docs/use-cases-0","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases","content":"Types of webinars sorted by the job you want done, with the format, features and step-by-step guide that fit each one in EasyWebinar."},"2448":{"id":"/product-docs/use-cases-1","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#at-a-glance","content":"At a glance"},"2449":{"id":"/product-docs/use-cases-2","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#where-it-fits","content":"Where each type of webinar fits"},"2450":{"id":"/product-docs/use-cases-3","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#live","content":"Live"},"2451":{"id":"/product-docs/use-cases-4","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#simulive","content":"Simulive"},"2452":{"id":"/product-docs/use-cases-5","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#evergreen","content":"Evergreen"},"2453":{"id":"/product-docs/use-cases-6","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#which-to-pick","content":"Which one to pick"},"2454":{"id":"/product-docs/use-cases-7","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#by-job","content":"Webinar examples by job"},"2455":{"id":"/product-docs/use-cases-8","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#sell-a-course","content":"Sell a course or programme"},"2456":{"id":"/product-docs/use-cases-9","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#win-clients","content":"Win clients as a coach or consultant"},"2457":{"id":"/product-docs/use-cases-10","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#fill-a-pipeline","content":"Fill a sales pipeline"},"2458":{"id":"/product-docs/use-cases-11","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#launch-and-onboard","content":"Launch a product or onboard customers"},"2459":{"id":"/product-docs/use-cases-12","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#agencies-and-teams","content":"Run webinars for clients or as a team"},"2460":{"id":"/product-docs/use-cases-13","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#paid-sessions","content":"Charge for a workshop or seminar"},"2461":{"id":"/product-docs/use-cases-14","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#start","content":"Choose your starting point"},"2462":{"id":"/product-docs/use-cases-15","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#what-goes-wrong","content":"What goes wrong, and what to check"},"2463":{"id":"/product-docs/use-cases-16","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#common-questions","content":"Common questions"},"2464":{"id":"/product-docs/use-cases-17","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#what-are-webinars-used-for","content":"What are webinars used for?"},"2465":{"id":"/product-docs/use-cases-18","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#main-types","content":"What are the main types of webinars?"},"2466":{"id":"/product-docs/use-cases-19","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#best-for-a-funnel","content":"Which type of webinar is best for a sales funnel?"},"2467":{"id":"/product-docs/use-cases-20","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#change-type","content":"Can I change a webinar from live to evergreen?"},"2468":{"id":"/product-docs/use-cases-21","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#talk-on-recorded","content":"Can I still talk to attendees on a recorded webinar?"},"2469":{"id":"/product-docs/use-cases-22","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#need-a-recording","content":"Do I need to record something before I start?"},"2470":{"id":"/product-docs/use-cases-23","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#keep-your-crm","content":"Do I have to give up my CRM?"},"2471":{"id":"/product-docs/use-cases-24","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#host-my-course","content":"Can EasyWebinar host my course?"},"2472":{"id":"/product-docs/use-cases-25","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#ai-writes-it","content":"Can AI write the webinar for me?"},"2473":{"id":"/product-docs/use-cases-26","page_id":"/product-docs/use-cases","type":"heading","tags":[],"url":"/product-docs/use-cases#related","content":"Related"},"2474":{"id":"/product-docs/use-cases-27","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases","content":"Most guides to the types of webinars sort them by format, but you start with a job: fill a course, win clients, or explain a product. This page sorts webinars by that job instead. For each one it tells you which format fits, which features matter and which guide to follow next. EasyWebinar is a webinar platform that runs all three formats, so you can start with one and move to another as the job changes."},"2475":{"id":"/product-docs/use-cases-28","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"Find the row closest to what you're trying to do. The format column tells you what to pick when you create the webinar, and the last column is where to go next."},"2476":{"id":"/product-docs/use-cases-29","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"| The job you have                 | Format that usually fits            | Start with                           |\n| -------------------------------- | ----------------------------------- | ------------------------------------ |\n| Sell a course you host elsewhere | Live for the launch, then Evergreen | Selling online courses with webinars |","table":"table-0"},"2477":{"id":"/product-docs/use-cases-30","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"| The job you have                    | Format that usually fits | Start with              |\n| ----------------------------------- | ------------------------ | ----------------------- |\n| Bring in new leads for a sales team | Live or Simulive         | Webinar lead generation |","table":"table-0"},"2478":{"id":"/product-docs/use-cases-31","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"| The job you have                 | Format that usually fits | Start with                |\n| -------------------------------- | ------------------------ | ------------------------- |\n| Get the right people to register | Any format               | Webinar invitation emails |","table":"table-0"},"2479":{"id":"/product-docs/use-cases-32","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"| The job you have                           | Format that usually fits | Start with               |\n| ------------------------------------------ | ------------------------ | ------------------------ |\n| Plan what you will say, section by section | Any format               | Webinar outline template |","table":"table-0"},"2480":{"id":"/product-docs/use-cases-33","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"| The job you have                    | Format that usually fits | Start with              |\n| ----------------------------------- | ------------------------ | ----------------------- |\n| Check everything before you go live | Live or Simulive         | Webinar setup checklist |","table":"table-0"},"2481":{"id":"/product-docs/use-cases-34","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"| The job you have                        | Format that usually fits | Start with               |\n| --------------------------------------- | ------------------------ | ------------------------ |\n| Win back no-shows and convert attendees | Any format               | Webinar follow-up emails |","table":"table-0"},"2482":{"id":"/product-docs/use-cases-35","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#at-a-glance","content":"If you already use a CRM, you can keep it. Keep HubSpot, Salesforce Pardot (Account Engagement), ActiveCampaign, Mailchimp or Kit, or use EasyCRM natively. The CRM mapping guide shows how webinar data reaches the CRM you already have."},"2483":{"id":"/product-docs/use-cases-36","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#where-it-fits","content":"Take a typical case. A small travel company sells guided walking holidays and wants more bookings from people who are still deciding. A live talk once a month works, but the team can't present every evening for every time zone. What they need is a set-up that matches that job, not a list of features."},"2484":{"id":"/product-docs/use-cases-37","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#where-it-fits","content":"A webinar type is the way your content reaches people. EasyWebinar offers three types of webinar, and you choose one when you create it. The choice sets your schedule and how attendees take part. All three use the same pages, emails, polls, offers and analytics, so only the delivery differs."},"2485":{"id":"/product-docs/use-cases-38","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#where-it-fits","content":"This is the moment the format is fixed. Pick the type that fits your job here, because the webinar keeps it from then on."},"2486":{"id":"/product-docs/use-cases-39","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#live","content":"You present in real time, and attendees join at the scheduled moment. Chat and questions happen as they happen. A live webinar is best for a launch, a workshop or any session where people come for the conversation. It is not the right fit when nobody can be there at the set time, every time."},"2487":{"id":"/product-docs/use-cases-40","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#simulive","content":"You record the session in advance, and it plays at set times. Everyone in a session watches together, and the recording plays while you and your moderators answer in the chat live. Simulive suits a talk you give again and again, or a session in a time zone you'd rather sleep through. It is not for a session you haven't recorded yet."},"2488":{"id":"/product-docs/use-cases-41","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#evergreen","content":"The recording runs on a repeating schedule, with each registrant picking their own time. Evergreen suits a demo, an onboarding session or an offer you run all year. It is not the best fit for a one-off event where the live questions are the point. The automated webinar overview explains how the schedules work together."},"2489":{"id":"/product-docs/use-cases-42","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#which-to-pick","content":"| If you want                                    | Pick |\n| ---------------------------------------------- | ---- |\n| To answer questions as they come, in real time | Live |","table":"table-1"},"2490":{"id":"/product-docs/use-cases-43","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#which-to-pick","content":"| If you want                                             | Pick     |\n| ------------------------------------------------------- | -------- |\n| A polished recording at set times, with you in the chat | Simulive |","table":"table-1"},"2491":{"id":"/product-docs/use-cases-44","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#which-to-pick","content":"| If you want                                                  | Pick      |\n| ------------------------------------------------------------ | --------- |\n| A session that runs all the time and lets each person choose | Evergreen |","table":"table-1"},"2492":{"id":"/product-docs/use-cases-45","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#which-to-pick","content":"| If you want                                                | Pick                  |\n| ---------------------------------------------------------- | --------------------- |\n| To run the same session weekly without presenting it again | Simulive or Evergreen |","table":"table-1"},"2493":{"id":"/product-docs/use-cases-46","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#which-to-pick","content":"Live and Simulive both need you to pick dates, while Evergreen handles the schedule for you. Our walking-holiday company would run the talk live first, then turn it into an evergreen webinar for the evenings nobody can present."},"2494":{"id":"/product-docs/use-cases-47","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#by-job","content":"These webinar examples are grouped by what the webinar has to achieve, which is usually the way a sale works. Each one says who it suits, who it doesn't suit, and where the full steps live. For a wider view by sector, the EasyWebinar solutions for all industries cover more ground."},"2495":{"id":"/product-docs/use-cases-48","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#sell-a-course","content":"Course creators often open enrolment with a live session in launch week, then keep selling with an evergreen version. You can show an offer during the session and add a countdown on the offer. The full plan is in selling courses with webinars."},"2496":{"id":"/product-docs/use-cases-49","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#sell-a-course","content":"This suits course creators, educators and trainers. It is not for hosting the course itself. EasyWebinar is the layer that sells your course, and the course stays on your own course platform."},"2497":{"id":"/product-docs/use-cases-50","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#win-clients","content":"Coaches and consultants usually teach something useful, then invite attendees to apply or book a call. A live session works well here, because trust grows when people can ask you questions. Plan the talk with the outline template, and use timed offers for the booking link. A full guide to coaching webinars is on the way."},"2498":{"id":"/product-docs/use-cases-51","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#fill-a-pipeline","content":"B2B marketing teams and SaaS teams run webinars to bring in leads, then pass the warmest ones to sales. The lead generation guide covers capturing registrants and their source. The People view then shows who watched and who clicked. Guides to a first sales webinar and to automated product demos are planned."},"2499":{"id":"/product-docs/use-cases-52","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#fill-a-pipeline","content":"This suits teams with a steady flow of prospects. If you only need a quick internal meeting, a full webinar set-up is more than the job needs."},"2500":{"id":"/product-docs/use-cases-53","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#launch-and-onboard","content":"Product teams can announce and demonstrate in one live session, then keep the recording working. Customer success teams often run the same onboarding session each week, which suits Simulive or Evergreen. You can let people watch straight after registering instead of waiting for the next slot. Guides to product launch webinars and customer onboarding webinars are still being written."},"2501":{"id":"/product-docs/use-cases-54","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#agencies-and-teams","content":"Agencies run webinars for several clients, and small businesses often share the work between two or three people. Give each person their own login with team members and roles. To repeat a set-up, clone a webinar instead of building it again. Guides to client webinar funnels and team webinar programmes are planned."},"2502":{"id":"/product-docs/use-cases-55","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#paid-sessions","content":"Solo operators sometimes sell a seat rather than a product at the end. The set-up for that is in paid webinars and paid registration. A separate guide to paid seminars and workshops is planned."},"2503":{"id":"/product-docs/use-cases-56","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"Work through these steps in order. Most set-up problems come from skipping the first two."},"2504":{"id":"/product-docs/use-cases-57","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"**Name the job.** Write one sentence about what the webinar must achieve, such as \"book ten discovery calls\". Match it to a row in the table at the top."},"2505":{"id":"/product-docs/use-cases-58","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"**Pick the format.** Choose Live, Simulive or Evergreen from the table above. If the format needs a recording, have it ready first."},"2506":{"id":"/product-docs/use-cases-59","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"**Choose how to build it.** In **Create a Webinar**, pick **Create with AI** or **Create Manually**."},"2507":{"id":"/product-docs/use-cases-60","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"**Follow the guide for your format.** Use the steps to create a live webinar, create a simulive webinar or create an evergreen webinar."},"2508":{"id":"/product-docs/use-cases-61","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"**Plan the follow-up before the session.** Decide what attendees and no-shows each receive, using the follow-up email guide."},"2509":{"id":"/product-docs/use-cases-62","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"Step three happens here. Create with AI drafts the webinar from a short description, while Create Manually lets you build each part yourself."},"2510":{"id":"/product-docs/use-cases-63","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#start","content":"If you choose AI, Create with AI builds a complete webinar from a description. You then review and edit what it drafted before anyone sees it."},"2511":{"id":"/product-docs/use-cases-64","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#what-goes-wrong","content":"**You picked the wrong format.** You can't change the type later. Clone the webinar and choose the right type on the copy. Cloning is also how you turn a live webinar into an evergreen one, as the guide to turning a live session into an evergreen one explains."},"2512":{"id":"/product-docs/use-cases-65","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#what-goes-wrong","content":"**There's no recording yet.** Simulive and Evergreen need a recording, but Live webinars don't. If you haven't recorded anything, run it live first and use that recording later."},"2513":{"id":"/product-docs/use-cases-66","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#what-goes-wrong","content":"**Most registrants don't turn up.** Reminders are where attendance is won or lost. Check your reminder emails, and send no-shows a follow-up with the replay page."},"2514":{"id":"/product-docs/use-cases-67","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#what-goes-wrong","content":"**Your audience speaks another language.** Language is set per webinar, so each webinar can run in its own language. Language settings don't translate your content, though, so write your pages and emails in your audience's language."},"2515":{"id":"/product-docs/use-cases-68","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#what-goes-wrong","content":"**Your leads stay in the webinar tool.** Plan where contacts go before you run the session. You can bring registrants and attendees into EasyCRM, or send them to the CRM you already use."},"2516":{"id":"/product-docs/use-cases-69","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#what-are-webinars-used-for","content":"Webinars are used to sell courses and programmes, win clients, bring in sales leads, launch products and onboard customers. The job decides the format. A live session suits real-time questions, while a recording on a schedule suits sessions you repeat."},"2517":{"id":"/product-docs/use-cases-70","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#main-types","content":"EasyWebinar offers three: Live, Simulive and Evergreen. Live is presented in real time. Simulive plays a recording at set times, with you in the chat. Evergreen plays a recording on a repeating schedule, and each registrant picks their own time."},"2518":{"id":"/product-docs/use-cases-71","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#best-for-a-funnel","content":"Evergreen, in most cases, because it runs without you being there. Many people run the session live a few times first to sharpen it. Then they clone it as Evergreen and use the recording."},"2519":{"id":"/product-docs/use-cases-72","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#change-type","content":"Not directly, because the type is fixed when you create the webinar. Clone the webinar and choose Evergreen on the copy. That is the supported way to turn a live session that works into an evergreen one."},"2520":{"id":"/product-docs/use-cases-73","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#talk-on-recorded","content":"Yes, on Simulive. The recording plays while you and your moderators answer in the chat live. Attendees can also send questions through questions and answers, which keeps them apart from the chat."},"2521":{"id":"/product-docs/use-cases-74","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#need-a-recording","content":"Only for Simulive and Evergreen, because both play a recording. For a Live webinar you supply the content by presenting, so you need nothing recorded in advance."},"2522":{"id":"/product-docs/use-cases-75","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#keep-your-crm","content":"No. EasyWebinar works with your CRM or ours. You can keep the CRM you use today and send webinar data to it, or use EasyCRM in the same product."},"2523":{"id":"/product-docs/use-cases-76","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#host-my-course","content":"No. EasyWebinar is not a course platform. It runs the webinar that sells your course, and the course itself stays on the platform you already use."},"2524":{"id":"/product-docs/use-cases-77","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#ai-writes-it","content":"It can draft it. The AI webinar overview explains what AI drafts before the session and what you still review. You stay in charge of the final wording."},"2525":{"id":"/product-docs/use-cases-78","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#related","content":"Webinars overview"},"2526":{"id":"/product-docs/use-cases-79","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#related","content":"Automated webinars"},"2527":{"id":"/product-docs/use-cases-80","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#related","content":"Live webinars"},"2528":{"id":"/product-docs/use-cases-81","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#related","content":"Paid webinars"},"2529":{"id":"/product-docs/use-cases-82","page_id":"/product-docs/use-cases","tags":[],"type":"text","url":"/product-docs/use-cases#related","content":"Clone a webinar"},"2530":{"id":"/product-docs/use-cases/paid-seminars-workshops","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"page","content":"Paid Webinar: Run a Workshop or Seminar, From Taking Payment to Sharing the Replay","breadcrumbs":["EasyWebinar documentation","Use cases"],"tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops"},"2531":{"id":"/product-docs/use-cases/paid-seminars-workshops-0","page_id":"/product-docs/use-cases/paid-seminars-workshops","tags":[],"type":"text","url":"/product-docs/use-cases/paid-seminars-workshops","content":"How to run a paid webinar as a live workshop or seminar: take payment through Stripe at registration, teach with chat, Q&A and polls, then decide who can watch the replay and for how long."},"2532":{"id":"/product-docs/use-cases/paid-seminars-workshops-1","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#at-a-glance","content":"At a glance"},"2533":{"id":"/product-docs/use-cases/paid-seminars-workshops-2","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#where-it-fits","content":"Where paid workshops and seminars fit"},"2534":{"id":"/product-docs/use-cases/paid-seminars-workshops-3","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#fits-what-its-for","content":"What they're for"},"2535":{"id":"/product-docs/use-cases/paid-seminars-workshops-4","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#fits-how-it-helps","content":"How they help"},"2536":{"id":"/product-docs/use-cases/paid-seminars-workshops-5","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#fits-without-it","content":"What happens without them"},"2537":{"id":"/product-docs/use-cases/paid-seminars-workshops-6","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#fits-why","content":"Why trainers and experts care"},"2538":{"id":"/product-docs/use-cases/paid-seminars-workshops-7","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#approach","content":"The EasyWebinar approach to paid workshops and seminars"},"2539":{"id":"/product-docs/use-cases/paid-seminars-workshops-8","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#webinar-vs-workshop","content":"Webinar vs workshop: what changes when people pay"},"2540":{"id":"/product-docs/use-cases/paid-seminars-workshops-9","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#ways-to-charge","content":"How people charge for an online workshop"},"2541":{"id":"/product-docs/use-cases/paid-seminars-workshops-10","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#ticket-at-registration","content":"A ticket paid at registration"},"2542":{"id":"/product-docs/use-cases/paid-seminars-workshops-11","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#separate-checkout","content":"A separate checkout, then an invitation"},"2543":{"id":"/product-docs/use-cases/paid-seminars-workshops-12","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#membership-link","content":"A course platform or membership that holds the link"},"2544":{"id":"/product-docs/use-cases/paid-seminars-workshops-13","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#free-then-sell","content":"A free session that sells in the room"},"2545":{"id":"/product-docs/use-cases/paid-seminars-workshops-14","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#confirmed","content":"What EasyWebinar is confirmed to do"},"2546":{"id":"/product-docs/use-cases/paid-seminars-workshops-15","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#choose-format","content":"Choose the format before you build"},"2547":{"id":"/product-docs/use-cases/paid-seminars-workshops-16","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#by-hand","content":"How to run a paid online workshop by hand"},"2548":{"id":"/product-docs/use-cases/paid-seminars-workshops-17","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#same-job","content":"The same job in EasyWebinar"},"2549":{"id":"/product-docs/use-cases/paid-seminars-workshops-18","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#build-it","content":"Set up a paid workshop in EasyWebinar"},"2550":{"id":"/product-docs/use-cases/paid-seminars-workshops-19","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#choose-paid","content":"Choose Paid when you create the webinar"},"2551":{"id":"/product-docs/use-cases/paid-seminars-workshops-20","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#name-the-ticket","content":"Name the ticket and connect Stripe"},"2552":{"id":"/product-docs/use-cases/paid-seminars-workshops-21","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#decide-replay","content":"Decide on the replay before you publish"},"2553":{"id":"/product-docs/use-cases/paid-seminars-workshops-22","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#registration-form","content":"Keep the registration form short"},"2554":{"id":"/product-docs/use-cases/paid-seminars-workshops-23","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#reminders","content":"Confirm the booking and remind people"},"2555":{"id":"/product-docs/use-cases/paid-seminars-workshops-24","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#after-paying","content":"Check what buyers see after paying"},"2556":{"id":"/product-docs/use-cases/paid-seminars-workshops-25","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#teach-it","content":"Teach the session: chat, Q&A and polls"},"2557":{"id":"/product-docs/use-cases/paid-seminars-workshops-26","page_id":"/product-docs/use-cases/paid-seminars-workshops","type":"heading","tags":[],"url":"/product-docs/use-cases/paid-seminars-workshops#teach-chat","content":"Chat that suits the group"},"2558":{"id":"/product-docs/use