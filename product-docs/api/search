product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#symptom","content":"Symptom"},"823":{"id":"/product-docs/troubleshooting/camera-not-detected-2","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#why","content":"Why it happens"},"824":{"id":"/product-docs/troubleshooting/camera-not-detected-3","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#fix","content":"Fix it"},"825":{"id":"/product-docs/troubleshooting/camera-not-detected-4","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#verify","content":"Verify the fix"},"826":{"id":"/product-docs/troubleshooting/camera-not-detected-5","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#related-problems","content":"Related problems"},"827":{"id":"/product-docs/troubleshooting/camera-not-detected-6","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#one-event-live","content":"\"You can only have one event live at a time.\""},"828":{"id":"/product-docs/troubleshooting/camera-not-detected-7","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#prevent","content":"Prevent it next time"},"829":{"id":"/product-docs/troubleshooting/camera-not-detected-8","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#common-questions","content":"Common questions"},"830":{"id":"/product-docs/troubleshooting/camera-not-detected-9","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#faq-camera-off","content":"Can I enter the room with my camera off?"},"831":{"id":"/product-docs/troubleshooting/camera-not-detected-10","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#faq-attendees-see","content":"Will attendees see me while I fix my camera?"},"832":{"id":"/product-docs/troubleshooting/camera-not-detected-11","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#faq-switch-device","content":"Can I switch camera or microphone once I'm in?"},"833":{"id":"/product-docs/troubleshooting/camera-not-detected-12","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#faq-co-host","content":"My co-host has the same message. What do they do?"},"834":{"id":"/product-docs/troubleshooting/camera-not-detected-13","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#still-stuck","content":"Still stuck?"},"835":{"id":"/product-docs/troubleshooting/camera-not-detected-14","page_id":"/product-docs/troubleshooting/camera-not-detected","type":"heading","tags":[],"url":"/product-docs/troubleshooting/camera-not-detected#next-steps","content":"Next steps"},"836":{"id":"/product-docs/troubleshooting/camera-not-detected-15","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#symptom","content":"When you click **Enter Room** from a webinar's Overview tab, the device check asks you to choose your camera, microphone and speakers, then shows:"},"837":{"id":"/product-docs/troubleshooting/camera-not-detected-16","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#symptom","content":"> **Not able to access selected media device**"},"838":{"id":"/product-docs/troubleshooting/camera-not-detected-17","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#symptom","content":"and **Continue to Green Room** stays greyed out."},"839":{"id":"/product-docs/troubleshooting/camera-not-detected-18","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#why","content":"The live room needs a working **camera and microphone** before it lets you into the green room. The button stays greyed out until the room can see both. You can turn them off once you are in, but you can't enter without them."},"840":{"id":"/product-docs/troubleshooting/camera-not-detected-19","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#why","content":"The message appears when the room can't open the camera or microphone you selected."},"841":{"id":"/product-docs/troubleshooting/camera-not-detected-20","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#fix","content":"Work through these in order and check the device preview after each one."},"842":{"id":"/product-docs/troubleshooting/camera-not-detected-21","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#fix","content":"**Allow camera and microphone access** for EasyWebinar when your browser asks. If you blocked it earlier, change the site's camera and microphone permission in your browser settings, then reload the page."},"843":{"id":"/product-docs/troubleshooting/camera-not-detected-22","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#fix","content":"**Close other apps that are using the camera**, such as another video-call tool, then reload."},"844":{"id":"/product-docs/troubleshooting/camera-not-detected-23","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#fix","content":"**Pick the right device** in the device check if you have more than one camera or microphone."},"845":{"id":"/product-docs/troubleshooting/camera-not-detected-24","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#verify","content":"The device check shows your camera preview and microphone, and **Continue to Green Room** becomes clickable. Nothing in the green room is broadcast; the header reads **Not Live** until you click **Go Live**."},"846":{"id":"/product-docs/troubleshooting/camera-not-detected-25","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#one-event-live","content":"This appears on **Enter Room** when another of your webinars is already live, because only one webinar can be live at a time. Join that one from its Overview tab, or go live with the new one."},"847":{"id":"/product-docs/troubleshooting/camera-not-detected-26","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#prevent","content":"Enter the room well before your start time. The green room broadcasts nothing, so you can pass the device check, finish your checks and test **Share** before anyone is watching. Close other video-call tools before you click **Enter Room**, so nothing else is holding the camera. For the kit itself, see the webinar equipment guide and this host preparation guide."},"848":{"id":"/product-docs/troubleshooting/camera-not-detected-27","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#faq-camera-off","content":"Not at first. A camera and microphone are required to enter, even if you turn them off afterwards with the **Camera** and **Mic** controls in the green room."},"849":{"id":"/product-docs/troubleshooting/camera-not-detected-28","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#faq-attendees-see","content":"No. Nothing in the green room is broadcast, and the header reads **Not Live** until you click **Go Live**."},"850":{"id":"/product-docs/troubleshooting/camera-not-detected-29","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#faq-switch-device","content":"Yes. Click **Settings** in the room's top bar; **Device settings** covers camera, audio and recording."},"851":{"id":"/product-docs/troubleshooting/camera-not-detected-30","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#faq-co-host","content":"The same fixes apply on their computer. Co-hosts and moderators who get in land backstage, not on stage, so your audience doesn't see or hear them until you bring them on. A guest co-host or moderator joins with the Co-presenter Join Link or the Moderator Join Link from the Share dialog."},"852":{"id":"/product-docs/troubleshooting/camera-not-detected-31","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#still-stuck","content":"Contact EasyWebinar support with the webinar name, the browser you are using and a screenshot of the message. Don't send passwords."},"853":{"id":"/product-docs/troubleshooting/camera-not-detected-32","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#next-steps","content":"Create and schedule a live webinar: set up the session you'll be entering the room for."},"854":{"id":"/product-docs/troubleshooting/camera-not-detected-33","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#next-steps","content":"Team members and roles: who joins as a co-host or moderator, and how they get in."},"855":{"id":"/product-docs/troubleshooting/camera-not-detected-34","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#next-steps","content":"Run a live webinar: what happens after the green room, from going live to ending the session."},"856":{"id":"/product-docs/troubleshooting/camera-not-detected-35","page_id":"/product-docs/troubleshooting/camera-not-detected","tags":[],"type":"text","url":"/product-docs/troubleshooting/camera-not-detected#next-steps","content":"Live webinars on EasyWebinar: what the live webinar type is built for."},"857":{"id":"/product-docs/use-cases/sell-courses","page_id":"/product-docs/use-cases/sell-courses","type":"page","content":"Selling online courses with webinars","breadcrumbs":["EasyWebinar documentation","Use cases"],"tags":[],"url":"/product-docs/use-cases/sell-courses"},"858":{"id":"/product-docs/use-cases/sell-courses-0","page_id":"/product-docs/use-cases/sell-courses","tags":[],"type":"text","url":"/product-docs/use-cases/sell-courses","content":"How course creators use EasyWebinar to sell a course through a webinar, live or automated, from building the webinar to following up and measuring sales."},"859":{"id":"/product-docs/use-cases/sell-courses-1","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#at-a-glance","content":"At a glance"},"860":{"id":"/product-docs/use-cases/sell-courses-2","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#where-it-fits","content":"Where EasyWebinar fits"},"861":{"id":"/product-docs/use-cases/sell-courses-3","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#fits-what-its-for","content":"What it's for"},"862":{"id":"/product-docs/use-cases/sell-courses-4","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#fits-how-it-helps","content":"How it helps"},"863":{"id":"/product-docs/use-cases/sell-courses-5","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#fits-without-it","content":"What happens without it"},"864":{"id":"/product-docs/use-cases/sell-courses-6","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#fits-why","content":"Why course creators care"},"865":{"id":"/product-docs/use-cases/sell-courses-7","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#approach","content":"The EasyWebinar approach to selling courses"},"866":{"id":"/product-docs/use-cases/sell-courses-8","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#which-webinar-type","content":"Which webinar type to use"},"867":{"id":"/product-docs/use-cases/sell-courses-9","page_id":"/product-docs/use-cases/sell-courses","type":"heading","tags":[],"url":"/product-docs/use-cases/sell-courses#bu