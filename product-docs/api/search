hout it"},"8495":{"id":"/product-docs/webinars/notifications/reminder-emails-7","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#why-buyers-care","content":"Why buyers care"},"8496":{"id":"/product-docs/webinars/notifications/reminder-emails-8","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#approach","content":"The EasyWebinar approach to reminder emails"},"8497":{"id":"/product-docs/webinars/notifications/reminder-emails-9","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#set-it-up","content":"Set it up"},"8498":{"id":"/product-docs/webinars/notifications/reminder-emails-10","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#find-reminders","content":"Find your reminders"},"8499":{"id":"/product-docs/webinars/notifications/reminder-emails-11","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#edit-reminder","content":"Edit a reminder"},"8500":{"id":"/product-docs/webinars/notifications/reminder-emails-12","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#add-reminder","content":"Add another reminder"},"8501":{"id":"/product-docs/webinars/notifications/reminder-emails-13","page_id":"/product-docs/webinars/notifications/reminder-emails","type":"heading","tags":[],"url":"/product-docs/webinars/notifications/reminder-emails#sensible-schedule","content":"A sensible schedule"},"8502":{"id":"/product-docs/webinars/notifications/reminder-emails-14","page_id":"/product-d