emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#law-uk","content":"United Kingdom: a stated purpose"},"3796":{"id":"/product-docs/use-cases/webinar-invitation-emails-22","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#law-gmail","content":"Gmail: unsubscribe and spam rates"},"3797":{"id":"/product-docs/use-cases/webinar-invitation-emails-23","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#by-hand","content":"How to send a webinar invitation by hand"},"3798":{"id":"/product-docs/use-cases/webinar-invitation-emails-24","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#same-job","content":"The same job in EasyWebinar"},"3799":{"id":"/product-docs/use-cases/webinar-invitation-emails-25","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#build-it","content":"Send your webinar invitation in EasyWebinar"},"3800":{"id":"/product-docs/use-cases/webinar-invitation-emails-26","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#sending-first","content":"Set up sending first"},"3801":{"id":"/product-docs/use-cases/webinar-invitation-emails-27","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#copy-link","content":"Copy the registration link"},"3802":{"id":"/product-docs/use-cases/webinar-invitation-emails-28","page_id":"/product-docs/use-cases/webinar-invitation-emails","type":"heading","tags":[],"url":"/product-docs/use-cases/webinar-invitation-emails#build-list","cont