,"7190":{"id":"/product-docs/webinars/live-room/green-room-12","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#read-the-room","content":"3. Read the room"},"7191":{"id":"/product-docs/webinars/live-room/green-room-13","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#manage-backstage","content":"4. Bring people backstage and onto the stage"},"7192":{"id":"/product-docs/webinars/live-room/green-room-14","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#final-checks","content":"5. Finish your checks"},"7193":{"id":"/product-docs/webinars/live-room/green-room-15","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#leave-the-green-room","content":"6. Leave the green room"},"7194":{"id":"/product-docs/webinars/live-room/green-room-16","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#works-with","content":"How the green room works with other features"},"7195":{"id":"/product-docs/webinars/live-room/green-room-17","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#with-team-members","content":"Team members and roles"},"7196":{"id":"/product-docs/webinars/live-room/green-room-18","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#with-share-links","content":"Share links"},"7197":{"id":"/product-docs/webinars/live-room/green-room-19","page_id":"/product-docs/webinars/live-room/green-room","type":"heading","tags":[],"url":"/product-docs/webinars/live-room/green-room#with-easycast","content":"EasyCast