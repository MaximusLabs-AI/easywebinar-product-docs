gagement/chat-simulation#with-attendee-list","content":"The attendee list"},"5473":{"id":"/product-docs/webinars/engagement/chat-simulation-21","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#with-qa","content":"Q&A"},"5474":{"id":"/product-docs/webinars/engagement/chat-simulation-22","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#with-evergreen","content":"Evergreen schedules"},"5475":{"id":"/product-docs/webinars/engagement/chat-simulation-23","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#with-simulive","content":"Simulive webinars"},"5476":{"id":"/product-docs/webinars/engagement/chat-simulation-24","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#who-uses-it","content":"Who uses chat simulation, and how"},"5477":{"id":"/product-docs/webinars/engagement/chat-simulation-25","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#course-creators","content":"Course creators"},"5478":{"id":"/product-docs/webinars/engagement/chat-simulation-26","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#solo-operators","content":"Small businesses and solo operators"},"5479":{"id":"/product-docs/webinars/engagement/chat-simulation-27","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#product-teams","content":"SaaS and product teams"},"5480":{"id":"/product-docs/webinars/engagement/chat-simulation-28","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#agencies","content":"Agencies"},"5481":{"id":"/product-docs/webinars/engagement/chat-simulation-29","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"How chat simulation compares"},"5482":{"id":"/product-docs/webinars/engagement/chat-simulation-30","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#compare-stronger","content":"Why EasyWebinar is the stronger choice for chat simulation"},"5483":{"id":"/product-docs/webinars/engagement/chat-simulation-31","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"Limits and things to know"},"5484":{"id":"/product-docs/webinars/engagement/chat-simulation-32","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#common-questions","content":"Common questions"},"5485":{"id":"/product-docs/webinars/engagement/chat-simulation-33","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-why","content":"Why would I simulate chat?"},"5486":{"id":"/product-docs/webinars/engagement/chat-simulation-34","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-live","content":"Does chat simulation work on a live webinar?"},"5487":{"id":"/product-docs/webinars/engagement/chat-simulation-35","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-both","content":"Can I use AI and manual simulation together?"},"5488":{"id":"/product-docs/webinars/engagement/chat-simulation-36","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-csv-format","content":"What format does the CSV need?"},"5489":{"id":"/product-docs/webinars/engagement/chat-simulation-37","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-roles","content":"What roles can I use in the script?"},"5490":{"id":"/product-docs/webinars/engagement/chat-simulation-38","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-timing","content":"When do scripted messages appear?"},"5491":{"id":"/product-docs/webinars/engagement/chat-simulation-39","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-preview","content":"Can I see the chat before attendees do?"},"5492":{"id":"/product-docs/webinars/engagement/chat-simulation-40","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-ai-attributes","content":"What can I set for each AI-simulated attendee?"},"5493":{"id":"/product-docs/webinars/engagement/chat-simulation-41","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-varies","content":"Will the AI chat be the same in every session?"},"5494":{"id":"/product-docs/webinars/engagement/chat-simulation-42","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-attendee-list","content":"Can simulated attendees appear in the attendee list?"},"5495":{"id":"/product-docs/webinars/engagement/chat-simulation-43","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#faq-third-party","content":"Does it work with a third-party chat tool?"},"5496":{"id":"/product-docs/webinars/engagement/chat-simulation-44","page_id":"/product-docs/webinars/engagement/chat-simulation","type":"heading","tags":[],"url":"/product-docs/webinars/engagement/chat-simulation#related","content":"Related"},"5497":{"id":"/product-docs/webinars/engagement/chat-simulation-45","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation","content":"Chat simulation plays a conversation in the chat of a recorded webinar, so a session doesn't open to an empty room. In EasyWebinar you set it up on a simulive or evergreen webinar's **Engagement** tab, under **Chat Simulation**, in one of two ways. **AI Simulation** builds a cast of simulated attendees and generates their chat and questions. **Manual Simulation** plays a script you write in a CSV, with each message timed against your video. The Chat Simulation section carries a **Beta** label in the app."},"5498":{"id":"/product-docs/webinars/engagement/chat-simulation-46","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                  |                                                  |\n| ---------------- | ------------------------------------------------ |\n| **What it does** | Plays a simulated chat during a recorded webinar |","table":"table-0"},"5499":{"id":"/product-docs/webinars/engagement/chat-simulation-47","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                   |                                                      |\n| ----------------- | ---------------------------------------------------- |\n| **Webinar types** | Simulive and evergreen. Live webinars have real chat |","table":"table-0"},"5500":{"id":"/product-docs/webinars/engagement/chat-simulation-48","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                      |                                                |\n| -------------------- | ---------------------------------------------- |\n| **Where you set it** | Webinar → **Engagement** → **Chat Simulation** |","table":"table-0"},"5501":{"id":"/product-docs/webinars/engagement/chat-simulation-49","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|               |                                                                               |\n| ------------- | ----------------------------------------------------------------------------- |\n| **Two modes** | **AI Simulation** or **Manual Simulation**; turning one on disables the other |","table":"table-0"},"5502":{"id":"/product-docs/webinars/engagement/chat-simulation-50","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                   |                                                                                                       |\n| ----------------- | ----------------------------------------------------------------------------------------------------- |\n| **AI Simulation** | A cast of simulated attendees, each with name, country, engagement, knowledge, language and behaviour |","table":"table-0"},"5503":{"id":"/product-docs/webinars/engagement/chat-simulation-51","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                       |                                                       |\n| --------------------- | ----------------------------------------------------- |\n| **Manual Simulation** | A CSV with four columns: `HH:MM:SS,Name,Role,Message` |","table":"table-0"},"5504":{"id":"/product-docs/webinars/engagement/chat-simulation-52","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                    |                                      |\n| ------------------ | ------------------------------------ |\n| **Message timing** | Measured from the start of the video |","table":"table-0"},"5505":{"id":"/product-docs/webinars/engagement/chat-simulation-53","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                       |                                                              |\n| --------------------- | ------------------------------------------------------------ |\n| **Roles in a script** | `Attendee` or `Admin`; Admin messages appear as host replies |","table":"table-0"},"5506":{"id":"/product-docs/webinars/engagement/chat-simulation-54","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|                   |                                                                    |\n| ----------------- | ------------------------------------------------------------------ |\n| **Chat required** | **Easywebinar Chat**; third-party chat replaces the built-in panel |","table":"table-0"},"5507":{"id":"/product-docs/webinars/engagement/chat-simulation-55","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#at-a-glance","content":"|            |      |\n| ---------- | ---- |\n| **Status** | Beta |","table":"table-0"},"5508":{"id":"/product-docs/webinars/engagement/chat-simulation-56","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#what-it-is","content":"A live webinar has a shared room: everyone is there at the same time, so the chat fills itself. An evergreen webinar doesn't. Each registrant picks their own session, attendees arrive at different times, and a genuinely shared chat isn't possible. Without anything in it, the chat panel looks abandoned."},"5509":{"id":"/product-docs/webinars/engagement/chat-simulation-57","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#what-it-is","content":"Chat simulation solves that by playing messages into the chat at set points in the video. You choose how those messages are made:"},"5510":{"id":"/product-docs/webinars/engagement/chat-simulation-58","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#what-it-is","content":"**AI Simulation**: you describe a cast of attendees, and the AI generates what they say."},"5511":{"id":"/product-docs/webinars/engagement/chat-simulation-59","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#what-it-is","content":"**Manual Simulation**: you write every line yourself, with a timestamp, a name and a role."},"5512":{"id":"/product-docs/webinars/engagement/chat-simulation-60","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#what-it-is","content":"Only one can be active on a webinar at a time."},"5513":{"id":"/product-docs/webinars/engagement/chat-simulation-61","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#what-its-for","content":"Chat simulation gives a recorded webinar the feel of an attended session. A greeting in the first seconds, a question a few minutes in and a host reply tell a newcomer the room is active. That impression keeps people watching long enough for the content to work."},"5514":{"id":"/product-docs/webinars/engagement/chat-simulation-62","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#how-it-helps","content":"**The room never opens empty.** Messages can appear within seconds of the video starting."},"5515":{"id":"/product-docs/webinars/engagement/chat-simulation-63","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#how-it-helps","content":"**It plays in every session.** On an evergreen webinar that runs all day, the same setup plays each time without you."},"5516":{"id":"/product-docs/webinars/engagement/chat-simulation-64","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#how-it-helps","content":"**You choose how much control to keep.** **AI Simulation** fills a room naturally, while **Manual Simulation** plays exactly what you wrote."},"5517":{"id":"/product-docs/webinars/engagement/chat-simulation-65","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#how-it-helps","content":"**Common questions get answered in view.** A scripted question with an `Admin` reply puts an objection and its answer in front of everyone."},"5518":{"id":"/product-docs/webinars/engagement/chat-simulation-66","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#without-it","content":"On a recorded webinar with an empty chat, the first impression is a room nobody else came to. Attendees already suspect they may be watching a recording, and a silent panel confirms it. Many leave before the content has had a chance to work."},"5519":{"id":"/product-docs/webinars/engagement/chat-simulation-67","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#why-buyers-care","content":"It matters to anyone who relies on evergreen webinars inside a funnel, where nobody presents live. Those teams need the automated session to hold attention the way a live one does, most of all when it plays many times a day."},"5520":{"id":"/product-docs/webinars/engagement/chat-simulation-68","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#approach","content":"Take a typical case. A novelist is launching a monthly online book club for readers of literary fiction. She records a 30-minute introduction to the club and runs it as an evergreen webinar, linked from her newsletter. She expects around 40 viewers a day, spread across several sessions."},"5521":{"id":"/product-docs/webinars/engagement/chat-simulation-69","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#approach","content":"A common approach is to leave the chat on and hope viewers start talking. In practice, people who arrive alone tend to stay quiet, so each one sees an empty panel. Questions about reading pace and meeting times may go unasked, and some readers leave unsure whether the club suits them."},"5522":{"id":"/product-docs/webinars/engagement/chat-simulation-70","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#approach","content":"Nothing about the video has to change. What helps is a chat that raises the questions readers usually ask, at the moment the video covers them, with an answer from the host. A room with a few voices also reads as a club that people actually join."},"5523":{"id":"/product-docs/webinars/engagement/chat-simulation-71","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#approach","content":"EasyWebinar handles this with Chat Simulation (Beta) on the webinar's **Engagement** tab. The author picks **Manual Simulation** and uploads a CSV of timed messages. In the script, `Attendee` lines ask about pace and meeting times, and `Admin` lines answer as the host. **Preview Simulated Chat** shows the whole conversation before she saves."},"5524":{"id":"/product-docs/webinars/engagement/chat-simulation-72","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#approach","content":"The screenshot under Set up Manual Simulation shows the CSV upload beside **Preview Simulated Chat** and **Attendees on Event Page**. How other platforms handle simulated chat is covered in How chat simulation compares, below."},"5525":{"id":"/product-docs/webinars/engagement/chat-simulation-73","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#before-you-begin","content":"**Use a simulive or evergreen webinar.** Chat simulation isn't available on live webinars."},"5526":{"id":"/product-docs/webinars/engagement/chat-simulation-74","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#before-you-begin","content":"**Select Easywebinar Chat** on **Engagement** → **Chat**. Simulated chat works with EasyWebinar's own chat panel; **Third party** replaces it."},"5527":{"id":"/product-docs/webinars/engagement/chat-simulation-75","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#before-you-begin","content":"**Know your video.** For a manual script, you'll time messages against the recording, so have it to hand."},"5528":{"id":"/product-docs/webinars/engagement/chat-simulation-76","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Open your simulive or evergreen webinar and click **Engagement**, then **Chat Simulation**."},"5529":{"id":"/product-docs/webinars/engagement/chat-simulation-77","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Under **AI Simulation**, use **Add New** to create a simulation, or pick a saved one from the selector."},"5530":{"id":"/product-docs/webinars/engagement/chat-simulation-78","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Turn the simulation on with its **Active** toggle. This disables Manual Simulation."},"5531":{"id":"/product-docs/webinars/engagement/chat-simulation-79","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Review the attendee list and adjust each simulated attendee."},"5532":{"id":"/product-docs/webinars/engagement/chat-simulation-80","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Click **Add Attendee** to add more people to the cast."},"5533":{"id":"/product-docs/webinars/engagement/chat-simulation-81","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Check the counts for attendees, chat messages and questions."},"5534":{"id":"/product-docs/webinars/engagement/chat-simulation-82","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"Click **Save Changes**."},"5535":{"id":"/product-docs/webinars/engagement/chat-simulation-83","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"*1 Simulation selector · 2 Active toggle · 3 Attendees · Chat · Questions · 4 The attendee list.*"},"5536":{"id":"/product-docs/webinars/engagement/chat-simulation-84","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"|     | Area                    | What it does                             |\n| --- | ----------------------- | ---------------------------------------- |\n| 1   | **Simulation selector** | Your saved simulations, with **Add New** |","table":"table-1"},"5537":{"id":"/product-docs/webinars/engagement/chat-simulation-85","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"|     | Area              | What it does             |\n| --- | ----------------- | ------------------------ |\n| 2   | **Active toggle** | Turns this simulation on |","table":"table-1"},"5538":{"id":"/product-docs/webinars/engagement/chat-simulation-86","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"|     | Area                             | What it does                |\n| --- | -------------------------------- | --------------------------- |\n| 3   | **Attendees · Chat · Questions** | How much has been generated |","table":"table-1"},"5539":{"id":"/product-docs/webinars/engagement/chat-simulation-87","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-ai-simulation","content":"|     | Area                  | What it does                              |\n| --- | --------------------- | ----------------------------------------- |\n| 4   | **The attendee list** | Each simulated person and how they behave |","table":"table-1"},"5540":{"id":"/product-docs/webinars/engagement/chat-simulation-88","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#attendee-attributes","content":"| Attribute            | What it controls      |\n| -------------------- | --------------------- |\n| **Name** and country | Who they appear to be |","table":"table-2"},"5541":{"id":"/product-docs/webinars/engagement/chat-simulation-89","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#attendee-attributes","content":"| Attribute      | What it controls                         |\n| -------------- | ---------------------------------------- |\n| **Engagement** | How often they post: High, Medium or Low |","table":"table-2"},"5542":{"id":"/product-docs/webinars/engagement/chat-simulation-90","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#attendee-attributes","content":"| Attribute     | What it controls                                    |\n| ------------- | --------------------------------------------------- |\n| **Knowledge** | How expert they sound, from Beginner through Expert |","table":"table-2"},"5543":{"id":"/product-docs/webinars/engagement/chat-simulation-91","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#attendee-attributes","content":"| Attribute    | What it controls   |\n| ------------ | ------------------ |\n| **Language** | What they write in |","table":"table-2"},"5544":{"id":"/product-docs/webinars/engagement/chat-simulation-92","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#attendee-attributes","content":"| Attribute    | What it controls                                            |\n| ------------ | ----------------------------------------------------------- |\n| **Behavior** | Their character, such as Curious, Sceptical or Enthusiastic |","table":"table-2"},"5545":{"id":"/product-docs/webinars/engagement/chat-simulation-93","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#believable-cast","content":"The mix of attendees decides whether the chat reads as real. A room full of enthusiastic experts posting constantly looks staged. A few beginners asking basic questions, one sceptic, a couple of quiet observers on low engagement and some mid-level regulars looks like an audience."},"5546":{"id":"/product-docs/webinars/engagement/chat-simulation-94","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#believable-cast","content":"A useful check: look down the attendee list as a newcomer would meet that room. If almost everyone is an enthusiastic expert on high engagement, add curious and sceptical attendees, and move some of the most active ones to Medium or Low."},"5547":{"id":"/product-docs/webinars/engagement/chat-simulation-95","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Open your simulive or evergreen webinar and click **Engagement**, then **Chat Simulation**."},"5548":{"id":"/product-docs/webinars/engagement/chat-simulation-96","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Select **Manual Simulation** and make it active. This disables AI Simulation."},"5549":{"id":"/product-docs/webinars/engagement/chat-simulation-97","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Click **Download sample CSV** to get the template."},"5550":{"id":"/product-docs/webinars/engagement/chat-simulation-98","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Write your script in the four columns and save the file as **CSV (UTF-8)**."},"5551":{"id":"/product-docs/webinars/engagement/chat-simulation-99","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Drag the file onto the upload area, or use **Choose File**."},"5552":{"id":"/product-docs/webinars/engagement/chat-simulation-100","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Add the names for **Attendees on Event Page**, separated by commas."},"5553":{"id":"/product-docs/webinars/engagement/chat-simulation-101","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Read through **Preview Simulated Chat**."},"5554":{"id":"/product-docs/webinars/engagement/chat-simulation-102","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"Click **Save Changes**."},"5555":{"id":"/product-docs/webinars/engagement/chat-simulation-103","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"| Area                            | What it does           |\n| ------------------------------- | ---------------------- |\n| **Simulated Chat (CSV upload)** | Your scripted messages |","table":"table-3"},"5556":{"id":"/product-docs/webinars/engagement/chat-simulation-104","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"| Area                       | What it does                                 |\n| -------------------------- | -------------------------------------------- |\n| **Preview Simulated Chat** | Exactly how the chat will appear in the room |","table":"table-3"},"5557":{"id":"/product-docs/webinars/engagement/chat-simulation-105","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#set-up-manual-simulation","content":"| Area                        | What it does                                            |\n| --------------------------- | ------------------------------------------------------- |\n| **Attendees on Event Page** | Names shown in the attendee list, added comma-separated |","table":"table-3"},"5558":{"id":"/product-docs/webinars/engagement/chat-simulation-106","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#csv-format","content":"| Column       | What it holds                                                  |\n| ------------ | -------------------------------------------------------------- |\n| **HH:MM:SS** | When the message appears, measured from the start of the video |","table":"table-4"},"5559":{"id":"/product-docs/webinars/engagement/chat-simulation-107","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#csv-format","content":"| Column   | What it holds |\n| -------- | ------------- |\n| **Name** | Who posts it  |","table":"table-4"},"5560":{"id":"/product-docs/webinars/engagement/chat-simulation-108","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#csv-format","content":"| Column   | What it holds                                                  |\n| -------- | -------------------------------------------------------------- |\n| **Role** | `Attendee` or `Admin`. `Admin` messages appear as host replies |","table":"table-4"},"5561":{"id":"/product-docs/webinars/engagement/chat-simulation-109","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#csv-format","content":"| Column      | What it holds                                             |\n| ----------- | --------------------------------------------------------- |\n| **Message** | The text. Wrap it in double quotes if it contains a comma |","table":"table-4"},"5562":{"id":"/product-docs/webinars/engagement/chat-simulation-110","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#csv-format","content":"A short script looks like this:"},"5563":{"id":"/product-docs/webinars/engagement/chat-simulation-111","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#write-the-script","content":"**Line messages up with the video.** A question about a slide should land while that slide is on screen."},"5564":{"id":"/product-docs/webinars/engagement/chat-simulation-112","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#write-the-script","content":"**Open early.** A message in the first few seconds tells new arrivals the room is active."},"5565":{"id":"/product-docs/webinars/engagement/chat-simulation-113","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#write-the-script","content":"**Mix the roles.** Attendee questions answered by `Admin` replies read as a conversation. Attendee messages alone read as a wall."},"5566":{"id":"/product-docs/webinars/engagement/chat-simulation-114","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#write-the-script","content":"**Let it breathe.** Real chat comes in bursts with quiet stretches, not one message every thirty seconds."},"5567":{"id":"/product-docs/webinars/engagement/chat-simulation-115","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#write-the-script","content":"**Check the preview.** It shows timestamps, names and roles as attendees will see them."},"5568":{"id":"/product-docs/webinars/engagement/chat-simulation-116","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#which-to-use","content":"|                | AI Simulation | Manual Simulation                    |\n| -------------- | ------------- | ------------------------------------ |\n| **Setup time** | Minutes       | Longer, because you write every line |","table":"table-5"},"5569":{"id":"/product-docs/webinars/engagement/chat-simulation-117","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#which-to-use","content":"|             | AI Simulation               | Manual Simulation      |\n| ----------- | --------------------------- | ---------------------- |\n| **Control** | The AI decides what is said | Exactly what you wrote |","table":"table-5"},"5570":{"id":"/product-docs/webinars/engagement/chat-simulation-118","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#which-to-use","content":"|                        | AI Simulation | Manual Simulation        |\n| ---------------------- | ------------- | ------------------------ |\n| **Varies per session** | Yes           | No, identical every time |","table":"table-5"},"5571":{"id":"/product-docs/webinars/engagement/chat-simulation-119","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#which-to-use","content":"|              | AI Simulation            | Manual Simulation         |\n| ------------ | ------------------------ | ------------------------- |\n| **Best for** | Filling a room naturally | A rehearsed, scripted run |","table":"table-5"},"5572":{"id":"/product-docs/webinars/engagement/chat-simulation-120","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#use-honestly","content":"Simulated chat is there to stop an automated room looking empty. It isn't a place for social proof that didn't happen."},"5573":{"id":"/product-docs/webinars/engagement/chat-simulation-121","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#use-honestly","content":"**No invented testimonials.** Simulated attendees shouldn't claim results or endorse your product."},"5574":{"id":"/product-docs/webinars/engagement/chat-simulation-122","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#use-honestly","content":"**Don't impersonate real customers.** A simulated message shouldn't pass itself off as something a real customer said."},"5575":{"id":"/product-docs/webinars/engagement/chat-simulation-123","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#use-honestly","content":"**Keep host answers accurate.** An `Admin` reply is read as your answer, so it should be one you'd give live."},"5576":{"id":"/product-docs/webinars/engagement/chat-simulation-124","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#with-chat","content":"With **Easywebinar Chat** selected, a recorded webinar's Chat screen offers **Simulated Chat**, which plays back a pre-written chat during the webinar, and **Simulated Attendees**, which shows a simulated attendee list in the room. The script, attendee count and names are set on the Chat Simulation tab. Choosing **Third party** replaces the built-in chat, so simulation stops applying."},"5577":{"id":"/product-docs/webinars/engagement/chat-simulation-125","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#with-attendee-list","content":"Simulated attendees can show in the attendee list too, with **Show attendee list on event page**. The webinar-wide **Show Attendees** setting on the **Settings** tab controls whether attendees see the list at all."},"5578":{"id":"/product-docs/webinars/engagement/chat-simulation-126","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#with-qa","content":"For an automated webinar that should still feel busy, pair **Everyone** chat and Chat Simulation with **Private Q&A**, so real questions reach your team in a queue."},"5579":{"id":"/product-docs/webinars/engagement/chat-simulation-127","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#with-evergreen","content":"Chat simulation suits evergreen webinars running just-in-time or on demand sessions, where attendees arrive in ones and twos at all hours."},"5580":{"id":"/product-docs/webinars/engagement/chat-simulation-128","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#with-simulive","content":"On a simulive webinar, everyone in a session watches the same moment, so real chat works and you can answer live while the recording plays. Chat Simulation is available on simulive webinars as well as evergreen ones."},"5581":{"id":"/product-docs/webinars/engagement/chat-simulation-129","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#who-uses-it","content":"These are typical patterns, to show how the two modes fit different automated webinars."},"5582":{"id":"/product-docs/webinars/engagement/chat-simulation-130","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#course-creators","content":"A creator turns their best live session into an evergreen webinar and writes a manual script from the questions people really asked live, with `Admin` replies that match the answers they gave. Every session plays the same tested conversation."},"5583":{"id":"/product-docs/webinars/engagement/chat-simulation-131","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#solo-operators","content":"A solo operator without time to script uses AI Simulation, builds a cast with a mix of beginners, a sceptic and quieter observers, and reviews the cast before turning the simulation on."},"5584":{"id":"/product-docs/webinars/engagement/chat-simulation-132","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#product-teams","content":"A product team runs an on-demand demo. A manual script places a short exchange about integrations at the point in the video where integrations come up, so the answer appears just as viewers are wondering."},"5585":{"id":"/product-docs/webinars/engagement/chat-simulation-133","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#agencies","content":"An agency building evergreen funnels for several clients uses AI Simulation to set up each room quickly, then switches individual webinars to Manual Simulation once a client wants a fixed, approved script."},"5586":{"id":"/product-docs/webinars/engagement/chat-simulation-134","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"EasyWebinar's Chat Simulation (Beta) can write the chat with AI or play a script you upload as a CSV. It can also add simulated names to the attendee list. EasyWebinar is the only platform in this table that does all three."},"5587":{"id":"/product-docs/webinars/engagement/chat-simulation-135","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"Simulated chat features, from each platform's public documentation:"},"5588":{"id":"/product-docs/webinars/engagement/chat-simulation-136","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"| Platform        | Chat written by AI | Scripted chat from a CSV | Simulated names in the attendee list |\n| --------------- | ------------------ | ------------------------ | ------------------------------------ |\n| **EasyWebinar** | Yes                | Yes                      | Yes                                  |","table":"table-6"},"5589":{"id":"/product-docs/webinars/engagement/chat-simulation-137","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"| Platform                       | Chat written by AI | Scripted chat from a CSV | Simulated names in the attendee list |\n| ------------------------------ | ------------------ | ------------------------ | ------------------------------------ |\n| **WebinarJam and EverWebinar** | Not in docs        | Yes (EverWebinar)        | Not in docs                          |","table":"table-6"},"5590":{"id":"/product-docs/webinars/engagement/chat-simulation-138","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"| Platform       | Chat written by AI           | Scripted chat from a CSV | Simulated names in the attendee list |\n| -------------- | ---------------------------- | ------------------------ | ------------------------------------ |\n| **WebinarKit** | Partly (marketing page only) | Yes (detail)             | Not in docs                          |","table":"table-6"},"5591":{"id":"/product-docs/webinars/engagement/chat-simulation-139","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"| Platform           | Chat written by AI | Scripted chat from a CSV | Simulated names in the attendee list |\n| ------------------ | ------------------ | ------------------------ | ------------------------------------ |\n| **StealthSeminar** | Not in docs        | Yes (Chat Replay import) | Yes (detail)                         |","table":"table-6"},"5592":{"id":"/product-docs/webinars/engagement/chat-simulation-140","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"| Platform  | Chat written by AI | Scripted chat from a CSV | Simulated names in the attendee list |\n| --------- | ------------------ | ------------------------ | ------------------------------------ |\n| **Demio** | Not in docs        | Not in docs              | Not in docs                          |","table":"table-6"},"5593":{"id":"/product-docs/webinars/engagement/chat-simulation-141","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"5594":{"id":"/product-docs/webinars/engagement/chat-simulation-142","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare-stronger","content":"**A chat the AI writes for you.** EasyWebinar's **AI Simulation** (Beta) generates chat and questions from a cast with set engagement, knowledge, language and behaviour. StealthSeminar's Chat Replay is built from messages you add or import. More detail in EasyWebinar vs StealthSeminar."},"5595":{"id":"/product-docs/webinars/engagement/chat-simulation-143","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare-stronger","content":"**Host replies inside the script.** EasyWebinar's CSV has a **Role** column, so `Admin` lines appear as host replies. WebinarKit's chat simulator documents a username, message text and display time for each message. More detail in EasyWebinar vs WebinarKit."},"5596":{"id":"/product-docs/webinars/engagement/chat-simulation-144","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare-stronger","content":"**Names in the attendee list as well.** **Attendees on Event Page** adds simulated names to the list attendees see. EverWebinar's help centre covers preloaded chat messages, with no simulated attendee list documented. More detail in EasyWebinar vs WebinarJam and EverWebinar."},"5597":{"id":"/product-docs/webinars/engagement/chat-simulation-145","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare-stronger","content":"**Part of the webinar itself.** Chat Simulation (Beta) sits on the same **Engagement** tab as chat and Q&A. Demio's help centre doesn't document simulated chat. More detail in EasyWebinar vs Demio."},"5598":{"id":"/product-docs/webinars/engagement/chat-simulation-146","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 21 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"5599":{"id":"/product-docs/webinars/engagement/chat-simulation-147","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**Recorded webinars only.** Live webinars have real chat."},"5600":{"id":"/product-docs/webinars/engagement/chat-simulation-148","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**One mode at a time.** Turning on AI Simulation disables Manual Simulation, and the reverse."},"5601":{"id":"/product-docs/webinars/engagement/chat-simulation-149","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**It needs the built-in chat.** Third-party chat replaces EasyWebinar's panel."},"5602":{"id":"/product-docs/webinars/engagement/chat-simulation-150","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**AI chat varies between sessions; a manual script doesn't.**"},"5603":{"id":"/product-docs/webinars/engagement/chat-simulation-151","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**CSV files must be UTF-8**, with commas inside messages wrapped in double quotes."},"5604":{"id":"/product-docs/webinars/engagement/chat-simulation-152","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**Timestamps run from the start of the video**, not from the clock time of the session."},"5605":{"id":"/product-docs/webinars/engagement/chat-simulation-153","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**Changes apply when you click Save Changes.**"},"5606":{"id":"/product-docs/webinars/engagement/chat-simulation-154","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#limits","content":"**It's labelled Beta in the app.**"},"5607":{"id":"/product-docs/webinars/engagement/chat-simulation-155","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#faq-why","content":"On an automated webinar, attendees arrive at different times, so a genuine shared chat isn't possible. An empty panel makes the room look deserted."},"5608":{"id":"/product-docs/webinars/engagement/chat-simulation-156","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#faq-live","content":"No. Live webinars have real chat."},"5609":{"id":"/product-docs/webinars/engagement/chat-simulation-157","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#faq-both","content":"No. Turning one on disables the other."},"5610":{"id":"/product-docs/webinars/engagement/chat-simulation-158","page_id":"/product-docs/webinars/engagement/chat-simulation","tags":[],"type":"text","url":"/product-docs/webinars/engagement/chat-simulation#faq-csv-format","content":"Four columns, `HH:MM:SS,Name,Role,Message`, saved as UTF-8 CSV. **Download sa