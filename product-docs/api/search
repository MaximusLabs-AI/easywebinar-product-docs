-setup-22","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#worked-example","content":"Worked example: sizing the garden centre's first month"},"344":{"id":"/product-docs/easycrm/sending-setup-23","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#set-up","content":"How to set up webinar CRM email"},"345":{"id":"/product-docs/easycrm/sending-setup-24","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#what-to-have-ready","content":"What to have ready"},"346":{"id":"/product-docs/easycrm/sending-setup-25","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#open-configurations","content":"Open the Configurations screen"},"347":{"id":"/product-docs/easycrm/sending-setup-26","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#choose-service","content":"Choose an email service"},"348":{"id":"/product-docs/easycrm/sending-setup-27","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#verify-identity","content":"Verify who you send as"},"349":{"id":"/product-docs/easycrm/sending-setup-28","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#reply-forwarding","content":"Decide where replies go"},"350":{"id":"/product-docs/easycrm/sending-setup-29","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#call-sms","content":"Add call and SMS (Beta) sending"},"351":{"id":"/product-docs/easycrm/sending-setup-30","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#check-before-send","content":"Check sending before your first broadcast"},"352":{"id":"/product-docs/easycrm/sending-setup-31","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#first-results","content":"Read the first results"},"353":{"id":"/product-docs/easycrm/sending-setup-32","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"How sending health is measured"},"354":{"id":"/product-docs/easycrm/sending-setup-33","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#not-sending","content":"When CRM emails aren't sending"},"355":{"id":"/product-docs/easycrm/sending-setup-34","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"What this setup leaves alone"},"356":{"id":"/product-docs/easycrm/sending-setup-35","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#works-with","content":"What works with webinar CRM email setup"},"357":{"id":"/product-docs/easycrm/sending-setup-36","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#who-uses-it","content":"Who sets up webinar CRM email"},"358":{"id":"/product-docs/easycrm/sending-setup-37","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#who-small-business","content":"Small businesses and solo operators"},"359":{"id":"/product-docs/easycrm/sending-setup-38","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#who-b2b-marketing","content":"B2B marketing teams"},"360":{"id":"/product-docs/easycrm/sending-setup-39","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#who-coaches","content":"Coaches and consultants"},"361":{"id":"/product-docs/easycrm/sending-setup-40","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#who-agencies","content":"Agencies"},"362":{"id":"/product-docs/easycrm/sending-setup-41","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#compare","content":"How EasyWebinar compares for webinar CRM email sending"},"363":{"id":"/product-docs/easycrm/sending-setup-42","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#compare-stronger","content":"Why EasyWebinar is the stronger choice for webinar CRM email sending"},"364":{"id":"/product-docs/easycrm/sending-setup-43","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#limits","content":"Limits of this sending setup"},"365":{"id":"/product-docs/easycrm/sending-setup-44","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#common-questions","content":"Common questions"},"366":{"id":"/product-docs/easycrm/sending-setup-45","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-own-smtp","content":"Can I use my own SMTP provider?"},"367":{"id":"/product-docs/easycrm/sending-setup-46","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-need-domain","content":"Do I need my own domain to send broadcasts?"},"368":{"id":"/product-docs/easycrm/sending-setup-47","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-reminders","content":"Do these settings change my webinar reminder emails?"},"369":{"id":"/product-docs/easycrm/sending-setup-48","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-not-sending","content":"Why isn't my CRM email sending?"},"370":{"id":"/product-docs/easycrm/sending-setup-49","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-existing-crm","content":"Do I need EasyCRM if I already use HubSpot?"},"371":{"id":"/product-docs/easycrm/sending-setup-50","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-provider-account","content":"Do I need an account with the SMTP provider?"},"372":{"id":"/product-docs/easycrm/sending-setup-51","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-domain-or-address","content":"Should I verify a domain or a single address?"},"373":{"id":"/product-docs/easycrm/sending-setup-52","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-replies","content":"Where do replies to my broadcasts go?"},"374":{"id":"/product-docs/easycrm/sending-setup-53","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-easycrm-mail","content":"What is EasyCRM Mail?"},"375":{"id":"/product-docs/easycrm/sending-setup-54","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-sending-health","content":"Where do I check sending health?"},"376":{"id":"/product-docs/easycrm/sending-setup-55","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-call-sms","content":"What does call and SMS (Beta) setup involve?"},"377":{"id":"/product-docs/easycrm/sending-setup-56","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-separate-setup","content":"Do broadcasts and workflows need separate setup?"},"378":{"id":"/product-docs/easycrm/sending-setup-57","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-c-name","content":"Does my custom webinar page domain count for email?"},"379":{"id":"/product-docs/easycrm/sending-setup-58","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#faq-mailbox-rules","content":"Do mailbox providers require email authentication?"},"380":{"id":"/product-docs/easycrm/sending-setup-59","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#further-reading","content":"Further reading"},"381":{"id":"/product-docs/easycrm/sending-setup-60","page_id":"/product-docs/easycrm/sending-setup","type":"heading","tags":[],"url":"/product-docs/easycrm/sending-setup#related","content":"Related"},"382":{"id":"/product-docs/easycrm/sending-setup-61","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup","content":"Webinar CRM email sending has to be set up before a single broadcast or workflow can leave your account. The job has three parts: choose an email service, verify the domain or business address you send as, and decide where replies go. In EasyWebinar you do all of it once, on the **Configurations** screen of its built-in CRM, EasyCRM. A webinar's own confirmation and reminder emails aren't part of this setup, because each webinar has separate settings for them. It's your CRM or ours, so if you already run HubSpot, Salesforce Pardot or ActiveCampaign, you can keep it and skip this setup."},"383":{"id":"/product-docs/easycrm/sending-setup-62","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                     |                                                                                        |\n| ------------------- | -------------------------------------------------------------------------------------- |\n| **What you set up** | The email service, sending identity and reply address for CRM broadcasts and workflows |","table":"table-0"},"384":{"id":"/product-docs/easycrm/sending-setup-63","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                      |                                                      |\n| -------------------- | ---------------------------------------------------- |\n| **Where you set it** | EasyCRM → **Configurations** → **Email Integration** |","table":"table-0"},"385":{"id":"/product-docs/easycrm/sending-setup-64","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                                  |                                                                                           |\n| -------------------------------- | ----------------------------------------------------------------------------------------- |\n| **To send from your own domain** | Complete **Domain Configuration**, which takes more setup and gives better deliverability |","table":"table-0"},"386":{"id":"/product-docs/easycrm/sending-setup-65","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                              |                                                                                   |\n| ---------------------------- | --------------------------------------------------------------------------------- |\n| **To send from one address** | Validate a single business email address, which is quicker and suits lower volume |","table":"table-0"},"387":{"id":"/product-docs/easycrm/sending-setup-66","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                                  |                                                                                           |\n| -------------------------------- | ----------------------------------------------------------------------------------------- |\n| **Email services on the screen** | **EasyCRM Mail**, marked **Default**, or your own Amazon SES, SendGrid or Mailgun account |","table":"table-0"},"388":{"id":"/product-docs/easycrm/sending-setup-67","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                   |                                                  |\n| ----------------- | ------------------------------------------------ |\n| **When to do it** | Once, before you build any broadcast or workflow |","table":"table-0"},"389":{"id":"/product-docs/easycrm/sending-setup-68","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                         |                                                     |\n| ----------------------- | --------------------------------------------------- |\n| **Also on this screen** | **Call Integration** and **SMS Integration** (Beta) |","table":"table-0"},"390":{"id":"/product-docs/easycrm/sending-setup-69","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                              |                                   |\n| ---------------------------- | --------------------------------- |\n| **What sends count against** | Your monthly **Wallet** allowance |","table":"table-0"},"391":{"id":"/product-docs/easycrm/sending-setup-70","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                      |                                                           |\n| -------------------- | --------------------------------------------------------- |\n| **Your CRM or ours** | Keep the CRM you have and skip this setup, or use EasyCRM |","table":"table-0"},"392":{"id":"/product-docs/easycrm/sending-setup-71","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#at-a-glance","content":"|                          |                                                                                   |\n| ------------------------ | --------------------------------------------------------------------------------- |\n| **What it leaves alone** | A webinar's own emails, set under **Email Settings** on its **Notifications** tab |","table":"table-0"},"393":{"id":"/product-docs/easycrm/sending-setup-72","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-is","content":"Webinar CRM email setup is the step between having contacts and being able to message them. People arrive in the CRM from your webinars, and broadcasts and workflows handle the communication after that. Neither can send until this step is finished."},"394":{"id":"/product-docs/easycrm/sending-setup-73","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-is","content":"The setup rests on two separate decisions, and it helps to keep them apart. The **email service** is the system that carries your mail out of the CRM. The **sending identity** is the domain or address your mail comes from, verified so the CRM will send as you. Choosing a service doesn't verify your identity, and verifying your identity doesn't choose a service."},"395":{"id":"/product-docs/easycrm/sending-setup-74","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-you-see","content":"**Configurations** opens on a row of channel tabs, one for each way the CRM can reach someone:"},"396":{"id":"/product-docs/easycrm/sending-setup-75","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-you-see","content":"| Tab                   | What it connects                                        |\n| --------------------- | ------------------------------------------------------- |\n| **Email Integration** | Your email service, sending identity and reply settings |","table":"table-1"},"397":{"id":"/product-docs/easycrm/sending-setup-76","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-you-see","content":"| Tab                  | What it connects                                 |\n| -------------------- | ------------------------------------------------ |\n| **Call Integration** | Calling, with minutes metered in your **Wallet** |","table":"table-1"},"398":{"id":"/product-docs/easycrm/sending-setup-77","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-you-see","content":"| Tab                        | What it connects                                            |\n| -------------------------- | ----------------------------------------------------------- |\n| **SMS Integration** (Beta) | Text messages, with a separate allowance in your **Wallet** |","table":"table-1"},"399":{"id":"/product-docs/easycrm/sending-setup-78","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-you-see","content":"| Tab          | What it connects                  |\n| ------------ | --------------------------------- |\n| **Whatsapp** | Marked **Coming soon** in EasyCRM |","table":"table-1"},"400":{"id":"/product-docs/easycrm/sending-setup-79","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-you-see","content":"**Email Integration** has four parts. **Email provider** lists your services, **Reply & forwarding settings** decides where replies go, and **Analytics** sits beside those two. **Domains** is a button on the provider list."},"401":{"id":"/product-docs/easycrm/sending-setup-80","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#your-crm-or-ours","content":"Keep HubSpot, Salesforce Pardot (Account Engagement), ActiveCampaign, Mailchimp or Kit (formerly ConvertKit), or use EasyCRM natively. Both are supported. That means no paying twice and no migration: if you have a CRM, keep it, and if you have none, EasyCRM is built in."},"402":{"id":"/product-docs/easycrm/sending-setup-81","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#your-crm-or-ours","content":"If you keep your own, connect it on a webinar's **Integrations** tab. Attendee engagement then flows into your system of record, with each contact tagged by what they did, such as attending or missing the session. Your broadcasts go out from that tool, so you don't need this setup. Your webinar's own confirmation, reminder and follow-up emails still go out from EasyWebinar either way."},"403":{"id":"/product-docs/easycrm/sending-setup-82","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-its-for","content":"This setup answers one question: how do my CRM broadcasts and workflows go out from my own domain or address? It connects an email service and proves who you send as. You do it once, before you build anything."},"404":{"id":"/product-docs/easycrm/sending-setup-83","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#how-it-helps","content":"**It opens the gate.** Broadcasts and workflows can go out once a service and a verified sender are in place."},"405":{"id":"/product-docs/easycrm/sending-setup-84","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#how-it-helps","content":"**It puts your name on the mail.** Your contacts see a domain or address that belongs to your business."},"406":{"id":"/product-docs/easycrm/sending-setup-85","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#how-it-helps","content":"**It improves your deliverability.** A verified domain gives you better deliverability than a verified single address."},"407":{"id":"/product-docs/easycrm/sending-setup-86","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#how-it-helps","content":"**It brings replies back to you.** You choose the address, so a reply reaches someone who reads it."},"408":{"id":"/product-docs/easycrm/sending-setup-87","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#without-it","content":"Nothing sends from EasyCRM. A broadcast you have written can't go out, and a published workflow can't reach anyone. People often find this out on the day of their first send, when an offer or a replay link is already due."},"409":{"id":"/product-docs/easycrm/sending-setup-88","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#why-buyers-care","content":"This matters most to the admin or marketer who owns the first send, and to the owner whose domain carries the mail. It matters at the very start, before lists and campaigns exist. Domain work can need help from whoever holds your DNS, so leave time for it."},"410":{"id":"/product-docs/easycrm/sending-setup-89","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#approach","content":"Take a typical case. A family-run garden centre with two branches has 1,800 leads from its spring planting webinars. The office admin is asked to send the first broadcast on Monday, for an offer closing on Friday. She opens the CRM, writes the email, and learns that nothing can go out yet."},"411":{"id":"/product-docs/easycrm/sending-setup-90","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#approach","content":"The usual workaround is to export the list and send from the shared office mailbox or a separate email tool. That may get one message out, but it tends to cost more with each send. Results sit apart from the lead records, replies scatter, and the next send starts from a fresh export."},"412":{"id":"/product-docs/easycrm/sending-setup-91","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#approach","content":"The job itself hasn't changed. Mail has to leave under a name that belongs to the business, and someone has to read the replies. That work only needs doing once if it lives where the broadcasts and workflows live. Every later send can then rely on it, so a busy admin doesn't repeat it."},"413":{"id":"/product-docs/easycrm/sending-setup-92","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#approach","content":"EasyWebinar puts that job on one screen, **Configurations**, inside its CRM. It lists your email services, asks you to verify a domain or a single business address, and lets you choose where replies go. The garden centre's admin could validate the office address for Monday's send and plan the domain work for when volume grows."},"414":{"id":"/product-docs/easycrm/sending-setup-93","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#approach","content":"One detail shows how firm the gate is. The screen tells you to verify your sending identity before you can start sending email, and that notice sits right above the list of services. The other platforms' options are covered in How EasyWebinar compares for webinar CRM email sending, below."},"415":{"id":"/product-docs/easycrm/sending-setup-94","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#how-authentication-works","content":"Verifying a domain makes more sense once you know what a receiving mail system checks. Three open standards do most of the work, and each relies on records in your domain's DNS. This section explains them in general, so read it as background rather than as EasyCRM steps."},"416":{"id":"/product-docs/easycrm/sending-setup-95","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#spf","content":"SPF lets a domain owner name the hosts allowed to use its domain, and a receiving system can check that permission. Think of it as a published guest list. A domain can't have several competing SPF records, so a new sending service joins your existing record rather than getting a second one."},"417":{"id":"/product-docs/easycrm/sending-setup-96","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#dkim","content":"DKIM lets the owner of a signing domain claim some responsibility for a message. The sending system adds a cryptographic signature, and the receiver fetches the matching public key from that domain. When the signature checks out, the message is tied to your domain."},"418":{"id":"/product-docs/easycrm/sending-setup-97","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#dmarc","content":"DMARC lets a domain owner state policies for validation, handling and reporting, which receiving systems can use. It also brings in alignment, which means the domain in your From address has to match a domain that SPF or DKIM has validated. A policy of `none` requests no specific action on delivery, so it's a gentle place to start."},"419":{"id":"/product-docs/easycrm/sending-setup-98","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#dmarc","content":"Alignment is the idea that links all this to your goal. Your contacts see your From address, so these checks only help your name when they pass for that same domain."},"420":{"id":"/product-docs/easycrm/sending-setup-99","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#confirmed-for-easycrm","content":"These standards are general, and they don't describe EasyCRM's screens. What's confirmed for EasyCRM is narrower: you complete **Domain Configuration** for a dedicated domain, it involves DNS work, and a verified domain gives better deliverability than a single address. Follow what that screen asks for, rather than copying records from another service or guide. This page names no specific EasyCRM records for that reason."},"421":{"id":"/product-docs/easycrm/sending-setup-100","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"Two large mailbox providers publish rules that apply to whatever your CRM sends, and both pages were checked on 2 November 2026. Gmail's requirements have applied since 1 February 2024, and they concern personal accounts ending in @gmail.com or @googlemail.com. Providers change these rules, so check the source pages before a large send."},"422":{"id":"/product-docs/easycrm/sending-setup-101","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"| Requirement                     | Gmail       | Yahoo                    |\n| ------------------------------- | ----------- | ------------------------ |\n| **Authentication, all senders** | SPF or DKIM | SPF or DKIM at a minimum |","table":"table-2"},"423":{"id":"/product-docs/easycrm/sending-setup-102","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"| Requirement                | Gmail                          | Yahoo      |\n| -------------------------- | ------------------------------ | ---------- |\n| **Spam rate, all senders** | Below 0.3% in Postmaster Tools | Below 0.3% |","table":"table-2"},"424":{"id":"/product-docs/easycrm/sending-setup-103","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"| Requirement            | Gmail                                            | Yahoo                                    |\n| ---------------------- | ------------------------------------------------ | ---------------------------------------- |\n| **Who counts as bulk** | More than 5,000 messages a day to Gmail accounts | Bulk senders, with no figure on the page |","table":"table-2"},"425":{"id":"/product-docs/easycrm/sending-setup-104","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"| Requirement              | Gmail                    | Yahoo                                                       |\n| ------------------------ | ------------------------ | ----------------------------------------------------------- |\n| **Authentication, bulk** | SPF and DKIM, plus DMARC | Both SPF and DKIM, plus a DMARC policy of at least `p=none` |","table":"table-2"},"426":{"id":"/product-docs/easycrm/sending-setup-105","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"| Requirement            | Gmail                               | Yahoo                               |\n| ---------------------- | ----------------------------------- | ----------------------------------- |\n| **From address, bulk** | Aligned with the SPF or DKIM domain | Aligned with the SPF or DKIM domain |","table":"table-2"},"427":{"id":"/product-docs/easycrm/sending-setup-106","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"| Requirement           | Gmail                                         | Yahoo                                           |\n| --------------------- | --------------------------------------------- | ----------------------------------------------- |\n| **Unsubscribe, bulk** | One-click, plus a visible link in the message | One-click, with requests honoured within 2 days |","table":"table-2"},"428":{"id":"/product-docs/easycrm/sending-setup-107","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#mailbox-rules","content":"These are the providers' rules for senders, and they don't describe what EasyCRM does on your behalf. If your volume is nearing the bulk level, confirm with EasyWebinar how your setup meets each row before you scale up."},"429":{"id":"/product-docs/easycrm/sending-setup-108","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"You don't need your own domain to send broadcasts, because a single business email address also counts as a sending identity. The choice depends on how much you send and how much setup you can take on now."},"430":{"id":"/product-docs/easycrm/sending-setup-109","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"|                     | **Domain Configuration**   | **A single business email address** |\n| ------------------- | -------------------------- | ----------------------------------- |\n| **What you verify** | A dedicated domain you own | One address                         |","table":"table-3"},"431":{"id":"/product-docs/easycrm/sending-setup-110","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"|                  | **Domain Configuration**       | **A single business email address** |\n| ---------------- | ------------------------------ | ----------------------------------- |\n| **Setup effort** | More setup, including DNS work | Quicker                             |","table":"table-3"},"432":{"id":"/product-docs/easycrm/sending-setup-111","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"|           | **Domain Configuration** | **A single business email address** |\n| --------- | ------------------------ | ----------------------------------- |\n| **Suits** | Sending in any volume    | Lower volume and small sends        |","table":"table-3"},"433":{"id":"/product-docs/easycrm/sending-setup-112","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"|                    | **Domain Configuration** | **A single business email address** |\n| ------------------ | ------------------------ | ----------------------------------- |\n| **Deliverability** | The better of the two    | Weaker than a verified domain       |","table":"table-3"},"434":{"id":"/product-docs/easycrm/sending-setup-113","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"|                          | **Domain Configuration** | **A single business email address** |\n| ------------------------ | ------------------------ | ----------------------------------- |\n| **Who may need to help** | Whoever holds your DNS   | Usually nobody else                 |","table":"table-3"},"435":{"id":"/product-docs/easycrm/sending-setup-114","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#domain-or-address","content":"EasyWebinar's guidance is that a verified domain is worth the DNS work if you send in any volume. If your first send is a small list and it's due soon, the single address is the quicker way to start. Neither route can promise that a given message lands in the inbox, since the receiving mail system makes that decision. For the wider picture, our guide to webinar email marketing covers what happens after your mail is sending."},"436":{"id":"/product-docs/easycrm/sending-setup-115","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#sending-vs-page-domain","content":"Two settings use the word \"domain\", and they do different jobs. **Domain Configuration** under **Configurations** concerns the email your CRM sends. **Custom domain (C-Name)** under **Settings** → **Edit Profile** points your own domain at your webinar pages, so links read `webinars.yourcompany.com`."},"437":{"id":"/product-docs/easycrm/sending-setup-116","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#sending-vs-page-domain","content":"The page setting needs the **C-Name** add-on plus a CNAME record, and it changes the public links people click. Treat them as two separate jobs, even if you use the same company domain for both."},"438":{"id":"/product-docs/easycrm/sending-setup-117","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-provider","content":"Yes, you can use your own SMTP provider. Three are offered, and each sends through an account you hold with that company, so you need an account there first. EasyCRM sends through your provider rather than instead of it."},"439":{"id":"/product-docs/easycrm/sending-setup-118","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-provider","content":"| Option on the screen     | Powered by | What you need                                   |\n| ------------------------ | ---------- | ----------------------------------------------- |\n| **Amazon SES SMTP Mail** | Amazon SES | Your own Amazon SES account and its credentials |","table":"table-4"},"440":{"id":"/product-docs/easycrm/sending-setup-119","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-provider","content":"| Option on the screen   | Powered by | What you need                                 |\n| ---------------------- | ---------- | --------------------------------------------- |\n| **Sendgrid SMTP Mail** | SendGrid   | Your own SendGrid account and its credentials |","table":"table-4"},"441":{"id":"/product-docs/easycrm/sending-setup-120","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-provider","content":"| Option on the screen  | Powered by | What you need                                |\n| --------------------- | ---------- | -------------------------------------------- |\n| **Mailgun SMTP Mail** | Mailgun    | Your own Mailgun account and its credentials |","table":"table-4"},"442":{"id":"/product-docs/easycrm/sending-setup-121","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-provider","content":"**EasyCRM Mail** appears above any provider you add. It carries the **Default** badge and has no **Configure** button of its own, and a connected provider shows a **Connected** badge with its server address. You pick between them with the selector at the left of each row."},"443":{"id":"/product-docs/easycrm/sending-setup-122","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-provider","content":"The choice usually comes down to what you already run. If your company has an SES, SendGrid or Mailgun account that someone manages, connect it. If you have no provider account, start from the default row and leave provider work for later. Whichever you select, the verification notice still applies, so choosing a service never replaces verifying your identity."},"444":{"id":"/product-docs/easycrm/sending-setup-123","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Without a setup screen, this job happens directly in DNS. These steps show the general method, and they're useful for briefing whoever holds your DNS."},"445":{"id":"/product-docs/easycrm/sending-setup-124","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"List every service that sends mail as your domain, including your office mailbox."},"446":{"id":"/product-docs/easycrm/sending-setup-125","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Find out who controls the domain's DNS, and agree a time to make the changes."},"447":{"id":"/product-docs/easycrm/sending-setup-126","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Add each sending service to one SPF record, keeping a single record for the domain."},"448":{"id":"/product-docs/easycrm/sending-setup-127","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Publish the DKIM public key that your sending service gives you."},"449":{"id":"/product-docs/easycrm/sending-setup-128","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Publish a DMARC record with a policy of `none`, and include a reporting address so you can monitor the initial setup."},"450":{"id":"/product-docs/easycrm/sending-setup-129","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Send a test to a mailbox you control, then read its full header, using Show original in Gmail."},"451":{"id":"/product-docs/easycrm/sending-setup-130","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#manual-method","content":"Watch your spam rate after each large send, and keep it below 0.3%."},"452":{"id":"/product-docs/easycrm/sending-setup-131","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#same-job-in-easywebinar","content":"In EasyWebinar the job starts on **Configurations** rather than in your DNS settings. Steps 1 and 2 still apply, because they're about your own company. From there, you complete **Domain Configuration** or validate a single business email address, following what the screen asks for. The set-up steps below cover the rest, including replies."},"453":{"id":"/product-docs/easycrm/sending-setup-132","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"This is an illustrative calculation with sample figures, not an EasyWebinar output. It uses the garden centre from earlier and asks two planning questions. Does the month fit the **Wallet** allowance, and how close is the largest day to the level Gmail treats as bulk?"},"454":{"id":"/product-docs/easycrm/sending-setup-133","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check                       | Sample figures                     | Arithmetic    | Result                 |\n| --------------------------- | ---------------------------------- | ------------- | ---------------------- |\n| Broadcast to the whole list | 1,800 leads, 1,000 emails included | 1,800 − 1,000 | 800 over the allowance |","table":"table-5"},"455":{"id":"/product-docs/easycrm/sending-setup-134","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check                        | Sample figures             | Arithmetic | Result     |\n| ---------------------------- | -------------------------- | ---------- | ---------- |\n| Broadcast to a targeted list | 600 people, one email each | 600 × 1    | 600 emails |","table":"table-5"},"456":{"id":"/product-docs/easycrm/sending-setup-135","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check        | Sample figures                   | Arithmetic | Result     |\n| ------------ | -------------------------------- | ---------- | ---------- |\n| One workflow | 100 new leads, three emails each | 100 × 3    | 300 emails |","table":"table-5"},"457":{"id":"/product-docs/easycrm/sending-setup-136","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check         | Sample figures          | Arithmetic | Result     |\n| ------------- | ----------------------- | ---------- | ---------- |\n| Month's total | Broadcast plus workflow | 600 + 300  | 900 emails |","table":"table-5"},"458":{"id":"/product-docs/easycrm/sending-setup-137","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check          | Sample figures        | Arithmetic  | Result     |\n| -------------- | --------------------- | ----------- | ---------- |\n| Allowance left | 1,000 emails included | 1,000 − 900 | 100 emails |","table":"table-5"},"459":{"id":"/product-docs/easycrm/sending-setup-138","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check                                  | Sample figures          | Arithmetic  | Result           |\n| -------------------------------------- | ----------------------- | ----------- | ---------------- |\n| Largest day against Gmail's bulk level | 600 emails, 5,000 a day | 600 ÷ 5,000 | 12% of the level |","table":"table-5"},"460":{"id":"/product-docs/easycrm/sending-setup-139","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"| Check                            | Sample figures         | Arithmetic  | Result         |\n| -------------------------------- | ---------------------- | ----------- | -------------- |\n| Complaints that would reach 0.3% | 600 emails on that day | 600 × 0.003 | 1.8 complaints |","table":"table-5"},"461":{"id":"/product-docs/easycrm/sending-setup-140","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#worked-example","content":"A whole-list send would overrun the allowance, so the targeted list is the better first broadcast. Even if every address were at Gmail, the largest day stays well under the bulk level, though the rules for all senders still apply. Two complaints on 600 emails would pass 0.3%, so this rough guide favours people who expect to hear from you. Each provider measures its own traffic, so treat the last row as a planning figure."},"462":{"id":"/product-docs/easycrm/sending-setup-141","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Work through these steps in order, and do them before you build anything else in the CRM:"},"463":{"id":"/product-docs/easycrm/sending-setup-142","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Click **Configurations** in the EasyCRM sidebar and stay on **Email Integration**."},"464":{"id":"/product-docs/easycrm/sending-setup-143","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Choose your email service under **Email provider**, connecting your own SMTP account if you use one."},"465":{"id":"/product-docs/easycrm/sending-setup-144","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Verify your sending identity, either a whole domain or a single business address."},"466":{"id":"/product-docs/easycrm/sending-setup-145","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Open **Reply & forwarding settings** and set an address someone reads."},"467":{"id":"/product-docs/easycrm/sending-setup-146","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Set up **Call Integration** and **SMS Integration** (Beta) if you need them."},"468":{"id":"/product-docs/easycrm/sending-setup-147","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#set-up","content":"Run the checks described below, then build your broadcasts and workflows."},"469":{"id":"/product-docs/easycrm/sending-setup-148","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-to-have-ready","content":"EasyCRM starts at Growth, and plans and add-ons are on the pricing page. You reach it by clicking **EasyCRM** under **Other Products** in the EasyWebinar sidebar, using the same login."},"470":{"id":"/product-docs/easycrm/sending-setup-149","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-to-have-ready","content":"A few things save time once you start. If you're verifying a domain, you need access to its DNS settings, or a colleague who has it. That colleague can work from their own team member login. If you're connecting a provider, have your account credentials to hand. You also need a reply address that a person actually reads."},"471":{"id":"/product-docs/easycrm/sending-setup-150","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#open-configurations","content":"Click **Configurations** in the EasyCRM sidebar. Three areas on the screen do most of the work: the channel tabs, the verification notice and the list of services."},"472":{"id":"/product-docs/easycrm/sending-setup-151","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#open-configurations","content":"Start here for every send. The notice above the list says what must be verified, and the Sending health label sits beside the default service."},"473":{"id":"/product-docs/easycrm/sending-setup-152","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#choose-service","content":"The list is headed **Select Email service**, and it invites you to connect an SMTP provider to send emails from EasyCRM. **EasyCRM Mail** is already on the list, marked **Default**. To use your own provider, click **Add Service**, then **Configure** on the one you use, and enter its credentials. The section on built-in mail or your own SMTP provider, above, explains how to choose."},"474":{"id":"/product-docs/easycrm/sending-setup-153","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#verify-identity","content":"The notice on the screen sets out the requirement. You must either complete **Domain Configuration** for a dedicated domain, or validate a single business email address under **Email addresses**. Either route counts, and nothing sends until one of them is done. The **Domain Configuration** link in the notice and the **Domains** button both sit on this screen."},"475":{"id":"/product-docs/easycrm/sending-setup-154","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#reply-forwarding","content":"**Reply & forwarding settings** decides where replies to your email go. Point it at an address someone reads, because people reply to marketing email more than you might expect. A monitored team inbox is a sensible choice for a small business, since replies still get seen when one person is away."},"476":{"id":"/product-docs/easycrm/sending-setup-155","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#call-sms","content":"**Call Integration** and **SMS Integration** (Beta) have their own tabs, and you set them up the same way as email. Skip both if your first sends are email only, and come back when you need them. Calling is connected here, and your **Wallet** meters the minutes."},"477":{"id":"/product-docs/easycrm/sending-setup-156","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#call-sms","content":"WhatsApp (Beta) can't be set up here yet, because the **Whatsapp** tab in EasyCRM is marked **Coming soon**. WhatsApp (Beta) notifications are available on the EasyWebinar side, under a webinar's **Notifications** tab."},"478":{"id":"/product-docs/easycrm/sending-setup-157","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"Run through this short list once the steps are done, and again before any large send:"},"479":{"id":"/product-docs/easycrm/sending-setup-158","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"**Email service.** The service you want is selected under **Email provider**, and a provider you added shows **Connected**."},"480":{"id":"/product-docs/easycrm/sending-setup-159","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"**Sending health.** Look at **Sending health**, beside **EasyCRM Mail**, before you send through that service."},"481":{"id":"/product-docs/easycrm/sending-setup-160","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"**Sending identity.** Your domain or single address has finished verification."},"482":{"id":"/product-docs/easycrm/sending-setup-161","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"**Replies.** **Reply & forwarding settings** points at an address someone reads."},"483":{"id":"/product-docs/easycrm/sending-setup-162","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"**Allowance.** Your **Wallet** has room for the send. A channel that runs out stops sending until the cycle resets."},"484":{"id":"/product-docs/easycrm/sending-setup-163","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"**List size.** Send to a targeted list rather than everyone, because it helps on both allowance and open rate."},"485":{"id":"/product-docs/easycrm/sending-setup-164","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#check-before-send","content":"It's also worth making your first broadcast a small one. Broadcasts send to the list you pick, so a short list of your own colleagues lets you see the message arrive and test a reply. Workflows are safe to build at this stage, since a draft sends nothing until you publish it."},"486":{"id":"/product-docs/easycrm/sending-setup-165","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#first-results","content":"Once a broadcast has gone out, **Marketing → Broadcasts** is the first place a sending problem shows. The screen sets your average open rate against an industry average of 21%, and your average click rate against 2.6%."},"487":{"id":"/product-docs/easycrm/sending-setup-166","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#first-results","content":"After your first send, compare these cards with the industry averages shown beneath them. The figures here are sample data from a test account."},"488":{"id":"/product-docs/easycrm/sending-setup-167","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#first-results","content":"A low open rate usually points to the subject line or the sender, so recheck your sending identity along with your wording. A good open rate with a low click rate means the email was opened and the offer didn't land, which isn't a setup problem."},"489":{"id":"/product-docs/easycrm/sending-setup-168","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"No single number proves your email setup is healthy, so it helps to know what each common measure can and can't tell you:"},"490":{"id":"/product-docs/easycrm/sending-setup-169","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"| Measure                 | What it tells you                                                            | Its weak spot                                                                                   |\n| ----------------------- | ---------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------- |\n| **Spam complaint rate** | The share of mail people mark as spam, which Gmail and Yahoo want below 0.3% | Each provider measures its own traffic, and Yahoo bases its rate on mail delivered to the inbox |","table":"table-6"},"491":{"id":"/product-docs/easycrm/sending-setup-170","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"| Measure                    | What it tells you                               | Its weak spot                          |\n| -------------------------- | ----------------------------------------------- | -------------------------------------- |\n| **Authentication results** | Whether SPF, DKIM and DMARC passed on a message | A pass doesn't promise inbox placement |","table":"table-6"},"492":{"id":"/product-docs/easycrm/sending-setup-171","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"| Measure       | What it tells you                  | Its weak spot                                             |\n| ------------- | ---------------------------------- | --------------------------------------------------------- |\n| **Open rate** | How many people opened the message | A low figure can come from the subject line or the sender |","table":"table-6"},"493":{"id":"/product-docs/easycrm/sending-setup-172","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"| Measure        | What it tells you          | Its weak spot                   |\n| -------------- | -------------------------- | ------------------------------- |\n| **Click rate** | Whether the content landed | It says little about your setup |","table":"table-6"},"494":{"id":"/product-docs/easycrm/sending-setup-173","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#measuring-sending-health","content":"In EasyWebinar, two places help. The **Broadcasts** screen shows your open and click rates beside industry averages, and **Sending health** sits beside **EasyCRM Mail** on the service list. Outside the product, Google's guidelines point to Postmaster Tools for monitoring your domain's spam rate with Gmail."},"495":{"id":"/product-docs/easycrm/sending-setup-174","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"Most failures trace back to one of a few causes, and each has a place to look:"},"496":{"id":"/product-docs/easycrm/sending-setup-175","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"| What you notice         | Likely cause                                                     | Where to fix it                            |\n| ----------------------- | ---------------------------------------------------------------- | ------------------------------------------ |\n| Nothing goes out at all | The sending identity isn't verified, or no provider is connected | **Configurations** → **Email Integration** |","table":"table-7"},"497":{"id":"/product-docs/easycrm/sending-setup-176","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"| What you notice        | Likely cause                                              | Where to fix it          |\n| ---------------------- | --------------------------------------------------------- | ------------------------ |\n| A workflow never sends | It's still a draft, because only published workflows send | **Marketing → Campaign** |","table":"table-7"},"498":{"id":"/product-docs/easycrm/sending-setup-177","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"| What you notice                         | Likely cause                         | Where to fix it                              |\n| --------------------------------------- | ------------------------------------ | -------------------------------------------- |\n| A channel stops partway through a cycle | That channel's allowance has run out | **Wallet**, then wait for the cycle to reset |","table":"table-7"},"499":{"id":"/product-docs/easycrm/sending-setup-178","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"| What you notice       | Likely cause                                                             | Where to fix it              |\n| --------------------- | ------------------------------------------------------------------------ | ---------------------------- |\n| The meter looks wrong | Your cycle follows your signup date, and older rows show **Not counted** | **Wallet** → recent activity |","table":"table-7"},"500":{"id":"/product-docs/easycrm/sending-setup-179","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"| What you notice                      | Likely cause                             | Where to fix it              |\n| ------------------------------------ | ---------------------------------------- | ---------------------------- |\n| A meter moved more than you expected | Usually a workflow running automatically | **Wallet** → recent activity |","table":"table-7"},"501":{"id":"/product-docs/easycrm/sending-setup-180","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#not-sending","content":"| What you notice            | Likely cause                          | Where to fix it                 |\n| -------------------------- | ------------------------------------- | ------------------------------- |\n| Replies don't reach anyone | The reply address is one nobody reads | **Reply & forwarding settings** |","table":"table-7"},"502":{"id":"/product-docs/easycrm/sending-setup-181","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"These settings don't change your webinar reminder emails. They cover EasyCRM broadcasts and workflows, and a webinar's own messages are set on that webinar."},"503":{"id":"/product-docs/easycrm/sending-setup-182","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"Each webinar's registration confirmation, reminders and follow-ups live on its **Notifications** tab. Their **Email Settings** button holds the **Sender name**, **Reply-to email** and **Notify admin** settings. So if your reminder shows the wrong sender name, look there rather than in **Configurations**."},"504":{"id":"/product-docs/easycrm/sending-setup-183","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"This screen is the other half of the picture: emails tied to one webinar, with their own sender settings, which your CRM sending setup leaves untouched."},"505":{"id":"/product-docs/easycrm/sending-setup-184","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"The same split applies to text messages. A webinar's own SMS (Beta) is built on the same **Notifications** tab, and those messages go from your EasyWebinar number. That builder needs a phone number for each person, which comes from the Phone field on your registration form."},"506":{"id":"/product-docs/easycrm/sending-setup-185","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"The webinar SMS builder (Beta) opens from a webinar's Notifications tab, so it isn't where you connect SMS Integration (Beta) for the CRM."},"507":{"id":"/product-docs/easycrm/sending-setup-186","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"| Message       | Where it's set             | Covered by this setup |\n| ------------- | -------------------------- | --------------------- |\n| CRM broadcast | **Marketing → Broadcasts** | Yes                   |","table":"table-8"},"508":{"id":"/product-docs/easycrm/sending-setup-187","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"| Message      | Where it's set           | Covered by this setup |\n| ------------ | ------------------------ | --------------------- |\n| CRM workflow | **Marketing → Campaign** | Yes                   |","table":"table-8"},"509":{"id":"/product-docs/easycrm/sending-setup-188","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"| Message                                           | Where it's set                      | Covered by this setup |\n| ------------------------------------------------- | ----------------------------------- | --------------------- |\n| Webinar confirmation, reminder or follow-up email | The webinar's **Notifications** tab | No                    |","table":"table-8"},"510":{"id":"/product-docs/easycrm/sending-setup-189","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#what-it-leaves-alone","content":"| Message                               | Where it's set                      | Covered by this setup |\n| ------------------------------------- | ----------------------------------- | --------------------- |\n| Webinar SMS (Beta) or WhatsApp (Beta) | The webinar's **Notifications** tab | No                    |","table":"table-8"},"511":{"id":"/product-docs/easycrm/sending-setup-190","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#works-with","content":"Several parts of the product rely on this setup or sit right beside it:"},"512":{"id":"/product-docs/easycrm/sending-setup-191","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#works-with","content":"**Broadcasts.** A broadcast is a one-off send to a list, such as a replay link after a webinar or an offer that's about to close. Each one depends on this setup being finished."},"513":{"id":"/product-docs/easycrm/sending-setup-192","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#works-with","content":"**Workflows.** A workflow is an automated sequence, and webinar follow-up is the sensible first one to build. It keeps sending once published, so it relies on these settings for as long as it runs."},"514":{"id":"/product-docs/easycrm/sending-setup-193","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#works-with","content":"**Wallet.** Email, SMS (Beta) and call minutes each have a monthly allowance, listed with the other limits and defaults. Workflows use more over time than broadcasts, because they keep sending every day."},"515":{"id":"/product-docs/easycrm/sending-setup-194","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#works-with","content":"**Leads.** **Import from EasyWebinar** pulls registrants and attendees across from a webinar, so the people in your webinar records can be sent to once sending works."},"516":{"id":"/product-docs/easycrm/sending-setup-195","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#works-with","content":"**Your own CRM.** You may prefer to send from the CRM you already use. In that case, skip this setup, since you don't need EasyCRM to run webinars."},"517":{"id":"/product-docs/easycrm/sending-setup-196","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#who-small-business","content":"An office admin or owner usually does this alone, with a first send already in the diary. Validating a single business address is the quick way to get going. Move to a domain once sending becomes regular, and ask whoever manages your website to help with the DNS."},"518":{"id":"/product-docs/easycrm/sending-setup-197","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#who-b2b-marketing","content":"A marketing team sending regularly gets the most from **Domain Configuration**, because volume is where a verified domain pays back. If the company already runs SES, SendGrid or Mailgun, connect that account with **Add Service** and agree who looks after the credentials."},"519":{"id":"/product-docs/easycrm/sending-setup-198","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#who-coaches","content":"For a coach, the reply is often the point of the email, because a reply can start a client conversation. Set **Reply & forwarding settings** with the same care as the identity, and use an address you check daily. A single business address often suits this kind of low-volume sending."},"520":{"id":"/product-docs/easycrm/sending-setup-199","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#who-agencies","content":"An agency often sends for a client whose domain it doesn't control, so the DNS work may sit with the client's own team. Raise it early, because DNS changes can take a few hours to propagate. A separate client workspace keeps that client's webinars, registrants and settings apart from yours."},"521":{"id":"/product-docs/easycrm/sending-setup-200","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"EasyWebinar sets the email service, the sending identity and the reply address on one screen in its own CRM. Those settings then serve broadcasts and workflows, with calling on the next tab. And it's your CRM or ours: keep the CRM you have, or use EasyCRM natively."},"522":{"id":"/product-docs/easycrm/sending-setup-201","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"Webinar CRM email sending features, from each platform's public documentation:"},"523":{"id":"/product-docs/easycrm/sending-setup-202","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform        | Your own SMTP provider | Domain or single address verified | CRM broadcasts and workflows | Calling set up beside email |\n| --------------- | ---------------------- | --------------------------------- | ---------------------------- | --------------------------- |\n| **EasyWebinar** | Yes                    | Yes                               | Yes                          | Yes                         |","table":"table-9"},"524":{"id":"/product-docs/easycrm/sending-setup-203","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform     | Your own SMTP provider         | Domain or single address verified | CRM broadcasts and workflows | Calling set up beside email |\n| ------------ | ------------------------------ | --------------------------------- | ---------------------------- | --------------------------- |\n| **eWebinar** | Yes (SMTP service integration) | Partly (verified in SendGrid)     | Not in docs                  | Not in docs                 |","table":"table-9"},"525":{"id":"/product-docs/easycrm/sending-setup-204","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform                       | Your own SMTP provider         | Domain or single address verified | CRM broadcasts and workflows | Calling set up beside email   |\n| ------------------------------ | ------------------------------ | --------------------------------- | ---------------------------- | ----------------------------- |\n| **WebinarJam and EverWebinar** | Yes (third-party SMTP service) | Partly (DKIM on your domain)      | Not in docs                  | Partly (voice call reminders) |","table":"table-9"},"526":{"id":"/product-docs/easycrm/sending-setup-205","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform  | Your own SMTP provider | Domain or single address verified          | CRM broadcasts and workflows | Calling set up beside email |\n| --------- | ---------------------- | ------------------------------------------ | ---------------------------- | --------------------------- |\n| **Demio** | Not in docs            | Partly (technical sender address is fixed) | Not in docs                  | Not in docs                 |","table":"table-9"},"527":{"id":"/product-docs/easycrm/sending-setup-206","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform      | Your own SMTP provider                 | Domain or single address verified | CRM broadcasts and workflows | Calling set up beside email |\n| ------------- | -------------------------------------- | --------------------------------- | ---------------------------- | --------------------------- |\n| **Livestorm** | Partly (your own email app via Zapier) | Not in docs                       | Not in docs                  | Not in docs                 |","table":"table-9"},"528":{"id":"/product-docs/easycrm/sending-setup-207","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform       | Your own SMTP provider | Domain or single address verified | CRM broadcasts and workflows   | Calling set up beside email |\n| -------------- | ---------------------- | --------------------------------- | ------------------------------ | --------------------------- |\n| **WebinarKit** | Not in docs            | Not in docs                       | Partly (broadcasts in its CRM) | Not in docs                 |","table":"table-9"},"529":{"id":"/product-docs/easycrm/sending-setup-208","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"| Platform   | Your own SMTP provider | Domain or single address verified | CRM broadcasts and workflows | Calling set up beside email |\n| ---------- | ---------------------- | --------------------------------- | ---------------------------- | --------------------------- |\n| **Kajabi** | Not in docs            | Partly (custom email domain)      | Partly (email sequences)     | Not in docs                 |","table":"table-9"},"530":{"id":"/product-docs/easycrm/sending-setup-209","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"531":{"id":"/product-docs/easycrm/sending-setup-210","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare-stronger","content":"**Sending is part of the product.** EasyWebinar connects your service directly under **Configurations**, while Livestorm's guide sends your own emails through a Zapier automation. More in EasyWebinar vs Livestorm."},"532":{"id":"/product-docs/easycrm/sending-setup-211","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare-stronger","content":"**Two routes to a verified sender.** EasyWebinar accepts a dedicated domain or a single business address on the same screen, while eWebinar's SendGrid steps run through verification in SendGrid. More in EasyWebinar vs eWebinar."},"533":{"id":"/product-docs/easycrm/sending-setup-212","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare-stronger","content":"**One setup for a CRM's sends.** EasyWebinar's setup serves CRM broadcasts and workflows, while WebinarJam's third-party SMTP service is described for webinar emails. More in EasyWebinar vs WebinarJam."},"534":{"id":"/product-docs/easycrm/sending-setup-213","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare-stronger","content":"**A sending identity you verify.** EasyWebinar lets you verify your own domain for sending, while Demio's technical sender address stays fixed. More in EasyWebinar vs Demio."},"535":{"id":"/product-docs/easycrm/sending-setup-214","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 2 November 2026. Features and plans change, so confirm with the vendor before you decide.*"},"536":{"id":"/product-docs/easycrm/sending-setup-215","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#limits","content":"These are the boundaries to plan around:"},"537":{"id":"/product-docs/easycrm/sending-setup-216","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#limits","content":"**It covers the CRM only.** Broadcasts and workflows use it. A webinar's own emails, SMS (Beta) and WhatsApp (Beta) use that webinar's **Notifications** tab."},"538":{"id":"/product-docs/easycrm/sending-setup-217","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#limits","content":"**Verification comes first.** Nothing sends until your domain or address is verified, and no setting skips this step."},"539":{"id":"/product-docs/easycrm/sending-setup-218","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#limits","content":"**Three SMTP providers are offered.** They are Amazon SES, SendGrid and Mailgun, and each needs your own account with that company."},"540":{"id":"/product-docs/easycrm/sending-setup-219","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#limits","content":"**WhatsApp (Beta) isn't on this screen yet.** The **Whatsapp** tab in EasyCRM is marked **Coming soon**."},"541":{"id":"/product-docs/easycrm/sending-setup-220","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#limits","content":"**Sends draw on a monthly allowance.** Emails, SMS (Beta) and call minutes are counted separately, so running out of one leaves the others working. The cycle follows your signup date, not the calendar month."},"542":{"id":"/product-docs/easycrm/sending-setup-221","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-own-smtp","content":"Yes. EasyCRM offers Amazon SES, SendGrid and Mailgun. Click **Add Service**, then **Configure** on the provider you use, and enter its credentials. You still verify your domain or address, and sends still count against your **Wallet** allowance once sending is working."},"543":{"id":"/product-docs/easycrm/sending-setup-222","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-need-domain","content":"No. You can validate a single business email address instead, which is quicker and suits lower volume. EasyWebinar's guidance is to verify a domain if you send in any volume, since a domain gives better deliverability than a single address."},"544":{"id":"/product-docs/easycrm/sending-setup-223","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-reminders","content":"No. They apply to EasyCRM broadcasts and workflows. A webinar's confirmation, reminder and follow-up emails are set on that webinar's **Notifications** tab, and its **Email Settings** button holds their sender name and reply-to address."},"545":{"id":"/product-docs/easycrm/sending-setup-224","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-not-sending","content":"Almost always, the sending identity isn't verified or no provider is connected. Open **Configurations**, check the notice on **Email Integration**, and finish whichever step is missing. If only a workflow is silent, check that it's published, because a draft sends nothing."},"546":{"id":"/product-docs/easycrm/sending-setup-225","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-existing-crm","content":"No. You can keep your CRM or use EasyCRM, which is built in. Connect HubSpot on a webinar's **Integrations** tab, and your broadcasts go out from HubSpot, so you can skip this setup. Your webinar's own emails still go out from EasyWebinar."},"547":{"id":"/product-docs/easycrm/sending-setup-226","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-provider-account","content":"Yes. When you connect Amazon SES, SendGrid or Mailgun, EasyCRM sends through your account with that company rather than replacing it. So set up the account first, then bring its credentials to the **Configure** step on the **Email provider** tab."},"548":{"id":"/product-docs/easycrm/sending-setup-227","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-domain-or-address","content":"Choose a domain if you send in volume and can make DNS changes. Choose a single business address if your sends are small or your first one is due soon. The domain route takes more setup, and it gives you better deliverability in return."},"549":{"id":"/product-docs/easycrm/sending-setup-228","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-replies","content":"Replies go wherever you set under **Reply & forwarding settings**, on the **Email Integration** tab. Point that setting at an address someone actually reads, such as a monitored team inbox, because people often reply to marketing email and expect an answer."},"550":{"id":"/product-docs/easycrm/sending-setup-229","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-easycrm-mail","content":"**EasyCRM Mail** is the service listed first under **Select Email service**, marked **Default**. Unlike a provider you add, its row has no **Configure** button. The verification notice sits above the whole list, so verify your domain or address whichever service you select."},"551":{"id":"/product-docs/easycrm/sending-setup-230","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-sending-health","content":"On **Configurations**, under **Email Integration** and **Email provider**. **Sending health** sits beside **EasyCRM Mail** on the service list. Look there before your first send, then watch your open rate on the **Broadcasts** screen once mail has gone out."},"552":{"id":"/product-docs/easycrm/sending-setup-231","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-call-sms","content":"**Call Integration** and **SMS Integration** (Beta) each have their own tab on **Configurations**, and you set them up the same way as email. Your **Wallet** meters call minutes and SMS (Beta) messages separately from your email allowance."},"553":{"id":"/product-docs/easycrm/sending-setup-232","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-separate-setup","content":"No. You set up sending once on **Configurations**, and both broadcasts and workflows depend on it. Both also draw on the same **Wallet** allowance, so a workflow running every day leaves less room for your one-off broadcasts in that cycle."},"554":{"id":"/product-docs/easycrm/sending-setup-233","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-c-name","content":"No. **Custom domain (C-Name)** points your own domain at your webinar pages, and **Domain Configuration** concerns the email your CRM sends. They are separate settings on separate screens, so finishing one doesn't complete the other, even with the same company domain."},"555":{"id":"/product-docs/easycrm/sending-setup-234","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#faq-mailbox-rules","content":"Yes. Gmail asks all senders for SPF or DKIM, and asks for SPF, DKIM and DMARC above 5,000 messages a day to Gmail accounts. Yahoo's rules are similar. On EasyCRM, you complete **Domain Configuration** or validate a single business address on **Configurations**."},"556":{"id":"/product-docs/easycrm/sending-setup-235","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#further-reading","content":"Gmail's email sender guidelines: the full requirements for all senders and for those above 5,000 messages a day."},"557":{"id":"/product-docs/easycrm/sending-setup-236","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#further-reading","content":"Yahoo's sender best practices: the matching rules for all senders and bulk senders, including how Yahoo calculates spam rate."},"558":{"id":"/product-docs/easycrm/sending-setup-237","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#further-reading","content":"RFC 7208 on SPF: the standard behind authorising hosts to send for your domain."},"559":{"id":"/product-docs/easycrm/sending-setup-238","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#further-reading","content":"RFC 6376 on DKIM: the standard behind signing messages with your domain."},"560":{"id":"/product-docs/easycrm/sending-setup-239","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#further-reading","content":"RFC 7489 on DMARC: the standard behind domain policies, reporting and alignment."},"561":{"id":"/product-docs/easycrm/sending-setup-240","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#further-reading","content":"Gmail's guide to full headers: how to open the header of a test message."},"562":{"id":"/product-docs/easycrm/sending-setup-241","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"Registration confirmation emails: the webinar's own email that carries the join link, with separate sender settings."},"563":{"id":"/product-docs/easycrm/sending-setup-242","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"Reminder emails: the messages to adjust when a reminder's timing or sender needs changing."},"564":{"id":"/product-docs/easycrm/sending-setup-243","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"Connect a CRM and map your webinar data: the route to take if your sends come from a different CRM."},"565":{"id":"/product-docs/easycrm/sending-setup-244","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"Limits and defaults: the monthly email, SMS (Beta) and call allowances in one table."},"566":{"id":"/product-docs/easycrm/sending-setup-245","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"Everything EasyCRM includes: the leads, deals and marketing tools these sending settings serve."},"567":{"id":"/product-docs/easycrm/sending-setup-246","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"EasyWebinar product documentation: the full library, for the steps before and after your first send."},"568":{"id":"/product-docs/easycrm/sending-setup-247","page_id":"/product-docs/easycrm/sending-setup","tags":[],"type":"text","url":"/product-docs/easycrm/sending-setup#related","content":"*Updated 2 November 2026: added how sender authentication works, mailbox provider rules, the manual method, a worked example and how sending health is measured.*"},"569":{"id":"/product-docs","page_id":"/product-docs","type":"page","content":"EasyWebinar product documentation","breadcrumbs":["EasyWebinar documentation"],"tags":[],"url":"/product-docs"},"570":{"id":"/product-docs-0","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs","content":"How EasyWebinar works, from creating your first webinar to selling, following up and managing your team."},"571":{"id":"/product-docs-1","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#what-easywebinar-is","content":"What EasyWebinar is"},"572":{"id":"/product-docs-2","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#start-here","content":"Start here"},"573":{"id":"/product-docs-3","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#by-role","content":"Find what you need by role"},"574":{"id":"/product-docs-4","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#product-areas","content":"The parts of EasyWebinar"},"575":{"id":"/product-docs-5","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#how-it-connects","content":"How the parts connect"},"576":{"id":"/product-docs-6","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#about","content":"About this documentation"},"577":{"id":"/product-docs-7","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#what-easywebinar-is","content":"EasyWebinar is the webinar platform built for conversions: live, automated and on demand. You build a webinar with a registration page, emails, polls and offers, run it live or from a recording, and follow up through analytics and your CRM or ours. Keep HubSpot, Salesforce Pardot (Account Engagement), ActiveCampaign, Mailchimp or Kit (formerly ConvertKit), or use the built-in EasyCRM natively."},"578":{"id":"/product-docs-8","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#by-role","content":"| You are                    | Start with                         |\n| -------------------------- | ---------------------------------- |\n| Hosting your first webinar | Create and schedule a live webinar |","table":"table-0"},"579":{"id":"/product-docs-9","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#by-role","content":"| You are                         | Start with                                 |\n| ------------------------------- | ------------------------------------------ |\n| Selling a workshop or programme | Charge for webinar registration and Offers |","table":"table-0"},"580":{"id":"/product-docs-10","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#by-role","content":"| You are                    | Start with                              |\n| -------------------------- | --------------------------------------- |\n| Following up with your CRM | Connect a CRM and map your webinar data |","table":"table-0"},"581":{"id":"/product-docs-11","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#by-role","content":"| You are          | Start with             |\n| ---------------- | ---------------------- |\n| An account admin | Team members and roles |","table":"table-0"},"582":{"id":"/product-docs-12","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#by-role","content":"| You are                     | Start with          |\n| --------------------------- | ------------------- |\n| Checking a limit or default | Limits and defaults |","table":"table-0"},"583":{"id":"/product-docs-13","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#by-role","content":"| You are                | Start with          |\n| ---------------------- | ------------------- |\n| Stuck in the live room | Camera not detected |","table":"table-0"},"584":{"id":"/product-docs-14","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area            | What it does                                      |\n| --------------- | ------------------------------------------------- |\n| **My Webinars** | Lists, filters, clones and archives your webinars |","table":"table-1"},"585":{"id":"/product-docs-15","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area               | What it does                                                |\n| ------------------ | ----------------------------------------------------------- |\n| **Create with AI** | Generates a webinar script, pages, emails, polls and offers |","table":"table-1"},"586":{"id":"/product-docs-16","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area             | What it does                                                                                                      |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------- |\n| **Webinar tabs** | Overview, Content, CTAs, Engagement, Notifications, Integrations, Analytics, Replay and Settings for each webinar |","table":"table-1"},"587":{"id":"/product-docs-17","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area          | What it does                                                    |\n| ------------- | --------------------------------------------------------------- |\n| **Live room** | Green room, backstage, presenting, screen sharing and recording |","table":"table-1"},"588":{"id":"/product-docs-18","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area         | What it does                                                             |\n| ------------ | ------------------------------------------------------------------------ |\n| **EasyCast** | Streams a live webinar to YouTube, LinkedIn or a custom RTMP destination |","table":"table-1"},"589":{"id":"/product-docs-19","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area        | What it does                                     |\n| ----------- | ------------------------------------------------ |\n| **Library** | Your hosted videos, recordings, images and files |","table":"table-1"},"590":{"id":"/product-docs-20","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area        | What it does                                                                |\n| ----------- | --------------------------------------------------------------------------- |\n| **EasyCRM** | Leads, lists, clients, deals, tasks, broadcasts and workflows (from Growth) |","table":"table-1"},"591":{"id":"/product-docs-21","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#product-areas","content":"| Area         | What it does                                               |\n| ------------ | ---------------------------------------------------------- |\n| **Settings** | Profile, team members, plan and billing, client workspaces |","table":"table-1"},"592":{"id":"/product-docs-22","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#how-it-connects","content":"A webinar's registration page collects registrants and can take payment through your own Stripe account. Registrants get reminder emails from the Notifications tab, and SMS or WhatsApp messages, both currently in Beta. They join the room live, or a recording plays at a scheduled time (simulive) or on demand (evergreen). Attendance, offer clicks and revenue flow into the webinar's Analytics and the People view, and out to connected CRMs and email tools, or into EasyCRM."},"593":{"id":"/product-docs-23","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#about","content":"Every page shows who it applies to, its status and the date it was last checked against the product. Each heading has a permanent link you can copy and share."},"594":{"id":"/product-docs/integrations/map-webinar-data","page_id":"/product-docs/integrations/map-webinar-data","type":"page","content":"Connect a CRM and map your webinar data","breadcrumbs":["EasyWebinar documentation","Integrations"],"tags":[],"url":"/product-docs/integrations/map-webinar-data"},"595":{"id":"/product-docs/integrations/map-webinar-data-0","page_id":"/product-docs/integrations/map-webinar-data","tags":[],"type":"text","url":"/product-docs/integrations/map-webinar-data","content":"Connect one of EasyWebinar's 15 CRM and email integrations, tag contacts by what they did, and send webinar details into your CRM's own fields."},"596":{"id":"/product-docs/integrations/map-webinar-data-1","page_id":"/product-docs/integrations/map-webinar-data","type":"heading","tags":[],"url":"/product-docs/integrations/map-webinar-data#at-a-glance","content":"At a glance"},"597":{"id":"/product-docs/integrations/map-webinar-data-2","page_id":"/product-docs/integrations/map-webinar-data","type":"heading","tags":[],"url":"/product-docs/integrations/map-webinar-data#before-you-begin","content":"Before you begin"},"598":{"id":"/product-docs/integrations/m